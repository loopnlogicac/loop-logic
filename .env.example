# Copy to .env and fill in what you need. Never commit .env or paste keys in chat.
# With every value empty the app still runs: memory store, anonymous cookie,
# reviewed help text only, library search only.

PORT=8787
HOST=127.0.0.1            # use 0.0.0.0 when deploying

# ── Database (Supabase project; Singapore region is closest) ──
SUPABASE_URL=
SUPABASE_ANON_KEY=        # public by design; sent to the browser for sign-in
SUPABASE_SECRET_KEY=       # sb_secret_… — server only, never expose (older projects: SUPABASE_SERVICE_ROLE_KEY)

# ── Sign-in: "anonymous" (cookie, default) or "supabase" (Google / email link) ──
# hybrid (default): optional sign-in when SUPABASE_URL and SUPABASE_ANON_KEY are set; supabase: required; off: no sign-in
AUTH_MODE=hybrid

# ── AI providers (free tiers are fine for the demo) ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
FREE_DAILY_AI_CALLS=10     # AI-worded answers per learner per day (matches the Free plan); after this, reviewed text

# ── Live search on approved websites only ──
TAVILY_API_KEY=

# ── Instructor dashboard ──
INSTRUCTOR_KEY=            # set before sharing the link; empty = open
MIN_GROUP_SIZE=3           # hide any group smaller than this
ALLOW_DEMO_SEED=true       # "Add labelled demo learners" button

# Admin site: these emails are always admins (comma separated). Others get roles in the admin site.
ADMIN_EMAILS=
# YouTube Data API key: lets admins add courses from a playlist link (Google Cloud → APIs → YouTube Data API v3).
YOUTUBE_API_KEY=

# Run code in the page. Student code runs in an outside sandbox, never on this server.
# Easiest: Judge0 CE on RapidAPI (rapidapi.com → Judge0 CE → subscribe → copy the key). Free plan: 50 runs a day.
JUDGE0_RAPIDAPI_KEY=
# Or your own sandbox: a self-hosted Judge0 (RUNNER_URL=http://host:2358) or Piston (also RUNNER_KIND=piston).
# RUNNER_URL=
# RUNNER_KEY=
# RUNNER_KIND=judge0
# Most runs the whole site may use per day (default 45 with RapidAPI, matching the free plan), per student per hour and per day.
# RUNNER_DAILY_LIMIT=45
# RUNNER_PER_HOUR=30
# RUNNER_PER_DAY=80

# Public address used in the sitemap, canonical links and share previews (default: the address the request came to).
# SITE_URL=https://loopnlogic.com
