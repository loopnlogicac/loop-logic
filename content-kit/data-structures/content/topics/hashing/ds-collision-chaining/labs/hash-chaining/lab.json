{
  "schemaVersion": "1.1",
  "id": "hash-chaining",
  "kind": "hash-table",
  "title": {
    "en": "Hash Chaining",
    "bn": "চেইনিংয়ে হ্যাশিং"
  },
  "summary": {
    "en": "Watch bucket lists keep colliding keys distinct during insertion, deletion and search."
  },
  "pseudocode": [
    "index = bucket(key, 7)",
    "scan the bucket for an equal key",
    "if absent, append a new node to the bucket",
    "find the incoming link for removed in its bucket",
    "if found, repair that link and free the node",
    "search the query bucket, comparing complete keys",
    "report removed and found"
  ],
  "inputs": [
    {
      "name": "values",
      "label": "Keys to insert",
      "type": "int-array",
      "minLength": 0,
      "maxLength": 12,
      "min": -99,
      "max": 99
    },
    {
      "name": "removed",
      "label": "Key to delete",
      "type": "int",
      "min": -99,
      "max": 99
    },
    {
      "name": "query",
      "label": "Key to find",
      "type": "int",
      "min": -99,
      "max": 99
    }
  ],
  "presets": [
    {
      "name": "Mixed buckets, middle deletion",
      "input": {
        "values": [
          1,
          8,
          15,
          -1,
          1
        ],
        "removed": 8,
        "query": 15
      }
    },
    {
      "name": "No collisions",
      "input": {
        "values": [
          0,
          1,
          2
        ],
        "removed": 1,
        "query": 2
      }
    },
    {
      "name": "One long chain",
      "input": {
        "values": [
          0,
          7,
          14,
          21,
          28,
          35,
          42,
          49,
          56,
          63,
          70,
          77
        ],
        "removed": 70,
        "query": 77
      }
    },
    {
      "name": "Empty table",
      "input": {
        "values": [],
        "removed": 0,
        "query": 0
      }
    },
    {
      "name": "Delete the only node",
      "input": {
        "values": [
          9
        ],
        "removed": 9,
        "query": 9
      }
    }
  ],
  "checks": [
    {
      "input": {
        "values": [
          1,
          8,
          15,
          -1,
          1
        ],
        "removed": 8,
        "query": 15
      },
      "expect": {
        "buckets": [
          [],
          [
            1,
            15
          ],
          [],
          [],
          [],
          [],
          [
            -1
          ]
        ],
        "vars": {
          "removed": 1,
          "found": 1
        }
      }
    },
    {
      "input": {
        "values": [],
        "removed": 0,
        "query": 0
      },
      "expect": {
        "buckets": [
          [],
          [],
          [],
          [],
          [],
          [],
          []
        ],
        "vars": {
          "removed": 0,
          "found": 0
        }
      }
    },
    {
      "input": {
        "values": [
          9
        ],
        "removed": 9,
        "query": 9
      },
      "expect": {
        "buckets": [
          [],
          [],
          [],
          [],
          [],
          [],
          []
        ],
        "vars": {
          "removed": 1,
          "found": 0
        }
      }
    }
  ],
  "complexity": {
    "time": "Expected O(1 + alpha) per operation; worst O(n)",
    "space": "O(m + n)"
  },
  "codeExample": "ex-1"
}
