{
  "schemaVersion": "1.1",
  "id": "bracket-matching",
  "kind": "stack",
  "title": {
    "en": "Check balanced brackets",
    "bn": "বন্ধনীর জোড়া মেলানো অনুশীলন"
  },
  "summary": {
    "en": "Use the most recent unmatched opener to find bracket errors and their positions."
  },
  "pseudocode": [
    "top = -1; error = 0",
    "for each token at position i + 1",
    "    if opener: push token and save its position",
    "    if closer: require matching items[top], then pop",
    "if openers remain: error = oldest saved position",
    "return error"
  ],
  "inputs": [
    {
      "name": "text",
      "label": "Bracket expression",
      "type": "string",
      "maxLength": 24,
      "alphabet": "()[]{}abc+* "
    }
  ],
  "presets": [
    {
      "name": "Nested families",
      "input": {
        "text": "{a+[b*(c)]}"
      }
    },
    {
      "name": "Flat pairs",
      "input": {
        "text": "()[]{}"
      }
    },
    {
      "name": "All openers",
      "input": {
        "text": "((((((("
      }
    },
    {
      "name": "Crossed pair",
      "input": {
        "text": "([)]"
      }
    },
    {
      "name": "Empty expression",
      "input": {
        "text": ""
      }
    }
  ],
  "checks": [
    {
      "input": {
        "text": ""
      },
      "expect": {
        "items": [],
        "vars": {
          "error": 0
        }
      }
    },
    {
      "input": {
        "text": "([)]"
      },
      "expect": {
        "items": [
          "(",
          "["
        ],
        "vars": {
          "error": 3
        }
      }
    },
    {
      "input": {
        "text": "a{b[c]"
      },
      "expect": {
        "items": [
          "{"
        ],
        "vars": {
          "error": 2
        }
      }
    },
    {
      "input": {
        "text": "{}[]()"
      },
      "expect": {
        "items": [],
        "vars": {
          "error": 0
        }
      }
    }
  ],
  "complexity": {
    "time": "O(n)",
    "space": "O(n)"
  },
  "codeExample": "ex-1"
}
