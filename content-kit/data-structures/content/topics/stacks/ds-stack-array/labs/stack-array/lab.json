{
  "schemaVersion": "1.1",
  "id": "stack-array",
  "kind": "stack",
  "title": {
    "en": "Push and pop on a stack",
    "bn": "অ্যারে দিয়ে স্ট্যাক অনুশীলন"
  },
  "summary": {
    "en": "Use a top index to push, inspect and remove values without touching the older stack entries.",
    "bn": "পুরোনো স্ট্যাক এন্ট্রি না ছুঁয়ে top index দিয়ে মান push, দেখা আর pop করো।"
  },
  "pseudocode": [
    "top = -1; capacity = 4",
    "for each command",
    "    if command is 0: check isEmpty, then pop",
    "    else if command is 100: check isEmpty, then peek",
    "    else: check isFull, then push command",
    "return the live items"
  ],
  "inputs": [
    {
      "name": "commands",
      "label": "0 pop, 100 peek, otherwise push",
      "type": "int-array",
      "minLength": 0,
      "maxLength": 16,
      "min": -9,
      "max": 100
    }
  ],
  "presets": [
    {
      "name": "Mixed operations",
      "input": {
        "commands": [
          12,
          24,
          100,
          0,
          36,
          48,
          60,
          72
        ]
      }
    },
    {
      "name": "One push and pop",
      "input": {
        "commands": [
          9,
          0
        ]
      }
    },
    {
      "name": "Full stack refuses growth",
      "input": {
        "commands": [
          1,
          2,
          3,
          4,
          5,
          6
        ]
      }
    },
    {
      "name": "Empty operations",
      "input": {
        "commands": [
          0,
          100
        ]
      }
    }
  ],
  "checks": [
    {
      "input": {
        "commands": []
      },
      "expect": {
        "items": []
      }
    },
    {
      "input": {
        "commands": [
          1,
          1,
          1,
          1,
          1
        ]
      },
      "expect": {
        "items": [
          1,
          1,
          1,
          1
        ]
      }
    },
    {
      "input": {
        "commands": [
          8,
          9,
          0,
          100
        ]
      },
      "expect": {
        "items": [
          8
        ]
      }
    }
  ],
  "complexity": {
    "time": "O(m) for m commands; O(1) per operation",
    "space": "O(1), capacity four"
  },
  "codeExample": "ex-1"
}
