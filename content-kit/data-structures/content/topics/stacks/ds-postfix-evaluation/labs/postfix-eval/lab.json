{
  "schemaVersion": "1.1",
  "id": "postfix-eval",
  "kind": "stack",
  "title": {
    "en": "Evaluate a postfix expression",
    "bn": "পোস্টফিক্স expression-এর মান নির্ণয় অনুশীলন"
  },
  "summary": {
    "en": "Evaluate separated integer tokens using an operand stack and explicit arithmetic checks."
  },
  "pseudocode": [
    "items = []; top = -1",
    "for each whitespace-separated token",
    "    if integer -99..99: push number",
    "    else require one operator and two operands",
    "    right = items[top]; left = items[top - 1]",
    "    reject zero division or result outside -10000..10000",
    "    pop right; pop left; push result",
    "require exactly one final value"
  ],
  "inputs": [
    {
      "name": "text",
      "label": "Postfix tokens with spaces",
      "type": "string",
      "maxLength": 24,
      "alphabet": "0123456789 +-*/"
    }
  ],
  "presets": [
    {
      "name": "Multiply then add",
      "input": {
        "text": "12 3 4 * +"
      }
    },
    {
      "name": "Single negative number",
      "input": {
        "text": "-99"
      }
    },
    {
      "name": "Many pending operands",
      "input": {
        "text": "1 2 3 4 + + +"
      }
    },
    {
      "name": "Zero divisor",
      "input": {
        "text": "7 0 /"
      }
    },
    {
      "name": "Missing operand",
      "input": {
        "text": "5 +"
      }
    }
  ],
  "checks": [
    {
      "input": {
        "text": "12 3 4 * +"
      },
      "expect": {
        "items": [
          24
        ],
        "vars": {
          "valid": 1,
          "result": 24
        }
      }
    },
    {
      "input": {
        "text": "20 5 -"
      },
      "expect": {
        "items": [
          15
        ]
      }
    },
    {
      "input": {
        "text": "7 0 /"
      },
      "expect": {
        "items": [
          7,
          0
        ],
        "vars": {
          "valid": 0
        }
      }
    },
    {
      "input": {
        "text": "1 2"
      },
      "expect": {
        "items": [
          1,
          2
        ],
        "vars": {
          "valid": 0
        }
      }
    },
    {
      "input": {
        "text": "-7 3 /"
      },
      "expect": {
        "items": [
          -2
        ]
      }
    }
  ],
  "complexity": {
    "time": "O(n) tokens",
    "space": "O(n)"
  },
  "codeExample": "ex-1"
}
