{
  "schemaVersion": "1.1",
  "id": "infix-to-postfix",
  "kind": "stack",
  "title": {
    "en": "Infix to postfix conversion",
    "bn": "ইনফিক্স, প্রিফিক্স ও পোস্টফিক্স অনুশীলন"
  },
  "summary": {
    "en": "Preserve precedence and associativity while moving operators into postfix and prefix order."
  },
  "pseudocode": [
    "items = []; output = []; need_operand = true",
    "for each token, ignoring spaces",
    "    operand: require need_operand, then append output",
    "    opening parenthesis: require need_operand, then push",
    "    closing parenthesis: pop to matching opener; discard opener",
    "    operator: pop greater rank, or equal left-associative rank",
    "    push operator; need_operand = true",
    "reject missing operand or unmatched parenthesis; else drain",
    "return output"
  ],
  "inputs": [
    {
      "name": "text",
      "label": "Infix: A..Z and binary + - * / ^",
      "type": "string",
      "maxLength": 24,
      "alphabet": "ABC+-*/^() "
    }
  ],
  "presets": [
    {
      "name": "Multiplication before addition",
      "input": {
        "text": "A+B*C"
      }
    },
    {
      "name": "Single operand",
      "input": {
        "text": "A"
      }
    },
    {
      "name": "Deep operator chain",
      "input": {
        "text": "A^B^C^A"
      }
    },
    {
      "name": "Mismatched grouping",
      "input": {
        "text": "(A+B"
      }
    }
  ],
  "checks": [
    {
      "input": {
        "text": "A+B*C"
      },
      "expect": {
        "items": [],
        "lists": {
          "output": [
            "A",
            "B",
            "C",
            "*",
            "+"
          ]
        },
        "vars": {
          "valid": 1
        }
      }
    },
    {
      "input": {
        "text": "A^B^C"
      },
      "expect": {
        "items": [],
        "lists": {
          "output": [
            "A",
            "B",
            "C",
            "^",
            "^"
          ]
        }
      }
    },
    {
      "input": {
        "text": "A-B-C"
      },
      "expect": {
        "lists": {
          "output": [
            "A",
            "B",
            "-",
            "C",
            "-"
          ]
        }
      }
    },
    {
      "input": {
        "text": ""
      },
      "expect": {
        "vars": {
          "valid": 0
        }
      }
    }
  ],
  "complexity": {
    "time": "O(n)",
    "space": "O(n)"
  },
  "codeExample": "ex-1"
}
