{
  "schemaVersion": "1.1",
  "id": "circular-queue",
  "kind": "array",
  "title": {
    "en": "Circular queue with front and rear",
    "bn": "সার্কুলার কিউ অনুশীলন"
  },
  "summary": {
    "en": "Reuse every array cell by wrapping front and rear and tracking the live count."
  },
  "pseudocode": [
    "front = rear = count = 0; capacity = 4",
    "for each command",
    "    if zero and count > 0: read and clear items[front]",
    "        front = (front + 1) % capacity; count--",
    "    else if nonzero and count < capacity: items[rear] = command",
    "        rear = (rear + 1) % capacity; count++",
    "    else: report empty or full without changing state",
    "return cells, cursors, count and logical items"
  ],
  "inputs": [
    {
      "name": "commands",
      "label": "0 dequeue, otherwise enqueue",
      "type": "int-array",
      "minLength": 0,
      "maxLength": 16,
      "min": -99,
      "max": 99
    }
  ],
  "presets": [
    {
      "name": "Reuse freed cells",
      "input": {
        "commands": [
          1,
          2,
          3,
          4,
          0,
          0,
          5,
          6
        ]
      }
    },
    {
      "name": "Empty ring",
      "input": {
        "commands": []
      }
    },
    {
      "name": "Full ring rejection",
      "input": {
        "commands": [
          1,
          2,
          3,
          4,
          5
        ]
      }
    },
    {
      "name": "Full drain and reuse",
      "input": {
        "commands": [
          7,
          0,
          8,
          0,
          9,
          0,
          10,
          0,
          11
        ]
      }
    }
  ],
  "checks": [
    {
      "input": {
        "commands": []
      },
      "expect": {
        "array": [
          0,
          0,
          0,
          0
        ],
        "vars": {
          "front": 0,
          "rear": 0,
          "count": 0
        }
      }
    },
    {
      "input": {
        "commands": [
          1,
          2,
          3,
          4,
          0,
          0,
          5,
          6
        ]
      },
      "expect": {
        "array": [
          5,
          6,
          3,
          4
        ],
        "vars": {
          "front": 2,
          "rear": 2,
          "count": 4
        },
        "lists": {
          "items": [
            3,
            4,
            5,
            6
          ]
        }
      }
    },
    {
      "input": {
        "commands": [
          8,
          8,
          8,
          8,
          9
        ]
      },
      "expect": {
        "array": [
          8,
          8,
          8,
          8
        ],
        "vars": {
          "count": 4
        }
      }
    },
    {
      "input": {
        "commands": [
          1,
          0
        ]
      },
      "expect": {
        "array": [
          0,
          0,
          0,
          0
        ],
        "vars": {
          "front": 1,
          "rear": 1,
          "count": 0
        }
      }
    }
  ],
  "complexity": {
    "time": "O(m) commands; O(1) per enqueue/dequeue",
    "space": "O(1), four cells"
  },
  "codeExample": "ex-1"
}
