{
  "schemaVersion": "1.1",
  "id": "queue-basic",
  "kind": "queue",
  "title": {
    "en": "Enqueue and dequeue",
    "bn": "অ্যারে দিয়ে কিউ অনুশীলন"
  },
  "summary": {
    "en": "Track a front cursor and a rear cursor to serve arrivals in FIFO order."
  },
  "pseudocode": [
    "front = 0; rear = 0; capacity = 4",
    "for each command",
    "    if zero and front < rear: dequeue; front++",
    "    else if zero: report empty",
    "    else if rear < capacity: enqueue; rear++",
    "    else: report no rear space",
    "return items and cursors"
  ],
  "inputs": [
    {
      "name": "commands",
      "label": "0 dequeue, otherwise enqueue",
      "type": "int-array",
      "minLength": 0,
      "maxLength": 16,
      "min": -99,
      "max": 99
    }
  ],
  "presets": [
    {
      "name": "Mixed FIFO operations",
      "input": {
        "commands": [
          12,
          24,
          0,
          36,
          0,
          48
        ]
      }
    },
    {
      "name": "One arrival",
      "input": {
        "commands": [
          7
        ]
      }
    },
    {
      "name": "Wasted prefix",
      "input": {
        "commands": [
          1,
          2,
          3,
          4,
          0,
          0,
          5
        ]
      }
    },
    {
      "name": "Empty removals",
      "input": {
        "commands": [
          0,
          0
        ]
      }
    }
  ],
  "checks": [
    {
      "input": {
        "commands": []
      },
      "expect": {
        "items": [],
        "vars": {
          "front": 0,
          "rear": 0
        }
      }
    },
    {
      "input": {
        "commands": [
          1,
          2,
          3,
          4,
          0,
          0,
          5
        ]
      },
      "expect": {
        "items": [
          3,
          4
        ],
        "vars": {
          "front": 2,
          "rear": 4
        }
      }
    },
    {
      "input": {
        "commands": [
          8,
          8,
          0
        ]
      },
      "expect": {
        "items": [
          8
        ],
        "vars": {
          "front": 1,
          "rear": 2
        }
      }
    }
  ],
  "complexity": {
    "time": "O(m) commands; O(1) per update",
    "space": "O(1), four cells"
  },
  "codeExample": "ex-1"
}
