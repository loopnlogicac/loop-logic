{
  "schemaVersion": "1.1",
  "id": "avl-insert",
  "kind": "tree",
  "title": {
    "en": "AVL insertion and rotations",
    "bn": "এভিএল ট্রিতে ইনসার্ট আর রোটেশন"
  },
  "summary": {
    "en": "Watch real child links move during single and double rotations."
  },
  "pseudocode": [
    "Insert a distinct key by the BST rule",
    "Update height and balance = left height - right height",
    "If balance is outside -1..1 choose LL, RR, LR or RL",
    "Rotate using saved middle subtree; update old root then new root",
    "Reconnect returned subtree root to its parent or tree root",
    "Finish with every balance in -1..1"
  ],
  "inputs": [
    {
      "name": "values",
      "label": "Keys in input order",
      "type": "int-array",
      "minLength": 0,
      "maxLength": 12,
      "min": -99,
      "max": 99
    }
  ],
  "presets": [
    {
      "name": "LL repair",
      "input": {
        "values": [
          30,
          20,
          10
        ]
      }
    },
    {
      "name": "RR repair",
      "input": {
        "values": [
          10,
          20,
          30
        ]
      }
    },
    {
      "name": "LR repair",
      "input": {
        "values": [
          30,
          10,
          20
        ]
      }
    },
    {
      "name": "RL repair",
      "input": {
        "values": [
          10,
          30,
          20
        ]
      }
    },
    {
      "name": "Increasing chain",
      "input": {
        "values": [
          1,
          2,
          3,
          4,
          5,
          6,
          7,
          8
        ]
      }
    },
    {
      "name": "Empty",
      "input": {
        "values": []
      }
    },
    {
      "name": "Duplicate",
      "input": {
        "values": [
          4,
          4,
          4
        ]
      }
    }
  ],
  "checks": [
    {
      "input": {
        "values": [
          30,
          10,
          20
        ]
      },
      "expect": {
        "inorder": [
          10,
          20,
          30
        ],
        "height": 2,
        "vars": {
          "height": 2
        }
      }
    },
    {
      "input": {
        "values": [
          10,
          30,
          20
        ]
      },
      "expect": {
        "inorder": [
          10,
          20,
          30
        ],
        "size": 3
      }
    },
    {
      "input": {
        "values": []
      },
      "expect": {
        "size": 0,
        "vars": {
          "height": 0
        }
      }
    },
    {
      "input": {
        "values": [
          4,
          4,
          4
        ]
      },
      "expect": {
        "size": 1
      }
    }
  ],
  "complexity": {
    "time": "O(log n) per insertion",
    "space": "O(log n) calls; O(n) stored nodes"
  },
  "codeExample": "ex-1"
}
