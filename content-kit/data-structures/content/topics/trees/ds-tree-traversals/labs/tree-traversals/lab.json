{
  "schemaVersion": "1.1",
  "id": "tree-traversals",
  "kind": "tree",
  "title": {
    "en": "Choose a tree traversal",
    "bn": "ট্রি ট্রাভার্সাল বেছে নাও"
  },
  "summary": {
    "en": "Compare four visit orders on the same complete binary tree."
  },
  "pseudocode": [
    "Enter root; missing children return immediately",
    "For depth first, recurse left then right",
    "Visit before, between or after children for modes 0, 1, 2",
    "For mode 3, dequeue then enqueue left and right",
    "Return order"
  ],
  "inputs": [
    {
      "name": "values",
      "label": "Keys in input order",
      "type": "int-array",
      "minLength": 0,
      "maxLength": 12,
      "min": -99,
      "max": 99
    },
    {
      "name": "mode",
      "label": "0 pre, 1 in, 2 post, 3 level",
      "type": "int",
      "min": 0,
      "max": 3
    }
  ],
  "presets": [
    {
      "name": "Inorder marks",
      "input": {
        "values": [
          8,
          3,
          10,
          1,
          6,
          9,
          14
        ],
        "mode": 1
      }
    },
    {
      "name": "Preorder small",
      "input": {
        "values": [
          8,
          3,
          10
        ],
        "mode": 0
      }
    },
    {
      "name": "Postorder full",
      "input": {
        "values": [
          8,
          3,
          10,
          1,
          6,
          9,
          14
        ],
        "mode": 2
      }
    },
    {
      "name": "Level order",
      "input": {
        "values": [
          8,
          3,
          10,
          1,
          6,
          9,
          14
        ],
        "mode": 3
      }
    },
    {
      "name": "Empty",
      "input": {
        "values": [],
        "mode": 0
      }
    },
    {
      "name": "One node",
      "input": {
        "values": [
          4
        ],
        "mode": 2
      }
    }
  ],
  "checks": [
    {
      "input": {
        "values": [
          8,
          3,
          10,
          1,
          6,
          9,
          14
        ],
        "mode": 1
      },
      "expect": {
        "lists": {
          "order": [
            1,
            3,
            6,
            8,
            9,
            10,
            14
          ]
        }
      }
    },
    {
      "input": {
        "values": [
          8,
          3,
          10
        ],
        "mode": 0
      },
      "expect": {
        "lists": {
          "order": [
            8,
            3,
            10
          ]
        }
      }
    },
    {
      "input": {
        "values": [
          8,
          3,
          10
        ],
        "mode": 2
      },
      "expect": {
        "lists": {
          "order": [
            3,
            10,
            8
          ]
        }
      }
    },
    {
      "input": {
        "values": [
          8,
          3,
          10,
          1
        ],
        "mode": 3
      },
      "expect": {
        "lists": {
          "order": [
            8,
            3,
            10,
            1
          ],
          "queue": []
        }
      }
    },
    {
      "input": {
        "values": [],
        "mode": 1
      },
      "expect": {
        "size": 0,
        "lists": {
          "order": []
        }
      }
    }
  ],
  "complexity": {
    "time": "O(n)",
    "space": "O(h) recursive; O(w) queue; O(n) recorded output"
  },
  "codeExample": "ex-1"
}
