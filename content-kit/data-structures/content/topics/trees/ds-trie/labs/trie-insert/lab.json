{
  "schemaVersion": "1.1",
  "id": "trie-insert",
  "kind": "tree",
  "title": {
    "en": "Insert into a shared-prefix dictionary",
    "bn": "একই প্রিফিক্সের ডিকশনারিতে শব্দ রাখি"
  },
  "summary": {
    "en": "Add a word beside car, cat and do, reusing nodes and marking complete words.",
    "bn": "নোড আবার ব্যবহার আর পুরো শব্দ mark করে car, cat আর do-এর পাশে শব্দ যোগ করো।"
  },
  "pseudocode": [
    "For each letter follow the matching child if present",
    "Otherwise create and attach one letter node",
    "Mark the endpoint terminal; repeated words count once",
    "Traverse children alphabetically for completions",
    "Report distinct count; empty input means no insertion"
  ],
  "inputs": [
    {
      "name": "word",
      "label": "Word (a-z, up to 6 letters)",
      "type": "string",
      "maxLength": 6,
      "alphabet": "abcdefghijklmnopqrstuvwxyz"
    }
  ],
  "presets": [
    {
      "name": "Shared prefix",
      "input": {
        "word": "cab"
      }
    },
    {
      "name": "Already stored",
      "input": {
        "word": "do"
      }
    },
    {
      "name": "New branch",
      "input": {
        "word": "bbbbbb"
      }
    },
    {
      "name": "Word is a prefix",
      "input": {
        "word": "ca"
      }
    },
    {
      "name": "Empty input",
      "input": {
        "word": ""
      }
    }
  ],
  "checks": [
    {
      "input": {
        "word": "cab"
      },
      "expect": {
        "lists": {
          "words": [
            "cab",
            "car",
            "cat",
            "do"
          ]
        },
        "vars": {
          "count": 4
        }
      }
    },
    {
      "input": {
        "word": "do"
      },
      "expect": {
        "lists": {
          "words": [
            "car",
            "cat",
            "do"
          ]
        },
        "vars": {
          "count": 3
        }
      }
    },
    {
      "input": {
        "word": ""
      },
      "expect": {
        "lists": {
          "words": [
            "car",
            "cat",
            "do"
          ]
        },
        "vars": {
          "count": 3
        }
      }
    },
    {
      "input": {
        "word": "ca"
      },
      "expect": {
        "lists": {
          "words": [
            "ca",
            "car",
            "cat",
            "do"
          ]
        }
      }
    }
  ],
  "complexity": {
    "time": "O(L) insertion; O(26P + output length) enumeration",
    "space": "O(26P) child slots; O(L) path"
  },
  "codeExample": "ex-1"
}
