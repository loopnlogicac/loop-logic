{
  "schemaVersion": "1.1",
  "id": "heap-operations",
  "kind": "heap",
  "title": {
    "en": "Build, insert and delete max",
    "bn": "হিপ বানাই, ইনসার্ট করি আর ম্যাক্স মুছি"
  },
  "summary": {
    "en": "Repair a max heap from leaves upward, then insert and optionally remove its root."
  },
  "pseudocode": [
    "Build heap by sifting internal indices down from n/2 - 1",
    "Swap with the greater child until parent dominates",
    "Append key and sift it up while greater than parent",
    "If removeMax, replace root by last, shrink, then sift root down",
    "Return active heap"
  ],
  "inputs": [
    {
      "name": "values",
      "label": "Keys in input order",
      "type": "int-array",
      "minLength": 0,
      "maxLength": 12,
      "min": -99,
      "max": 99
    },
    {
      "name": "key",
      "label": "Key",
      "type": "int",
      "min": -99,
      "max": 99
    },
    {
      "name": "removeMax",
      "label": "Remove maximum after insert (0/1)",
      "type": "int",
      "min": 0,
      "max": 1
    }
  ],
  "presets": [
    {
      "name": "Build and replace",
      "input": {
        "values": [
          4,
          10,
          3,
          5,
          1,
          8
        ],
        "key": 12,
        "removeMax": 1
      }
    },
    {
      "name": "Already heap",
      "input": {
        "values": [
          9,
          7,
          8
        ],
        "key": 1,
        "removeMax": 0
      }
    },
    {
      "name": "Increasing keys",
      "input": {
        "values": [
          1,
          2,
          3,
          4,
          5,
          6,
          7
        ],
        "key": 20,
        "removeMax": 1
      }
    },
    {
      "name": "Duplicate maximum",
      "input": {
        "values": [
          4,
          4,
          4
        ],
        "key": 4,
        "removeMax": 1
      }
    },
    {
      "name": "Empty then drain",
      "input": {
        "values": [],
        "key": 8,
        "removeMax": 1
      }
    }
  ],
  "checks": [
    {
      "input": {
        "values": [],
        "key": 8,
        "removeMax": 1
      },
      "expect": {
        "array": [],
        "vars": {
          "removed": 8
        }
      }
    },
    {
      "input": {
        "values": [
          9,
          7,
          8
        ],
        "key": 1,
        "removeMax": 0
      },
      "expect": {
        "array": [
          9,
          7,
          8,
          1
        ]
      }
    },
    {
      "input": {
        "values": [
          4,
          4,
          4
        ],
        "key": 4,
        "removeMax": 1
      },
      "expect": {
        "array": [
          4,
          4,
          4
        ]
      }
    }
  ],
  "complexity": {
    "time": "O(n) build; O(log n) insert and deletion",
    "space": "O(1) auxiliary space excluding array and recorded steps"
  },
  "codeExample": "ex-1"
}
