{
  "schemaVersion": "1.1",
  "id": "bst-delete",
  "kind": "tree",
  "title": {
    "en": "Delete from a BST",
    "bn": "বিএসটি থেকে নোড মুছি"
  },
  "summary": {
    "en": "See leaf removal, child promotion and successor replacement as separate link changes.",
    "bn": "Leaf সরানো, child ওপরে তোলা আর successor বসানোকে আলাদা link বদল হিসেবে দেখো।"
  },
  "pseudocode": [
    "Search for key; a missing link means no change",
    "With two children find minimum of right subtree",
    "Copy successor key and recursively remove that successor",
    "With at most one child, replace parent link or root by saved child",
    "Free the detached node",
    "Return the repaired root"
  ],
  "inputs": [
    {
      "name": "values",
      "label": "Keys in input order",
      "type": "int-array",
      "minLength": 0,
      "maxLength": 12,
      "min": -99,
      "max": 99
    },
    {
      "name": "key",
      "label": "Key",
      "type": "int",
      "min": -99,
      "max": 99
    }
  ],
  "presets": [
    {
      "name": "Two children",
      "input": {
        "values": [
          8,
          3,
          10,
          1,
          6,
          9,
          14
        ],
        "key": 8
      }
    },
    {
      "name": "One child root",
      "input": {
        "values": [
          8,
          3
        ],
        "key": 8
      }
    },
    {
      "name": "Leaf",
      "input": {
        "values": [
          8,
          3,
          10
        ],
        "key": 3
      }
    },
    {
      "name": "Absent deep key",
      "input": {
        "values": [
          1,
          2,
          3,
          4,
          5
        ],
        "key": 6
      }
    },
    {
      "name": "Last node",
      "input": {
        "values": [
          8
        ],
        "key": 8
      }
    },
    {
      "name": "Empty",
      "input": {
        "values": [],
        "key": 4
      }
    }
  ],
  "checks": [
    {
      "input": {
        "values": [
          8,
          3,
          10,
          1,
          6,
          9,
          14
        ],
        "key": 8
      },
      "expect": {
        "inorder": [
          1,
          3,
          6,
          9,
          10,
          14
        ],
        "size": 6
      }
    },
    {
      "input": {
        "values": [
          8,
          3
        ],
        "key": 8
      },
      "expect": {
        "inorder": [
          3
        ],
        "size": 1
      }
    },
    {
      "input": {
        "values": [
          8
        ],
        "key": 8
      },
      "expect": {
        "root": null,
        "size": 0
      }
    },
    {
      "input": {
        "values": [],
        "key": 4
      },
      "expect": {
        "size": 0
      }
    }
  ],
  "complexity": {
    "time": "O(h) search and successor path",
    "space": "O(h) recursive calls"
  },
  "codeExample": "ex-1"
}
