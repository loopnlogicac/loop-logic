{
  "schemaVersion": "1.1",
  "id": "bst-insert-search",
  "kind": "tree",
  "title": {
    "en": "Insert and search in a BST",
    "bn": "বিএসটিতে ইনসার্ট আর সার্চ"
  },
  "summary": {
    "en": "Follow comparisons to insert unique keys and search for a target.",
    "bn": "তুলনা অনুসরণ করে unique key ঢোকাও আর target খোঁজো।"
  },
  "pseudocode": [
    "Compare key at cur; equal means no duplicate node",
    "Create a node at the first empty link",
    "Publish it through root or the parent child link",
    "Search key by moving left for smaller, right for larger",
    "Report found or missing"
  ],
  "inputs": [
    {
      "name": "values",
      "label": "Keys in input order",
      "type": "int-array",
      "minLength": 0,
      "maxLength": 12,
      "min": -99,
      "max": 99
    },
    {
      "name": "key",
      "label": "Key",
      "type": "int",
      "min": -99,
      "max": 99
    }
  ],
  "presets": [
    {
      "name": "Branched tree",
      "input": {
        "values": [
          8,
          3,
          10,
          1,
          6,
          9,
          14
        ],
        "key": 6
      }
    },
    {
      "name": "Root match",
      "input": {
        "values": [
          8,
          3,
          10
        ],
        "key": 8
      }
    },
    {
      "name": "Tall chain",
      "input": {
        "values": [
          1,
          2,
          3,
          4,
          5,
          6
        ],
        "key": 6
      }
    },
    {
      "name": "Duplicates",
      "input": {
        "values": [
          8,
          8,
          8
        ],
        "key": 9
      }
    },
    {
      "name": "Empty search",
      "input": {
        "values": [],
        "key": 4
      }
    }
  ],
  "checks": [
    {
      "input": {
        "values": [
          8,
          3,
          10,
          1,
          6,
          9,
          14
        ],
        "key": 6
      },
      "expect": {
        "inorder": [
          1,
          3,
          6,
          8,
          9,
          10,
          14
        ],
        "vars": {
          "found": 1,
          "comparisons": 3
        }
      }
    },
    {
      "input": {
        "values": [
          8,
          8
        ],
        "key": 9
      },
      "expect": {
        "size": 1,
        "vars": {
          "found": 0
        }
      }
    },
    {
      "input": {
        "values": [],
        "key": 4
      },
      "expect": {
        "size": 0,
        "vars": {
          "found": 0,
          "comparisons": 0
        }
      }
    }
  ],
  "complexity": {
    "time": "O(nh) to build; O(h) search",
    "space": "O(n) nodes; O(1) iterative search"
  },
  "codeExample": "ex-1"
}
