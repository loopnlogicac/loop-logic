{
  "schemaVersion": "1.1",
  "id": "graph-dfs",
  "kind": "graph",
  "title": {
    "en": "Depth-first search with a stack",
    "bn": "ডেপথ-ফার্স্ট সার্চ"
  },
  "summary": {
    "en": "Watch stack frames enter and finish vertices in depth-first order.",
    "bn": "Depth-first ক্রমে স্ট্যাক ফ্রেম কীভাবে ভার্টেক্সে ঢোকে আর শেষ করে দেখো।"
  },
  "pseudocode": [
    "mark start; enter[start] = ++clock; push frame(start,0)",
    "while frames remain",
    "u = top; advance its next neighbor index",
    "if neighbor v is unseen: mark v; enter[v] = ++clock",
    "push frame(v,0)",
    "if no neighbors remain: leave[u] = ++clock",
    "pop the exhausted frame and resume its parent",
    "report discovery order, finish order and times"
  ],
  "inputs": [
    {
      "name": "graph",
      "label": "Graph: 0 diamond, 1 path, 2 empty, 3 K7",
      "type": "int",
      "min": 0,
      "max": 3
    },
    {
      "name": "start",
      "label": "Start vertex",
      "type": "int",
      "min": 0,
      "max": 6
    }
  ],
  "presets": [
    {
      "name": "Shared diamond with cycles",
      "input": {
        "graph": 0,
        "start": 0
      }
    },
    {
      "name": "Single reachable vertex",
      "input": {
        "graph": 2,
        "start": 3
      }
    },
    {
      "name": "Deep path frames",
      "input": {
        "graph": 1,
        "start": 0
      }
    },
    {
      "name": "Dense graph",
      "input": {
        "graph": 3,
        "start": 0
      }
    }
  ],
  "checks": [
    {
      "input": {
        "graph": 0,
        "start": 0
      },
      "expect": {
        "lists": {
          "order": [
            0,
            1,
            3,
            5,
            4,
            2
          ],
          "finish": [
            2,
            4,
            5,
            3,
            1,
            0
          ],
          "stack": [],
          "enter": [
            1,
            2,
            6,
            3,
            5,
            4,
            0
          ],
          "leave": [
            12,
            11,
            7,
            10,
            8,
            9,
            0
          ]
        }
      }
    },
    {
      "input": {
        "graph": 2,
        "start": 3
      },
      "expect": {
        "lists": {
          "order": [
            3
          ],
          "finish": [
            3
          ]
        },
        "labels": {
          "3": "1/2"
        }
      }
    },
    {
      "input": {
        "graph": 1,
        "start": 0
      },
      "expect": {
        "lists": {
          "order": [
            0,
            1,
            2,
            3,
            4,
            5,
            6
          ],
          "finish": [
            6,
            5,
            4,
            3,
            2,
            1,
            0
          ],
          "enter": [
            1,
            2,
            3,
            4,
            5,
            6,
            7
          ],
          "leave": [
            14,
            13,
            12,
            11,
            10,
            9,
            8
          ]
        }
      }
    }
  ],
  "complexity": {
    "time": "O(V + E) for the traversal",
    "space": "O(V) for visited flags, times and frames"
  },
  "codeExample": "ex-1"
}
