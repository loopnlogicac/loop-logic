{
  "schemaVersion": "1.1",
  "id": "union-find",
  "kind": "array",
  "title": {
    "en": "Union by size and path compression",
    "bn": "সাইজ দেখে ইউনিয়ন আর পাথ কমপ্রেশন"
  },
  "summary": {
    "en": "Join smaller sets below larger roots and compress a chosen find path.",
    "bn": "ছোট সেট বড় রুটের নিচে জুড়ে বেছে নেওয়া find-এর পথ ছোট করো।"
  },
  "pseudocode": [
    "make-set: parent[i] = i; size[i] = 1",
    "find: follow parent links to a self-parent root",
    "compress each visited parent to that root",
    "union: if roots match, do nothing",
    "otherwise attach smaller root below larger; ties keep first",
    "increase the surviving root size; decrement components",
    "find query and report its root, size and component count"
  ],
  "inputs": [
    {
      "name": "graph",
      "label": "Pairs: 0 diamond to 4 balanced",
      "type": "int",
      "min": 0,
      "max": 4
    },
    {
      "name": "query",
      "label": "Vertex for final find",
      "type": "int",
      "min": 0,
      "max": 6
    }
  ],
  "presets": [
    {
      "name": "One component plus isolated",
      "input": {
        "graph": 0,
        "query": 5
      }
    },
    {
      "name": "Singleton sets",
      "input": {
        "graph": 2,
        "query": 3
      }
    },
    {
      "name": "Many redundant unions",
      "input": {
        "graph": 3,
        "query": 6
      }
    },
    {
      "name": "Balanced merges, compress",
      "input": {
        "graph": 4,
        "query": 6
      }
    },
    {
      "name": "Path edges",
      "input": {
        "graph": 1,
        "query": 6
      }
    }
  ],
  "checks": [
    {
      "input": {
        "graph": 0,
        "query": 5
      },
      "expect": {
        "array": [
          0,
          0,
          0,
          0,
          0,
          0,
          6
        ],
        "vars": {
          "root": 0,
          "size": 6,
          "components": 2
        }
      }
    },
    {
      "input": {
        "graph": 2,
        "query": 3
      },
      "expect": {
        "array": [
          0,
          1,
          2,
          3,
          4,
          5,
          6
        ],
        "vars": {
          "root": 3,
          "size": 1,
          "components": 7
        }
      }
    },
    {
      "input": {
        "graph": 4,
        "query": 6
      },
      "expect": {
        "array": [
          0,
          0,
          0,
          2,
          0,
          4,
          0
        ],
        "vars": {
          "root": 0,
          "size": 7,
          "components": 1
        }
      }
    }
  ],
  "complexity": {
    "time": "O(alpha(n)) amortized per union or find",
    "space": "O(n)"
  },
  "codeExample": "ex-1"
}
