{
  "schemaVersion": "1.1",
  "id": "graph-bfs",
  "kind": "graph",
  "title": {
    "en": "Breadth-first search with a queue",
    "bn": "ব্রেডথ-ফার্স্ট সার্চ"
  },
  "summary": {
    "en": "Follow the queue, distances and BFS tree through reachable vertices."
  },
  "pseudocode": [
    "dist = -1; parent = -1; dist[start] = 0",
    "mark start; enqueue start",
    "while queue not empty: u = dequeue",
    "for each ascending neighbor v: check dist[v]",
    "if undiscovered: dist[v] = dist[u]+1; parent[v] = u; mark v",
    "enqueue v",
    "finish u and append it to order",
    "report distances and parents"
  ],
  "inputs": [
    {
      "name": "graph",
      "label": "Graph: 0 diamond, 1 path, 2 empty, 3 K7",
      "type": "int",
      "min": 0,
      "max": 3
    },
    {
      "name": "start",
      "label": "Start vertex",
      "type": "int",
      "min": 0,
      "max": 6
    }
  ],
  "presets": [
    {
      "name": "Shared diamond",
      "input": {
        "graph": 0,
        "start": 0
      }
    },
    {
      "name": "All vertices adjacent",
      "input": {
        "graph": 3,
        "start": 0
      }
    },
    {
      "name": "Long path",
      "input": {
        "graph": 1,
        "start": 0
      }
    },
    {
      "name": "Isolated source",
      "input": {
        "graph": 0,
        "start": 6
      }
    },
    {
      "name": "No edges",
      "input": {
        "graph": 2,
        "start": 3
      }
    }
  ],
  "checks": [
    {
      "input": {
        "graph": 0,
        "start": 0
      },
      "expect": {
        "lists": {
          "order": [
            0,
            1,
            2,
            3,
            4,
            5
          ],
          "queue": [],
          "parents": [
            -1,
            0,
            0,
            1,
            1,
            3,
            -1
          ]
        },
        "labels": {
          "0": "0",
          "5": "3",
          "6": "-1"
        }
      }
    },
    {
      "input": {
        "graph": 1,
        "start": 6
      },
      "expect": {
        "lists": {
          "order": [
            6,
            5,
            4,
            3,
            2,
            1,
            0
          ]
        },
        "labels": {
          "0": "6"
        }
      }
    },
    {
      "input": {
        "graph": 2,
        "start": 3
      },
      "expect": {
        "lists": {
          "order": [
            3
          ],
          "parents": [
            -1,
            -1,
            -1,
            -1,
            -1,
            -1,
            -1
          ]
        },
        "labels": {
          "3": "0",
          "0": "-1"
        }
      }
    }
  ],
  "complexity": {
    "time": "O(V + E) after adjacency lists are built",
    "space": "O(V) traversal workspace"
  },
  "codeExample": "ex-1"
}
