{
  "schemaVersion": "1.1",
  "id": "sll-insert",
  "kind": "linked-list",
  "title": {
    "en": "Insert into a singly linked list",
    "bn": "সিঙ্গলি লিস্টে insert"
  },
  "summary": {
    "en": "Link a new head or walk to the final next field for tail insertion.",
    "bn": "নতুন head জোড়ো, অথবা tail-এ ঢোকাতে শেষ next ফিল্ড পর্যন্ত হাঁটো।"
  },
  "pseudocode": [
    "allocate node and set node.value",
    "if mode == 0: node.next = head; head = node",
    "    if list was empty: tail = node",
    "if mode == 1: walk cur from head to tail",
    "    node.next = NULL; link after tail or set head if empty",
    "    tail = node"
  ],
  "inputs": [
    {
      "name": "values",
      "label": "Values in sequence order",
      "type": "int-array",
      "minLength": 0,
      "maxLength": 8,
      "min": -99,
      "max": 99
    },
    {
      "name": "mode",
      "label": "0=head; 1=tail",
      "type": "int",
      "min": 0,
      "max": 1
    },
    {
      "name": "value",
      "label": "Value to insert",
      "type": "int",
      "min": -99,
      "max": 99
    }
  ],
  "presets": [
    {
      "name": "Head before three marks",
      "input": {
        "values": [
          72,
          85,
          91
        ],
        "mode": 0,
        "value": 64
      }
    },
    {
      "name": "Best: empty first node",
      "input": {
        "values": [],
        "mode": 1,
        "value": 7
      }
    },
    {
      "name": "Worst: walk eight nodes",
      "input": {
        "values": [
          1,
          2,
          3,
          4,
          5,
          6,
          7,
          8
        ],
        "mode": 1,
        "value": 9
      }
    },
    {
      "name": "Duplicate head values",
      "input": {
        "values": [
          7
        ],
        "mode": 0,
        "value": 7
      }
    }
  ],
  "checks": [
    {
      "input": {
        "values": [
          72,
          85
        ],
        "mode": 0,
        "value": 64
      },
      "expect": {
        "values": [
          64,
          72,
          85
        ],
        "head": "new",
        "tail": "n1",
        "next": {
          "new": "n0"
        }
      }
    },
    {
      "input": {
        "values": [],
        "mode": 1,
        "value": 7
      },
      "expect": {
        "values": [
          7
        ],
        "head": "new",
        "tail": "new",
        "next": {
          "new": null
        }
      }
    },
    {
      "input": {
        "values": [
          7,
          7
        ],
        "mode": 1,
        "value": 7
      },
      "expect": {
        "values": [
          7,
          7,
          7
        ],
        "tail": "new",
        "next": {
          "n1": "new",
          "new": null
        }
      }
    }
  ],
  "complexity": {
    "time": "O(1) prepend; O(n) append without a stored tail",
    "space": "O(1) working pointers plus one new node"
  },
  "codeExample": "ex-1"
}
