{
  "schemaVersion": "1.1",
  "id": "sll-reverse",
  "kind": "linked-list",
  "title": {
    "en": "Reverse a linked list",
    "bn": "সিঙ্গলি লিস্ট উল্টানো"
  },
  "summary": {
    "en": "Follow prev, cur and next as each forward link turns backward."
  },
  "pseudocode": [
    "prev = NULL; cur = head",
    "while cur != NULL",
    "    next = cur.next",
    "    cur.next = prev",
    "    prev = cur; cur = next",
    "head = prev; old head is the new tail"
  ],
  "inputs": [
    {
      "name": "values",
      "label": "Values in sequence order",
      "type": "int-array",
      "minLength": 0,
      "maxLength": 8,
      "min": -99,
      "max": 99
    }
  ],
  "presets": [
    {
      "name": "Three different marks",
      "input": {
        "values": [
          72,
          85,
          91
        ]
      }
    },
    {
      "name": "Best: empty list",
      "input": {
        "values": []
      }
    },
    {
      "name": "Single unchanged node",
      "input": {
        "values": [
          7
        ]
      }
    },
    {
      "name": "Longer chain",
      "input": {
        "values": [
          1,
          2,
          3,
          4,
          5,
          6,
          7,
          8
        ]
      }
    }
  ],
  "checks": [
    {
      "input": {
        "values": [
          72,
          85,
          91
        ]
      },
      "expect": {
        "values": [
          91,
          85,
          72
        ],
        "head": "n2",
        "tail": "n0",
        "next": {
          "n0": null,
          "n1": "n0",
          "n2": "n1"
        }
      }
    },
    {
      "input": {
        "values": []
      },
      "expect": {
        "values": [],
        "head": null,
        "tail": null
      }
    },
    {
      "input": {
        "values": [
          7,
          7
        ]
      },
      "expect": {
        "values": [
          7,
          7
        ],
        "head": "n1",
        "tail": "n0",
        "next": {
          "n0": null,
          "n1": "n0"
        }
      }
    }
  ],
  "complexity": {
    "time": "Theta(n)",
    "space": "O(1) auxiliary space"
  },
  "codeExample": "ex-1"
}
