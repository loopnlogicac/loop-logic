{
  "schemaVersion": "1.1",
  "id": "sll-delete",
  "kind": "linked-list",
  "title": {
    "en": "Delete from a singly linked list",
    "bn": "সিঙ্গলি লিস্ট থেকে delete"
  },
  "summary": {
    "en": "Find the first matching node, bypass it and release only that node."
  },
  "pseudocode": [
    "link = address of head",
    "while *link != NULL and (*link).value != target: advance link to next field",
    "if *link == NULL: report absent and stop",
    "victim = *link; *link = victim.next",
    "if victim was drawn as tail: move that endpoint to its predecessor",
    "free victim; finish"
  ],
  "inputs": [
    {
      "name": "values",
      "label": "Values in sequence order",
      "type": "int-array",
      "minLength": 0,
      "maxLength": 8,
      "min": -99,
      "max": 99
    },
    {
      "name": "target",
      "label": "First value to delete",
      "type": "int",
      "min": -99,
      "max": 99
    }
  ],
  "presets": [
    {
      "name": "Interior first match",
      "input": {
        "values": [
          72,
          85,
          85,
          91
        ],
        "target": 85
      }
    },
    {
      "name": "Best: remove head",
      "input": {
        "values": [
          12,
          24,
          36
        ],
        "target": 12
      }
    },
    {
      "name": "Worst: target absent",
      "input": {
        "values": [
          1,
          2,
          3,
          4,
          5,
          6,
          7,
          8
        ],
        "target": 9
      }
    },
    {
      "name": "Edge: remove singleton",
      "input": {
        "values": [
          7
        ],
        "target": 7
      }
    },
    {
      "name": "Edge: empty chain",
      "input": {
        "values": [],
        "target": 7
      }
    }
  ],
  "checks": [
    {
      "input": {
        "values": [
          72,
          85,
          85,
          91
        ],
        "target": 85
      },
      "expect": {
        "values": [
          72,
          85,
          91
        ],
        "next": {
          "n0": "n2",
          "n2": "n3"
        },
        "nodes": {
          "n0": 72,
          "n2": 85,
          "n3": 91
        }
      }
    },
    {
      "input": {
        "values": [
          7
        ],
        "target": 7
      },
      "expect": {
        "values": [],
        "head": null,
        "tail": null,
        "nodes": {}
      }
    },
    {
      "input": {
        "values": [],
        "target": 7
      },
      "expect": {
        "values": [],
        "head": null,
        "tail": null
      }
    },
    {
      "input": {
        "values": [
          7,
          8
        ],
        "target": 99
      },
      "expect": {
        "values": [
          7,
          8
        ],
        "tail": "n1"
      }
    }
  ],
  "complexity": {
    "time": "O(n) worst; O(1) when the head matches",
    "space": "O(1) auxiliary space"
  },
  "codeExample": "ex-1"
}
