{
  "schemaVersion": "1.1",
  "id": "dll-operations",
  "kind": "linked-list",
  "title": {
    "en": "Doubly linked list operations",
    "bn": "ডাবলি লিস্টে insert ও delete"
  },
  "summary": {
    "en": "Insert 64 after head, then remove the inserted node while repairing both directions.",
    "bn": "head-এর পরে 64 ঢোকাও, তারপর দুই দিকের লিংক ঠিক রেখে নতুন নোডটি বাদ দাও।"
  },
  "pseudocode": [
    "cur = head; allocate node with value 64",
    "node.prev = cur; node.next = cur.next (or NULL for empty list)",
    "if successor exists: successor.prev = node; otherwise tail = node",
    "if cur exists: cur.next = node; otherwise head = node",
    "bypass the inserted node in both directions, repairing head and tail",
    "free the inserted node; finish"
  ],
  "inputs": [
    {
      "name": "values",
      "label": "Values in sequence order",
      "type": "int-array",
      "minLength": 0,
      "maxLength": 8,
      "min": -99,
      "max": 99
    }
  ],
  "presets": [
    {
      "name": "Interior four-link repair",
      "input": {
        "values": [
          72,
          85,
          91
        ]
      }
    },
    {
      "name": "Empty insertion and removal",
      "input": {
        "values": []
      }
    },
    {
      "name": "Insert after singleton tail",
      "input": {
        "values": [
          7
        ]
      }
    },
    {
      "name": "Long chain with duplicate valu",
      "input": {
        "values": [
          1,
          1,
          2,
          3,
          4,
          5,
          6,
          7
        ]
      }
    }
  ],
  "checks": [
    {
      "input": {
        "values": [
          72,
          85,
          91
        ]
      },
      "expect": {
        "values": [
          72,
          85,
          91
        ],
        "head": "n0",
        "tail": "n2",
        "next": {
          "n0": "n1"
        },
        "prev": {
          "n1": "n0"
        },
        "nodes": {
          "n0": 72,
          "n1": 85,
          "n2": 91
        }
      }
    },
    {
      "input": {
        "values": []
      },
      "expect": {
        "values": [],
        "head": null,
        "tail": null,
        "nodes": {}
      }
    },
    {
      "input": {
        "values": [
          7
        ]
      },
      "expect": {
        "values": [
          7
        ],
        "head": "n0",
        "tail": "n0",
        "next": {
          "n0": null
        },
        "prev": {
          "n0": null
        }
      }
    }
  ],
  "complexity": {
    "time": "O(1) for insertion and deletion once cur is known",
    "space": "O(1) working storage plus the temporary node"
  },
  "codeExample": "ex-1"
}
