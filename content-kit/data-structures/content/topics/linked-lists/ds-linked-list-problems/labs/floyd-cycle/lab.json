{
  "schemaVersion": "1.1",
  "id": "floyd-cycle",
  "kind": "linked-list",
  "title": {
    "en": "Floyd cycle detection",
    "bn": "Floyd দিয়ে cycle ধরা"
  },
  "summary": {
    "en": "Move slow once and fast twice to distinguish a cycle from duplicate values.",
    "bn": "slow এক আর fast দুই ধাপ চালিয়ে একই মান পাওয়া আর cycle-এর ফারাক দেখো।"
  },
  "pseudocode": [
    "slow = head; fast = head",
    "while fast != NULL and fast.next != NULL",
    "    slow = slow.next",
    "    fast = fast.next.next",
    "    if slow == fast: report cycle and stop",
    "report no cycle if fast reaches the end"
  ],
  "inputs": [
    {
      "name": "values",
      "label": "Values in sequence order",
      "type": "int-array",
      "minLength": 0,
      "maxLength": 8,
      "min": -99,
      "max": 99
    },
    {
      "name": "entry",
      "label": "Cycle entry index; -1 means none",
      "type": "int",
      "min": -1,
      "max": 7
    }
  ],
  "presets": [
    {
      "name": "Cycle enters the second node",
      "input": {
        "values": [
          12,
          24,
          36,
          48
        ],
        "entry": 1
      }
    },
    {
      "name": "Best: no nodes",
      "input": {
        "values": [],
        "entry": -1
      }
    },
    {
      "name": "Duplicate values without cycle",
      "input": {
        "values": [
          7,
          7,
          7
        ],
        "entry": -1
      }
    },
    {
      "name": "Long lead into self-cycle",
      "input": {
        "values": [
          1,
          2,
          3,
          4,
          5,
          6,
          7,
          8
        ],
        "entry": 7
      }
    },
    {
      "name": "Singleton self-link",
      "input": {
        "values": [
          7
        ],
        "entry": 0
      }
    }
  ],
  "checks": [
    {
      "input": {
        "values": [
          12,
          24,
          36,
          48
        ],
        "entry": 1
      },
      "expect": {
        "vars": {
          "cycle": 1
        },
        "next": {
          "n3": "n1"
        }
      }
    },
    {
      "input": {
        "values": [],
        "entry": -1
      },
      "expect": {
        "vars": {
          "cycle": 0
        }
      }
    },
    {
      "input": {
        "values": [
          7,
          7,
          7
        ],
        "entry": -1
      },
      "expect": {
        "vars": {
          "cycle": 0
        }
      }
    },
    {
      "input": {
        "values": [
          7
        ],
        "entry": 0
      },
      "expect": {
        "vars": {
          "cycle": 1
        },
        "next": {
          "n0": "n0"
        }
      }
    }
  ],
  "complexity": {
    "time": "O(n) where n counts distinct reachable nodes",
    "space": "O(1) auxiliary space"
  },
  "codeExample": "ex-1"
}
