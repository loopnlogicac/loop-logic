{
  "schemaVersion": "1.1",
  "id": "array-insert-delete",
  "kind": "array",
  "title": {
    "en": "Insert and delete in an array",
    "bn": "অ্যারেতে insert ও delete"
  },
  "summary": {
    "en": "See each right or left shift while the live size changes inside eight reserved cells.",
    "bn": "আটটি বরাদ্দ ঘরের ভেতরে ব্যবহৃত সাইজ বদলানোর সময় ডানে-বামে প্রতিটি সরানো দেখো।"
  },
  "pseudocode": [
    "validate mode and position against size and capacity",
    "if inserting: move values[i - 1] right, from size down to position + 1",
    "write value at position; increase size",
    "if deleting: move values[i + 1] left, from position through size - 2",
    "decrease size; the old final cell is no longer live",
    "finish with the updated live sequence"
  ],
  "inputs": [
    {
      "name": "values",
      "label": "Values in sequence order",
      "type": "int-array",
      "minLength": 0,
      "maxLength": 8,
      "min": -99,
      "max": 99
    },
    {
      "name": "mode",
      "label": "0 inserts; 1 deletes",
      "type": "int",
      "min": 0,
      "max": 1
    },
    {
      "name": "position",
      "label": "Zero-based position",
      "type": "int",
      "min": 0,
      "max": 8
    },
    {
      "name": "value",
      "label": "New value for insertion",
      "type": "int",
      "min": -99,
      "max": 99
    }
  ],
  "presets": [
    {
      "name": "Insert among marks",
      "input": {
        "values": [
          72,
          85,
          91
        ],
        "mode": 0,
        "position": 1,
        "value": 64
      }
    },
    {
      "name": "Best: append without shifting",
      "input": {
        "values": [
          12,
          24
        ],
        "mode": 0,
        "position": 2,
        "value": 36
      }
    },
    {
      "name": "Worst: insert at front",
      "input": {
        "values": [
          1,
          2,
          3,
          4,
          5,
          6,
          7
        ],
        "mode": 0,
        "position": 0,
        "value": 9
      }
    },
    {
      "name": "Empty deletion",
      "input": {
        "values": [],
        "mode": 1,
        "position": 0,
        "value": 0
      }
    },
    {
      "name": "Full insertion rejected",
      "input": {
        "values": [
          1,
          2,
          3,
          4,
          5,
          6,
          7,
          8
        ],
        "mode": 0,
        "position": 0,
        "value": 9
      }
    },
    {
      "name": "Delete the first mark",
      "input": {
        "values": [
          72,
          85,
          91
        ],
        "mode": 1,
        "position": 0,
        "value": 0
      }
    }
  ],
  "checks": [
    {
      "input": {
        "values": [
          72,
          85,
          91
        ],
        "mode": 0,
        "position": 1,
        "value": 64
      },
      "expect": {
        "array": [
          72,
          64,
          85,
          91,
          null,
          null,
          null,
          null
        ],
        "vars": {
          "size": 4,
          "shifts": 2
        }
      }
    },
    {
      "input": {
        "values": [],
        "mode": 1,
        "position": 0,
        "value": 0
      },
      "expect": {
        "vars": {
          "size": 0,
          "shifts": 0
        }
      }
    },
    {
      "input": {
        "values": [
          7,
          7
        ],
        "mode": 1,
        "position": 0,
        "value": 0
      },
      "expect": {
        "vars": {
          "size": 1,
          "shifts": 1
        },
        "lists": {
          "live": [
            7
          ]
        }
      }
    },
    {
      "input": {
        "values": [
          1,
          2,
          3,
          4,
          5,
          6,
          7,
          8
        ],
        "mode": 0,
        "position": 0,
        "value": 9
      },
      "expect": {
        "vars": {
          "size": 8,
          "shifts": 0
        }
      }
    }
  ],
  "complexity": {
    "time": "O(n) worst; O(1) at the final gap or final element",
    "space": "O(1) working storage beyond the fixed array"
  },
  "codeExample": "ex-1"
}
