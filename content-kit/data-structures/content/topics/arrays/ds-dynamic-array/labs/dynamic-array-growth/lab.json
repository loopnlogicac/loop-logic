{
  "schemaVersion": "1.1",
  "id": "dynamic-array-growth",
  "kind": "array",
  "title": {
    "en": "Watch a dynamic array grow",
    "bn": "ডাইনামিক অ্যারের ক্যাপাসিটি বাড়তে দেখো"
  },
  "summary": {
    "en": "Watch size, spare cells and copied values as append doubles the allocated capacity.",
    "bn": "append-এ ক্যাপাসিটি দ্বিগুণ হলে সাইজ, ফাঁকা ঘর আর কপি হওয়া মানগুলো দেখো।"
  },
  "pseudocode": [
    "start with values = NULL, size = 0, capacity = 0",
    "for each value in input order",
    "    if size == capacity: choose capacity = max(1, 2 * capacity)",
    "        allocate new cells and preserve all size live values",
    "    write value at values[size]; increase size",
    "finish; release the allocation after using it"
  ],
  "inputs": [
    {
      "name": "values",
      "label": "Values in sequence order",
      "type": "int-array",
      "minLength": 0,
      "maxLength": 12,
      "min": -99,
      "max": 99
    }
  ],
  "presets": [
    {
      "name": "Five marks cross capacity four",
      "input": {
        "values": [
          72,
          85,
          64,
          91,
          58
        ]
      }
    },
    {
      "name": "One allocation",
      "input": {
        "values": [
          7
        ]
      }
    },
    {
      "name": "Ninth append grows again",
      "input": {
        "values": [
          1,
          2,
          3,
          4,
          5,
          6,
          7,
          8,
          9
        ]
      }
    },
    {
      "name": "Edge: empty vector",
      "input": {
        "values": []
      }
    }
  ],
  "checks": [
    {
      "input": {
        "values": [
          72,
          85,
          64,
          91,
          58
        ]
      },
      "expect": {
        "vars": {
          "size": 5,
          "capacity": 8,
          "copies": 7
        },
        "lists": {
          "live": [
            72,
            85,
            64,
            91,
            58
          ]
        }
      }
    },
    {
      "input": {
        "values": []
      },
      "expect": {
        "array": [],
        "vars": {
          "size": 0,
          "capacity": 0,
          "copies": 0
        }
      }
    },
    {
      "input": {
        "values": [
          7,
          7,
          7
        ]
      },
      "expect": {
        "array": [
          7,
          7,
          7,
          null
        ],
        "vars": {
          "size": 3,
          "capacity": 4,
          "copies": 3
        }
      }
    }
  ],
  "complexity": {
    "time": "O(n) total for n appends; O(1) amortized per append",
    "space": "O(n) storage; a moving allocation can temporarily use both blocks"
  },
  "codeExample": "ex-4"
}
