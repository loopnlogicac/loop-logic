{
  "schemaVersion": "1.1",
  "id": "kadane",
  "kind": "array",
  "title": {
    "en": "Track the best subarray ending here",
    "bn": "কাডেনের অ্যালগরিদম"
  },
  "summary": {
    "en": "Compare starting a new interval with extending the best interval ending at the previous position."
  },
  "pseudocode": [
    "ending = values[0]; best = ending",
    "for i = 1 to n - 1",
    "    ending = max(values[i], ending + values[i])",
    "    best = max(best, ending)",
    "return best"
  ],
  "inputs": [
    {
      "name": "values",
      "label": "Balance changes",
      "type": "int-array",
      "minLength": 1,
      "maxLength": 12,
      "min": -99,
      "max": 99
    }
  ],
  "presets": [
    {
      "name": "Mixed changes",
      "input": {
        "values": [
          -2,
          3,
          -1,
          4,
          -5
        ]
      }
    },
    {
      "name": "All positive",
      "input": {
        "values": [
          1,
          2,
          3
        ]
      }
    },
    {
      "name": "All negative",
      "input": {
        "values": [
          -8,
          -3,
          -6
        ]
      }
    },
    {
      "name": "One change",
      "input": {
        "values": [
          -9
        ]
      }
    }
  ],
  "checks": [
    {
      "input": {
        "values": [
          -2,
          3,
          -1,
          4,
          -5
        ]
      },
      "expect": {
        "array": [
          -2,
          3,
          -1,
          4,
          -5
        ],
        "vars": {
          "best": 6
        }
      }
    },
    {
      "input": {
        "values": [
          -8,
          -3,
          -6
        ]
      },
      "expect": {
        "vars": {
          "best": -3
        }
      }
    },
    {
      "input": {
        "values": [
          0
        ]
      },
      "expect": {
        "vars": {
          "best": 0
        }
      }
    }
  ],
  "complexity": {
    "time": "Θ(n)",
    "space": "Θ(1)"
  },
  "codeExample": "ex-1"
}
