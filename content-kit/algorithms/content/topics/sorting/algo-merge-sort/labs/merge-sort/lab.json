{
  "schemaVersion": "1.1",
  "id": "merge-sort",
  "kind": "array",
  "title": {
    "en": "Sort by merging ordered halves",
    "bn": "সাজানো দুই অর্ধেক মিলিয়ে সর্ট করো"
  },
  "summary": {
    "en": "Follow merge sort decisions on a small array and watch the candidate positions change."
  },
  "pseudocode": [
    "merge_sort(a, temp, low, high): if high - low < 2: return",
    "mid = low + floor((high - low) / 2)",
    "merge_sort(a, temp, low, mid)",
    "merge_sort(a, temp, mid, high); i = low; j = mid; k = low",
    "merge fronts into temp; choose left on equality",
    "copy any remaining tail into temp",
    "copy temp[low..high) back into a"
  ],
  "codeExample": "ex-1",
  "inputs": [
    {
      "name": "values",
      "label": "Values",
      "type": "int-array",
      "minLength": 0,
      "maxLength": 12,
      "min": -99,
      "max": 99
    }
  ],
  "presets": [
    {
      "name": "Five marks with a tie",
      "input": {
        "values": [
          7,
          3,
          5,
          3,
          1
        ]
      }
    },
    {
      "name": "Already ascending",
      "input": {
        "values": [
          1,
          2,
          3,
          4,
          5
        ]
      }
    },
    {
      "name": "Reverse order",
      "input": {
        "values": [
          5,
          4,
          3,
          2,
          1
        ]
      }
    },
    {
      "name": "One value",
      "input": {
        "values": [
          5
        ]
      }
    },
    {
      "name": "Empty array",
      "input": {
        "values": []
      }
    }
  ],
  "checks": [
    {
      "input": {
        "values": [
          7,
          3,
          5,
          3,
          1
        ]
      },
      "expect": {
        "array": [
          1,
          3,
          3,
          5,
          7
        ]
      }
    },
    {
      "input": {
        "values": []
      },
      "expect": {
        "array": []
      }
    },
    {
      "input": {
        "values": [
          5
        ]
      },
      "expect": {
        "array": [
          5
        ]
      }
    },
    {
      "input": {
        "values": [
          3,
          3,
          -1,
          3
        ]
      },
      "expect": {
        "array": [
          -1,
          3,
          3,
          3
        ]
      }
    },
    {
      "input": {
        "values": [
          1,
          2,
          3
        ]
      },
      "expect": {
        "array": [
          1,
          2,
          3
        ]
      }
    }
  ],
  "complexity": {
    "time": "Theta(n log n)",
    "space": "O(n) auxiliary plus O(log n) stack"
  }
}
