{
  "schemaVersion": "1.1",
  "id": "heap-sort",
  "kind": "heap",
  "title": {
    "en": "Heap sort",
    "bn": "হিপ সর্ট"
  },
  "summary": {
    "en": "Follow heap sort decisions on a small array and watch the candidate positions change."
  },
  "pseudocode": [
    "for root = floor(n / 2) - 1 down to 0: sift(n, root)",
    "sift(size, root): while root has a child",
    "    child = index of larger child",
    "    if a[root] >= a[child]: stop sifting",
    "    swap a[root], a[child]; root = child",
    "for end = n - 1 down to 1",
    "    swap a[0], a[end]",
    "    sift(end, 0)"
  ],
  "codeExample": "ex-1",
  "inputs": [
    {
      "name": "values",
      "label": "Values",
      "type": "int-array",
      "minLength": 0,
      "maxLength": 12,
      "min": -99,
      "max": 99
    }
  ],
  "presets": [
    {
      "name": "Five marks with a tie",
      "input": {
        "values": [
          7,
          3,
          5,
          3,
          1
        ]
      }
    },
    {
      "name": "Already ascending",
      "input": {
        "values": [
          1,
          2,
          3,
          4,
          5
        ]
      }
    },
    {
      "name": "Reverse order",
      "input": {
        "values": [
          5,
          4,
          3,
          2,
          1
        ]
      }
    },
    {
      "name": "One value",
      "input": {
        "values": [
          5
        ]
      }
    },
    {
      "name": "Empty array",
      "input": {
        "values": []
      }
    },
    {
      "name": "Equal keys stop sifts early",
      "input": {
        "values": [
          3,
          3,
          3,
          3,
          3,
          3,
          3,
          3
        ]
      }
    }
  ],
  "checks": [
    {
      "input": {
        "values": [
          7,
          3,
          5,
          3,
          1
        ]
      },
      "expect": {
        "array": [
          1,
          3,
          3,
          5,
          7
        ]
      }
    },
    {
      "input": {
        "values": []
      },
      "expect": {
        "array": []
      }
    },
    {
      "input": {
        "values": [
          5
        ]
      },
      "expect": {
        "array": [
          5
        ]
      }
    },
    {
      "input": {
        "values": [
          3,
          3,
          -1,
          3
        ]
      },
      "expect": {
        "array": [
          -1,
          3,
          3,
          3
        ]
      }
    },
    {
      "input": {
        "values": [
          1,
          2,
          3
        ]
      },
      "expect": {
        "array": [
          1,
          2,
          3
        ]
      }
    }
  ],
  "complexity": {
    "time": "O(n log n) worst",
    "space": "O(1) with iterative sift"
  }
}
