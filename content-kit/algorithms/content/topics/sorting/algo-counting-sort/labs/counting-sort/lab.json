{
  "schemaVersion": "1.1",
  "id": "counting-sort",
  "kind": "array",
  "title": {
    "en": "Sort using value frequencies",
    "bn": "Frequency ও prefix থেকে stable সর্ট করো"
  },
  "summary": {
    "en": "Follow counting sort decisions on a small array and watch the candidate positions change.",
    "bn": "Bounded key গুনে group-এর end বের করো, তারপর ডান থেকে record বসাও।"
  },
  "pseudocode": [
    "count[0..198] = 0; allocate output[0..n)",
    "for i = 0 to n - 1: count[a[i] + 99]++",
    "for key = 1 to 198: count[key] += count[key - 1]",
    "for i = n - 1 down to 0: output[--count[a[i] + 99]] = a[i]",
    "copy output into a"
  ],
  "codeExample": "ex-1",
  "inputs": [
    {
      "name": "values",
      "label": "Values",
      "type": "int-array",
      "minLength": 0,
      "maxLength": 12,
      "min": -99,
      "max": 99
    }
  ],
  "presets": [
    {
      "name": "Five marks with a tie",
      "input": {
        "values": [
          7,
          3,
          5,
          3,
          1
        ]
      }
    },
    {
      "name": "Already ascending",
      "input": {
        "values": [
          1,
          2,
          3,
          4,
          5
        ]
      }
    },
    {
      "name": "Reverse order",
      "input": {
        "values": [
          5,
          4,
          3,
          2,
          1
        ]
      }
    },
    {
      "name": "One value",
      "input": {
        "values": [
          5
        ]
      }
    },
    {
      "name": "Empty array",
      "input": {
        "values": []
      }
    },
    {
      "name": "Every key tied",
      "input": {
        "values": [
          3,
          3,
          3,
          3
        ]
      }
    }
  ],
  "checks": [
    {
      "input": {
        "values": [
          7,
          3,
          5,
          3,
          1
        ]
      },
      "expect": {
        "array": [
          1,
          3,
          3,
          5,
          7
        ]
      }
    },
    {
      "input": {
        "values": []
      },
      "expect": {
        "array": []
      }
    },
    {
      "input": {
        "values": [
          5
        ]
      },
      "expect": {
        "array": [
          5
        ]
      }
    },
    {
      "input": {
        "values": [
          3,
          3,
          -1,
          3
        ]
      },
      "expect": {
        "array": [
          -1,
          3,
          3,
          3
        ]
      }
    },
    {
      "input": {
        "values": [
          1,
          2,
          3
        ]
      },
      "expect": {
        "array": [
          1,
          2,
          3
        ]
      }
    }
  ],
  "complexity": {
    "time": "Theta(n + k), k = 199",
    "space": "Theta(n + k)"
  }
}
