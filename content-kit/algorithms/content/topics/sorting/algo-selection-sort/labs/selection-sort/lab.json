{
  "schemaVersion": "1.1",
  "id": "selection-sort",
  "kind": "array",
  "title": {
    "en": "Select the minimum for each position",
    "bn": "প্রতি পজিশনে বাকি minimum বসাও"
  },
  "summary": {
    "en": "Follow selection sort decisions on a small array and watch the candidate positions change.",
    "bn": "Suffix scan করে minimum index রাখো, তারপর সর্বোচ্চ একটি সোয়াপে prefix বাড়াও।"
  },
  "pseudocode": [
    "for i = 0 to n - 2",
    "    min = i",
    "    for j = i + 1 to n - 1",
    "        if a[j] < a[min]: min = j",
    "    if min != i: swap a[i], a[min]",
    "    a[i] is final"
  ],
  "codeExample": "ex-1",
  "inputs": [
    {
      "name": "values",
      "label": "Values",
      "type": "int-array",
      "minLength": 0,
      "maxLength": 12,
      "min": -99,
      "max": 99
    }
  ],
  "presets": [
    {
      "name": "Five marks with a tie",
      "input": {
        "values": [
          7,
          3,
          5,
          3,
          1
        ]
      }
    },
    {
      "name": "Already ascending",
      "input": {
        "values": [
          1,
          2,
          3,
          4,
          5
        ]
      }
    },
    {
      "name": "Reverse order",
      "input": {
        "values": [
          5,
          4,
          3,
          2,
          1
        ]
      }
    },
    {
      "name": "One value",
      "input": {
        "values": [
          5
        ]
      }
    },
    {
      "name": "Empty array",
      "input": {
        "values": []
      }
    }
  ],
  "checks": [
    {
      "input": {
        "values": [
          7,
          3,
          5,
          3,
          1
        ]
      },
      "expect": {
        "array": [
          1,
          3,
          3,
          5,
          7
        ]
      }
    },
    {
      "input": {
        "values": []
      },
      "expect": {
        "array": []
      }
    },
    {
      "input": {
        "values": [
          5
        ]
      },
      "expect": {
        "array": [
          5
        ]
      }
    },
    {
      "input": {
        "values": [
          3,
          3,
          -1,
          3
        ]
      },
      "expect": {
        "array": [
          -1,
          3,
          3,
          3
        ]
      }
    },
    {
      "input": {
        "values": [
          1,
          2,
          3
        ]
      },
      "expect": {
        "array": [
          1,
          2,
          3
        ]
      }
    }
  ],
  "complexity": {
    "time": "Theta(n²) comparisons in every case",
    "space": "O(1)"
  }
}
