{
  "schemaVersion": "1.1",
  "id": "quick-sort",
  "kind": "array",
  "title": {
    "en": "Partition and sort with Lomuto quick sort",
    "bn": "Lomuto partition দিয়ে সর্ট করো"
  },
  "summary": {
    "en": "Follow quick sort decisions on a small array and watch the candidate positions change.",
    "bn": "শেষ মান pivot করে দুই অঞ্চল আলাদা করো; final pivot বাদ দিয়ে বাকি interval সাজাও।"
  },
  "pseudocode": [
    "quick_sort(low, high): if low >= high: return",
    "pivot = a[high]; i = low",
    "for j = low to high - 1",
    "    if a[j] <= pivot: swap a[i], a[j]; i = i + 1",
    "swap a[i], a[high]; p = i",
    "quick_sort(low, p - 1)",
    "quick_sort(p + 1, high)"
  ],
  "codeExample": "ex-1",
  "inputs": [
    {
      "name": "values",
      "label": "Values",
      "type": "int-array",
      "minLength": 0,
      "maxLength": 12,
      "min": -99,
      "max": 99
    }
  ],
  "presets": [
    {
      "name": "Five marks with a tie",
      "input": {
        "values": [
          7,
          3,
          5,
          3,
          1
        ]
      }
    },
    {
      "name": "Already ascending",
      "input": {
        "values": [
          1,
          2,
          3,
          4,
          5
        ]
      }
    },
    {
      "name": "Reverse order",
      "input": {
        "values": [
          5,
          4,
          3,
          2,
          1
        ]
      }
    },
    {
      "name": "One value",
      "input": {
        "values": [
          5
        ]
      }
    },
    {
      "name": "Empty array",
      "input": {
        "values": []
      }
    },
    {
      "name": "Balanced pivot ranks",
      "input": {
        "values": [
          1,
          3,
          2,
          6,
          5,
          7,
          4
        ]
      }
    }
  ],
  "checks": [
    {
      "input": {
        "values": [
          7,
          3,
          5,
          3,
          1
        ]
      },
      "expect": {
        "array": [
          1,
          3,
          3,
          5,
          7
        ]
      }
    },
    {
      "input": {
        "values": []
      },
      "expect": {
        "array": []
      }
    },
    {
      "input": {
        "values": [
          5
        ]
      },
      "expect": {
        "array": [
          5
        ]
      }
    },
    {
      "input": {
        "values": [
          3,
          3,
          -1,
          3
        ]
      },
      "expect": {
        "array": [
          -1,
          3,
          3,
          3
        ]
      }
    },
    {
      "input": {
        "values": [
          1,
          2,
          3
        ]
      },
      "expect": {
        "array": [
          1,
          2,
          3
        ]
      }
    }
  ],
  "complexity": {
    "time": "O(n²) worst; Theta(n log n) expected for random pivots",
    "space": "O(n) stack worst; O(log n) expected"
  }
}
