{
  "schemaVersion": "1.1",
  "id": "insertion-sort",
  "kind": "array",
  "title": {
    "en": "Insert values into a sorted prefix",
    "bn": "Sorted prefix-এ saved key বসাও"
  },
  "summary": {
    "en": "Follow insertion sort decisions on a small array and watch the candidate positions change.",
    "bn": "বড় predecessor ডানে shift করে key-এর জায়গা বানাও; equal key-এর আগের ক্রম রাখো।"
  },
  "pseudocode": [
    "for i = 1 to n - 1",
    "    key = a[i]; j = i - 1",
    "    while j >= 0 and a[j] > key",
    "        a[j + 1] = a[j]; j = j - 1",
    "    a[j + 1] = key",
    "    a[0..i] is sorted"
  ],
  "codeExample": "ex-1",
  "inputs": [
    {
      "name": "values",
      "label": "Values",
      "type": "int-array",
      "minLength": 0,
      "maxLength": 12,
      "min": -99,
      "max": 99
    }
  ],
  "presets": [
    {
      "name": "Five marks with a tie",
      "input": {
        "values": [
          7,
          3,
          5,
          3,
          1
        ]
      }
    },
    {
      "name": "Already ascending",
      "input": {
        "values": [
          1,
          2,
          3,
          4,
          5
        ]
      }
    },
    {
      "name": "Reverse order",
      "input": {
        "values": [
          5,
          4,
          3,
          2,
          1
        ]
      }
    },
    {
      "name": "One value",
      "input": {
        "values": [
          5
        ]
      }
    },
    {
      "name": "Empty array",
      "input": {
        "values": []
      }
    }
  ],
  "checks": [
    {
      "input": {
        "values": [
          7,
          3,
          5,
          3,
          1
        ]
      },
      "expect": {
        "array": [
          1,
          3,
          3,
          5,
          7
        ]
      }
    },
    {
      "input": {
        "values": []
      },
      "expect": {
        "array": []
      }
    },
    {
      "input": {
        "values": [
          5
        ]
      },
      "expect": {
        "array": [
          5
        ]
      }
    },
    {
      "input": {
        "values": [
          3,
          3,
          -1,
          3
        ]
      },
      "expect": {
        "array": [
          -1,
          3,
          3,
          3
        ]
      }
    },
    {
      "input": {
        "values": [
          1,
          2,
          3
        ]
      },
      "expect": {
        "array": [
          1,
          2,
          3
        ]
      }
    }
  ],
  "complexity": {
    "time": "O(n²) worst; O(n) best",
    "space": "O(1)"
  }
}
