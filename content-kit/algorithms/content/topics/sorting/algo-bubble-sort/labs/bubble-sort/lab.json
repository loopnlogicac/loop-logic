{
  "schemaVersion": "1.1",
  "id": "bubble-sort",
  "kind": "array",
  "title": {
    "en": "Sort by swapping neighbouring values",
    "bn": "পাশাপাশি মান সোয়াপ করে সর্ট করো"
  },
  "summary": {
    "en": "Watch neighbouring values swap until the largest values bubble to the end.",
    "bn": "প্রতি pass-এ বড় মান ডানে নাও; পুরো pass-এ সোয়াপ না হলে থামো।"
  },
  "pseudocode": [
    "for pass = 0 to n - 2",
    "    swapped = false",
    "    for j = 0 to n - 2 - pass",
    "        if a[j] > a[j + 1]",
    "            swap a[j] and a[j + 1]",
    "            swapped = true",
    "    a[n - 1 - pass] is now in place",
    "    if not swapped: stop early"
  ],
  "inputs": [
    {
      "name": "values",
      "label": "Values",
      "type": "int-array",
      "minLength": 0,
      "maxLength": 12,
      "min": -99,
      "max": 99
    }
  ],
  "presets": [
    {
      "name": "Five marks with a tie",
      "input": {
        "values": [
          7,
          3,
          5,
          3,
          1
        ]
      }
    },
    {
      "name": "Already ascending",
      "input": {
        "values": [
          1,
          2,
          3,
          4,
          5
        ]
      }
    },
    {
      "name": "Reverse order",
      "input": {
        "values": [
          5,
          4,
          3,
          2,
          1
        ]
      }
    },
    {
      "name": "One value",
      "input": {
        "values": [
          5
        ]
      }
    },
    {
      "name": "Empty array",
      "input": {
        "values": []
      }
    }
  ],
  "checks": [
    {
      "input": {
        "values": [
          7,
          3,
          5,
          3,
          1
        ]
      },
      "expect": {
        "array": [
          1,
          3,
          3,
          5,
          7
        ]
      }
    },
    {
      "input": {
        "values": []
      },
      "expect": {
        "array": []
      }
    },
    {
      "input": {
        "values": [
          5
        ]
      },
      "expect": {
        "array": [
          5
        ]
      }
    },
    {
      "input": {
        "values": [
          3,
          3,
          -1,
          3
        ]
      },
      "expect": {
        "array": [
          -1,
          3,
          3,
          3
        ]
      }
    },
    {
      "input": {
        "values": [
          1,
          2,
          3
        ]
      },
      "expect": {
        "array": [
          1,
          2,
          3
        ]
      }
    }
  ],
  "complexity": {
    "time": "O(n²) worst and average; O(n) best",
    "space": "O(1)"
  },
  "codeExample": "ex-1"
}
