{
  "schemaVersion": "1.1",
  "id": "lis-dp",
  "kind": "grid",
  "title": {
    "en": "LIS ending lengths",
    "bn": "LIS-এর শেষ অবস্থানভিত্তিক দৈর্ঘ্য"
  },
  "summary": {
    "en": "Compare each value with earlier smaller values and retain predecessor indices for one strict increasing subsequence."
  },
  "pseudocode": [
    "for i = 0 to n-1: dp[i] = 1; previous[i] = -1",
    "for i = 0 to n-1",
    "    for j = 0 to i-1",
    "        if values[j] < values[i] and dp[j]+1 > dp[i]",
    "            dp[i] = dp[j]+1; previous[i] = j",
    "    keep earliest index with greatest dp value",
    "follow previous indices backward and reverse",
    "return length and sequence"
  ],
  "inputs": [
    {
      "name": "values",
      "label": "Sequence values",
      "type": "int-array",
      "minLength": 0,
      "maxLength": 12,
      "min": -99,
      "max": 99
    }
  ],
  "presets": [
    {
      "name": "Mixed progress",
      "input": {
        "values": [
          3,
          1,
          2,
          5,
          4
        ]
      }
    },
    {
      "name": "Already increasing",
      "input": {
        "values": [
          1,
          2,
          3,
          4
        ]
      }
    },
    {
      "name": "Strictly decreasing",
      "input": {
        "values": [
          4,
          3,
          2,
          1
        ]
      }
    },
    {
      "name": "Empty sequence",
      "input": {
        "values": []
      }
    },
    {
      "name": "Equal keys",
      "input": {
        "values": [
          2,
          2,
          2
        ]
      }
    },
    {
      "name": "Twelve increasing values",
      "input": {
        "values": [
          -99,
          -80,
          -50,
          -20,
          -10,
          0,
          10,
          20,
          30,
          40,
          80,
          99
        ]
      }
    }
  ],
  "checks": [
    {
      "input": {
        "values": [
          3,
          1,
          2,
          5,
          4
        ]
      },
      "expect": {
        "cells": [
          [
            3,
            1,
            2,
            5,
            4
          ],
          [
            1,
            1,
            2,
            3,
            3
          ],
          [
            -1,
            -1,
            1,
            2,
            2
          ]
        ],
        "vars": {
          "length": 3
        },
        "lists": {
          "sequence": [
            1,
            2,
            5
          ]
        }
      }
    },
    {
      "input": {
        "values": [
          2,
          2,
          2
        ]
      },
      "expect": {
        "vars": {
          "length": 1
        },
        "lists": {
          "sequence": [
            2
          ]
        }
      }
    },
    {
      "input": {
        "values": []
      },
      "expect": {
        "vars": {
          "length": 0
        },
        "lists": {
          "sequence": []
        }
      }
    }
  ],
  "complexity": {
    "time": "Θ(n²)",
    "space": "Θ(n)"
  },
  "codeExample": "ex-1"
}
