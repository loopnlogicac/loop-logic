{
  "schemaVersion": "1.1",
  "id": "matrix-chain-dp",
  "kind": "grid",
  "title": {
    "en": "Matrix chain DP table",
    "bn": "ম্যাট্রিক্স চেইনের DP টেবিল"
  },
  "summary": {
    "en": "Fill intervals by length, compare every final split, and recover the multiplication parentheses."
  },
  "pseudocode": [
    "dp[i][i] = 0",
    "for length = 2 to n",
    "    for i = 0 to n-length: j = i+length-1",
    "        for k = i to j-1",
    "            try dp[i][k]+dp[k+1][j]+dims[i]*dims[k+1]*dims[j+1]",
    "            keep smaller cost and its split k",
    "print recursively using split[i][j]",
    "return dp[0][n-1] and order"
  ],
  "inputs": [
    {
      "name": "dims",
      "label": "Consecutive matrix dimensions",
      "type": "int-array",
      "minLength": 2,
      "maxLength": 9,
      "min": 1,
      "max": 100
    }
  ],
  "presets": [
    {
      "name": "Unequal dimensions",
      "input": {
        "dims": [
          10,
          30,
          5,
          60
        ]
      }
    },
    {
      "name": "One matrix",
      "input": {
        "dims": [
          10,
          20
        ]
      }
    },
    {
      "name": "Equal dimensions",
      "input": {
        "dims": [
          5,
          5,
          5,
          5
        ]
      }
    },
    {
      "name": "Longer chain",
      "input": {
        "dims": [
          30,
          5,
          60,
          10,
          20
        ]
      }
    }
  ],
  "checks": [
    {
      "input": {
        "dims": [
          10,
          30,
          5,
          60
        ]
      },
      "expect": {
        "cells": [
          [
            0,
            1500,
            4500
          ],
          [
            null,
            0,
            9000
          ],
          [
            null,
            null,
            0
          ]
        ],
        "vars": {
          "cost": 4500
        },
        "lists": {
          "order": [
            "(",
            "(",
            "A1",
            "A2",
            ")",
            "A3",
            ")"
          ]
        }
      }
    },
    {
      "input": {
        "dims": [
          10,
          20
        ]
      },
      "expect": {
        "cells": [
          [
            0
          ]
        ],
        "vars": {
          "cost": 0
        },
        "lists": {
          "order": [
            "A1"
          ]
        }
      }
    },
    {
      "input": {
        "dims": [
          5,
          5,
          5,
          5
        ]
      },
      "expect": {
        "vars": {
          "cost": 250
        },
        "lists": {
          "order": [
            "(",
            "A1",
            "(",
            "A2",
            "A3",
            ")",
            ")"
          ]
        }
      }
    }
  ],
  "complexity": {
    "time": "Θ(n³)",
    "space": "Θ(n²)"
  },
  "codeExample": "ex-1"
}
