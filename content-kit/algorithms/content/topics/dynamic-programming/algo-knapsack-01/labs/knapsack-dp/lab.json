{
  "schemaVersion": "1.1",
  "id": "knapsack-dp",
  "kind": "grid",
  "title": {
    "en": "0/1 knapsack table",
    "bn": "০/১ ন্যাপস্যাকের টেবিল"
  },
  "summary": {
    "en": "Choose between skipping an item and taking it once, then walk back through item rows."
  },
  "pseudocode": [
    "dp[0][c] = 0 for every capacity c",
    "for i = 1 to n",
    "    for c = 0 to capacity",
    "        dp[i][c] = dp[i-1][c]",
    "        if weight[i-1] <= c: try value[i-1]+dp[i-1][c-weight[i-1]]",
    "        retain a larger candidate; skip on ties",
    "walk backward: changed row means take item and reduce c",
    "return value and increasing chosen IDs"
  ],
  "inputs": [
    {
      "name": "items",
      "label": "Equipment set",
      "type": "int",
      "min": 0,
      "max": 3
    },
    {
      "name": "capacity",
      "label": "Weight capacity",
      "type": "int",
      "min": 0,
      "max": 20
    }
  ],
  "presets": [
    {
      "name": "Three equipment items",
      "input": {
        "items": 0,
        "capacity": 5
      }
    },
    {
      "name": "Everything fits",
      "input": {
        "items": 0,
        "capacity": 20
      }
    },
    {
      "name": "Nothing fits",
      "input": {
        "items": 0,
        "capacity": 1
      }
    },
    {
      "name": "No equipment",
      "input": {
        "items": 3,
        "capacity": 0
      }
    }
  ],
  "checks": [
    {
      "input": {
        "items": 0,
        "capacity": 5
      },
      "expect": {
        "cells": [
          [
            0,
            0,
            0,
            0,
            0,
            0
          ],
          [
            0,
            0,
            4,
            4,
            4,
            4
          ],
          [
            0,
            0,
            4,
            5,
            5,
            9
          ],
          [
            0,
            0,
            4,
            5,
            7,
            9
          ]
        ],
        "vars": {
          "value": 9,
          "chosen": "0 1"
        }
      }
    },
    {
      "input": {
        "items": 0,
        "capacity": 0
      },
      "expect": {
        "vars": {
          "value": 0,
          "chosen": ""
        }
      }
    },
    {
      "input": {
        "items": 3,
        "capacity": 0
      },
      "expect": {
        "cells": [
          [
            0
          ]
        ],
        "vars": {
          "value": 0,
          "chosen": ""
        }
      }
    }
  ],
  "complexity": {
    "time": "Θ(nC)",
    "space": "Θ(nC)"
  },
  "codeExample": "ex-1"
}
