{
  "schemaVersion": "1.1",
  "id": "edit-distance-dp",
  "kind": "grid",
  "title": {
    "en": "Edit distance table",
    "bn": "এডিট ডিসট্যান্সের টেবিল"
  },
  "summary": {
    "en": "Compare a diagonal match or replacement with deletion and insertion, then recover a minimum editing alignment."
  },
  "pseudocode": [
    "dp[i][0] = i; dp[0][j] = j",
    "for i = 1 to length(a)",
    "    for j = 1 to length(b)",
    "        diagonal = dp[i-1][j-1] + (a[i-1] != b[j-1])",
    "        dp[i][j] = min(diagonal, dp[i-1][j]+1, dp[i][j-1]+1)",
    "        record diagonal, up, left in that tie order",
    "walk predecessors; reverse the alignment operations",
    "return distance and edits"
  ],
  "inputs": [
    {
      "name": "a",
      "label": "Original text",
      "type": "string",
      "maxLength": 12,
      "alphabet": "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    },
    {
      "name": "b",
      "label": "Desired text",
      "type": "string",
      "maxLength": 12,
      "alphabet": "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    }
  ],
  "presets": [
    {
      "name": "One replacement",
      "input": {
        "a": "CAT",
        "b": "CUT"
      }
    },
    {
      "name": "Identical text",
      "input": {
        "a": "ABC",
        "b": "ABC"
      }
    },
    {
      "name": "Three replacements",
      "input": {
        "a": "AAA",
        "b": "BBB"
      }
    },
    {
      "name": "Insert into empty",
      "input": {
        "a": "",
        "b": "AB"
      }
    }
  ],
  "checks": [
    {
      "input": {
        "a": "CAT",
        "b": "CUT"
      },
      "expect": {
        "cells": [
          [
            0,
            1,
            2,
            3
          ],
          [
            1,
            0,
            1,
            2
          ],
          [
            2,
            1,
            1,
            2
          ],
          [
            3,
            2,
            2,
            1
          ]
        ],
        "vars": {
          "distance": 1
        },
        "lists": {
          "edits": [
            "replace A with U"
          ]
        }
      }
    },
    {
      "input": {
        "a": "",
        "b": "AB"
      },
      "expect": {
        "cells": [
          [
            0,
            1,
            2
          ]
        ],
        "vars": {
          "distance": 2
        },
        "lists": {
          "edits": [
            "insert A",
            "insert B"
          ]
        }
      }
    },
    {
      "input": {
        "a": "AB",
        "b": "AB"
      },
      "expect": {
        "vars": {
          "distance": 0
        },
        "lists": {
          "edits": []
        }
      }
    }
  ],
  "complexity": {
    "time": "Θ(nm)",
    "space": "Θ(nm)"
  },
  "codeExample": "ex-1"
}
