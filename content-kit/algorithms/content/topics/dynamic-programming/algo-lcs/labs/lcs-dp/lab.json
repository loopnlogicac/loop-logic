{
  "schemaVersion": "1.1",
  "id": "lcs-dp",
  "kind": "grid",
  "title": {
    "en": "LCS table",
    "bn": "LCS টেবিল"
  },
  "summary": {
    "en": "Add matching letters diagonally, compare shorter prefixes otherwise, and follow arrows to recover one LCS."
  },
  "pseudocode": [
    "zero row 0 and column 0",
    "for i = 1 to length(a)",
    "    for j = 1 to length(b)",
    "        if a[i-1] = b[j-1]: dp[i][j] = dp[i-1][j-1]+1; arrow diag",
    "        else: max(up,left); prefer up on ties",
    "walk from bottom right; collect diagonal matches backward",
    "reverse collected matches and return"
  ],
  "inputs": [
    {
      "name": "a",
      "label": "First string",
      "type": "string",
      "maxLength": 12,
      "alphabet": "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    },
    {
      "name": "b",
      "label": "Second string",
      "type": "string",
      "maxLength": 12,
      "alphabet": "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    }
  ],
  "presets": [
    {
      "name": "Several optimal answers",
      "input": {
        "a": "ABCBDAB",
        "b": "BDCABA"
      }
    },
    {
      "name": "Identical labels",
      "input": {
        "a": "ABC",
        "b": "ABC"
      }
    },
    {
      "name": "No shared letter",
      "input": {
        "a": "AAA",
        "b": "BBB"
      }
    },
    {
      "name": "Empty first label",
      "input": {
        "a": "",
        "b": "ABC"
      }
    },
    {
      "name": "Full prefix grid",
      "input": {
        "a": "ABABABABABAB",
        "b": "BABABABABABA"
      }
    }
  ],
  "checks": [
    {
      "input": {
        "a": "ABCBDAB",
        "b": "BDCABA"
      },
      "expect": {
        "vars": {
          "length": 4,
          "sequence": "BCBA"
        }
      }
    },
    {
      "input": {
        "a": "AAA",
        "b": "BBB"
      },
      "expect": {
        "vars": {
          "length": 0,
          "sequence": ""
        }
      }
    },
    {
      "input": {
        "a": "",
        "b": "ABC"
      },
      "expect": {
        "cells": [
          [
            0,
            0,
            0,
            0
          ]
        ],
        "vars": {
          "length": 0,
          "sequence": ""
        }
      }
    }
  ],
  "complexity": {
    "time": "Θ(nm)",
    "space": "Θ(nm)"
  },
  "codeExample": "ex-1"
}
