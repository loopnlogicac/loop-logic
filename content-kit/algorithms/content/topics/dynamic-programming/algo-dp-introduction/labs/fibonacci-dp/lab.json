{
  "schemaVersion": "1.1",
  "id": "fibonacci-dp",
  "kind": "grid",
  "title": {
    "en": "Compute Fibonacci values with a DP table",
    "bn": "DP টেবিলে Fibonacci মান হিসাব করো"
  },
  "summary": {
    "en": "Fill one grid row from left to right so every Fibonacci sum uses two completed cells.",
    "bn": "বাঁ থেকে ডানে row ভরো; প্রতিটি যোগে আগে পূর্ণ হওয়া দুই cell নাও।"
  },
  "pseudocode": [
    "dp[0] = 0; if n >= 1: dp[1] = 1",
    "for i = 2 to n",
    "    dp[i] = dp[i - 1] + dp[i - 2]",
    "return dp[n]"
  ],
  "inputs": [
    {
      "name": "n",
      "label": "Fibonacci index",
      "type": "int",
      "min": 0,
      "max": 20
    }
  ],
  "presets": [
    {
      "name": "Index seven",
      "input": {
        "n": 7
      }
    },
    {
      "name": "First base",
      "input": {
        "n": 0
      }
    },
    {
      "name": "Second base",
      "input": {
        "n": 1
      }
    },
    {
      "name": "Longest allowed row",
      "input": {
        "n": 20
      }
    }
  ],
  "checks": [
    {
      "input": {
        "n": 7
      },
      "expect": {
        "cells": [
          [
            0,
            1,
            1,
            2,
            3,
            5,
            8,
            13
          ]
        ],
        "vars": {
          "answer": 13
        }
      }
    },
    {
      "input": {
        "n": 0
      },
      "expect": {
        "cells": [
          [
            0
          ]
        ],
        "vars": {
          "answer": 0
        }
      }
    },
    {
      "input": {
        "n": 1
      },
      "expect": {
        "cells": [
          [
            0,
            1
          ]
        ],
        "vars": {
          "answer": 1
        }
      }
    }
  ],
  "complexity": {
    "time": "Θ(n)",
    "space": "Θ(n)"
  },
  "codeExample": "ex-1"
}
