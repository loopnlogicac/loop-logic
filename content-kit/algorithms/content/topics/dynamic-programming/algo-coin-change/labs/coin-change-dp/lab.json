{
  "schemaVersion": "1.1",
  "id": "coin-change-dp",
  "kind": "grid",
  "title": {
    "en": "Find a minimum payment with coin change DP",
    "bn": "DP থেকে minimum coin-এর payment ফেরাও"
  },
  "summary": {
    "en": "Fill minimum counts and chosen final coins, then follow decreasing amounts to recover a payment.",
    "bn": "Minimum count ও final coin রাখো; ছোট amount ধরে হাঁটলে exact payment ফেরে।"
  },
  "pseudocode": [
    "dp[0] = 0; take[0] = 0",
    "for amount a = 1 to target",
    "    dp[a] = infinity; take[a] = 0",
    "    for each distinct coin in increasing order",
    "        if coin <= a and dp[a-coin]+1 < dp[a]",
    "            dp[a] = dp[a-coin]+1; take[a] = coin",
    "if reachable: repeatedly take take[a] and subtract it",
    "return minimum and recovered coins"
  ],
  "inputs": [
    {
      "name": "coins",
      "label": "Positive denominations",
      "type": "int-array",
      "minLength": 1,
      "maxLength": 6,
      "min": 1,
      "max": 9
    },
    {
      "name": "amount",
      "label": "Target amount",
      "type": "int",
      "min": 0,
      "max": 20
    }
  ],
  "presets": [
    {
      "name": "Greedy fails at six",
      "input": {
        "coins": [
          1,
          3,
          4
        ],
        "amount": 6
      }
    },
    {
      "name": "One exact coin",
      "input": {
        "coins": [
          1,
          3,
          4
        ],
        "amount": 4
      }
    },
    {
      "name": "Unreachable odd target",
      "input": {
        "coins": [
          4,
          6
        ],
        "amount": 5
      }
    },
    {
      "name": "Zero amount",
      "input": {
        "coins": [
          3
        ],
        "amount": 0
      }
    },
    {
      "name": "Largest amount grid",
      "input": {
        "coins": [
          1,
          2,
          3,
          4,
          5,
          6
        ],
        "amount": 20
      }
    }
  ],
  "checks": [
    {
      "input": {
        "coins": [
          1,
          3,
          4
        ],
        "amount": 6
      },
      "expect": {
        "cells": [
          [
            0,
            1,
            2,
            1,
            1,
            2,
            2
          ],
          [
            0,
            1,
            1,
            3,
            4,
            1,
            3
          ]
        ],
        "vars": {
          "minimum": 2
        },
        "lists": {
          "payment": [
            3,
            3
          ]
        }
      }
    },
    {
      "input": {
        "coins": [
          4,
          6
        ],
        "amount": 5
      },
      "expect": {
        "vars": {
          "minimum": -1
        },
        "lists": {
          "payment": []
        }
      }
    },
    {
      "input": {
        "coins": [
          3
        ],
        "amount": 0
      },
      "expect": {
        "cells": [
          [
            0
          ],
          [
            0
          ]
        ],
        "vars": {
          "minimum": 0
        },
        "lists": {
          "payment": []
        }
      }
    }
  ],
  "complexity": {
    "time": "O(kA)",
    "space": "O(A)"
  },
  "codeExample": "ex-1"
}
