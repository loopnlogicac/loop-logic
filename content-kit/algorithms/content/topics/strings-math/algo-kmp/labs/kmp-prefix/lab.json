{
  "id": "kmp-prefix",
  "kind": "array",
  "title": {
    "en": "Build prefix links for KMP",
    "bn": "KMP-এর prefix লিংক বানাও"
  },
  "summary": {
    "en": "Build each prefix length and follow shorter borders whenever the next pattern character fails."
  },
  "pseudocode": [
    "pi[0] = 0",
    "for i = 1 to m - 1:",
    "    j = pi[i - 1]",
    "    while j > 0 and pattern[i] != pattern[j]:",
    "        j = pi[j - 1]",
    "    if pattern[i] == pattern[j]: j++",
    "    pi[i] = j"
  ],
  "inputs": [
    {
      "name": "pattern",
      "label": "Pattern",
      "type": "string",
      "maxLength": 16,
      "alphabet": "abc"
    }
  ],
  "presets": [
    {
      "name": "Several fallback links",
      "input": {
        "pattern": "ababaca"
      }
    },
    {
      "name": "One repeated letter",
      "input": {
        "pattern": "aaaaaa"
      }
    },
    {
      "name": "No nonempty borders",
      "input": {
        "pattern": "abc"
      }
    },
    {
      "name": "Single character",
      "input": {
        "pattern": "a"
      }
    }
  ],
  "checks": [
    {
      "input": {
        "pattern": "ababaca"
      },
      "expect": {
        "array": [
          0,
          0,
          1,
          2,
          3,
          0,
          1
        ]
      }
    },
    {
      "input": {
        "pattern": "a"
      },
      "expect": {
        "array": [
          0
        ]
      }
    },
    {
      "input": {
        "pattern": "aaaa"
      },
      "expect": {
        "array": [
          0,
          1,
          2,
          3
        ]
      }
    },
    {
      "input": {
        "pattern": "ababc"
      },
      "expect": {
        "array": [
          0,
          0,
          1,
          2,
          0
        ]
      }
    },
    {
      "input": {
        "pattern": ""
      },
      "expect": {
        "array": []
      }
    }
  ],
  "complexity": {
    "time": "O(m), counting total increases and decreases of j",
    "space": "O(m) prefix table"
  },
  "codeExample": "ex-1",
  "schemaVersion": "1.1"
}
