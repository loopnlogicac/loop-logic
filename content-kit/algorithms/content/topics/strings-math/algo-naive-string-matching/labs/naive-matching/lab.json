{
  "id": "naive-matching",
  "kind": "array",
  "title": {
    "en": "Slide a pattern across text",
    "bn": "টেক্সটের ওপর প্যাটার্ন সরিয়ে মেলাও"
  },
  "summary": {
    "en": "Compare every fitting alignment and keep overlapping match positions in a side list."
  },
  "pseudocode": [
    "count = 0",
    "for start = 0 while start + m <= n:",
    "    j = 0",
    "    while j < m:",
    "        compare text[start + j] with pattern[j]",
    "        if different: break",
    "        j++",
    "    if j == m: report start; count++"
  ],
  "inputs": [
    {
      "name": "text",
      "label": "Text",
      "type": "string",
      "maxLength": 12,
      "alphabet": "abc"
    },
    {
      "name": "pattern",
      "label": "Nonempty pattern",
      "type": "string",
      "maxLength": 6,
      "alphabet": "abc"
    }
  ],
  "presets": [
    {
      "name": "Overlapping aba",
      "input": {
        "text": "ababa",
        "pattern": "aba"
      }
    },
    {
      "name": "Repeated letters",
      "input": {
        "text": "aaaaa",
        "pattern": "aaa"
      }
    },
    {
      "name": "No first-letter match",
      "input": {
        "text": "aaaa",
        "pattern": "b"
      }
    },
    {
      "name": "Pattern is longer",
      "input": {
        "text": "ab",
        "pattern": "abc"
      }
    }
  ],
  "checks": [
    {
      "input": {
        "text": "ababa",
        "pattern": "aba"
      },
      "expect": {
        "lists": {
          "matches": [
            0,
            2
          ]
        },
        "vars": {
          "count": 2,
          "comparisons": 7
        }
      }
    },
    {
      "input": {
        "text": "a",
        "pattern": "a"
      },
      "expect": {
        "lists": {
          "matches": [
            0
          ]
        },
        "vars": {
          "count": 1,
          "comparisons": 1
        }
      }
    },
    {
      "input": {
        "text": "ab",
        "pattern": "abc"
      },
      "expect": {
        "lists": {
          "matches": []
        },
        "vars": {
          "count": 0,
          "comparisons": 0
        }
      }
    },
    {
      "input": {
        "text": "aaaaa",
        "pattern": "aaa"
      },
      "expect": {
        "lists": {
          "matches": [
            0,
            1,
            2
          ]
        },
        "vars": {
          "count": 3,
          "comparisons": 9
        }
      }
    },
    {
      "input": {
        "text": "a",
        "pattern": "b"
      },
      "expect": {
        "lists": {
          "matches": []
        },
        "vars": {
          "count": 0,
          "comparisons": 1
        }
      }
    },
    {
      "input": {
        "text": "",
        "pattern": ""
      },
      "expect": {
        "lists": {
          "matches": [
            0
          ]
        },
        "vars": {
          "count": 1,
          "comparisons": 0
        }
      }
    }
  ],
  "complexity": {
    "time": "O((n-m+1)m) when 1 ≤ m ≤ n",
    "space": "O(1) search state, plus the displayed matches"
  },
  "codeExample": "ex-1",
  "schemaVersion": "1.1"
}
