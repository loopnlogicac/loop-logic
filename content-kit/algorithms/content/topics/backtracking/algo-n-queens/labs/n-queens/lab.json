{
  "id": "n-queens",
  "kind": "grid",
  "title": {
    "en": "Place queens and undo choices",
    "bn": "কুইন বসাও, ফিরে এসে সরাও"
  },
  "summary": {
    "en": "Try each square row by row, reject attacks, count every board, then display the first solution."
  },
  "pseudocode": [
    "search(row):",
    "    if row == n: count++; save first board; return",
    "    for c = 0 to n - 1:",
    "        if safe(row, c):",
    "            col[row] = c",
    "            search(row + 1)",
    "            col[row] = -1"
  ],
  "inputs": [
    {
      "name": "n",
      "label": "Board size",
      "type": "int",
      "min": 1,
      "max": 5
    }
  ],
  "presets": [
    {
      "name": "Two four-queen boards",
      "input": {
        "n": 4
      }
    },
    {
      "name": "One square",
      "input": {
        "n": 1
      }
    },
    {
      "name": "No solution on three rows",
      "input": {
        "n": 3
      }
    },
    {
      "name": "Ten five-queen boards",
      "input": {
        "n": 5
      }
    }
  ],
  "checks": [
    {
      "input": {
        "n": 1
      },
      "expect": {
        "vars": {
          "count": 1
        },
        "cells": [
          [
            "Q"
          ]
        ]
      }
    },
    {
      "input": {
        "n": 2
      },
      "expect": {
        "vars": {
          "count": 0
        },
        "cells": [
          [
            ".",
            "."
          ],
          [
            ".",
            "."
          ]
        ]
      }
    },
    {
      "input": {
        "n": 3
      },
      "expect": {
        "vars": {
          "count": 0
        },
        "cells": [
          [
            ".",
