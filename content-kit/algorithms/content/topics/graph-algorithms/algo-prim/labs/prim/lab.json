{
  "schemaVersion": "1.1",
  "id": "prim",
  "kind": "graph",
  "title": {
    "en": "Prim",
    "bn": "Prim দিয়ে মিনিমাম স্প্যানিং ট্রি"
  },
  "summary": {
    "en": "Grow the start component with minimum boundary edges and compare joining keys with total tree weight."
  },
  "pseudocode": [
    "key[*] = INF; used[*] = false; key[start] = 0; push (0,start)",
    "while priority queue is nonempty: pop minimum (value,u,parent)",
    "    if used[u] or value != key[u]: discard stale entry",
    "    add u and its parent edge to the tree; total += value",
    "    for each neighbour v outside the tree with weight w",
    "        if w < key[v]: key[v] = w; push (w,v,u)",
    "report total and vertex count; fewer than V means disconnected"
  ],
  "inputs": [
    {
      "name": "graph",
      "label": "Graph: 0 shared, 1 variant, 2 F, 3 empty",
      "type": "int",
      "min": 0,
      "max": 3
    },
    {
      "name": "start",
      "label": "Start vertex: A=0 through F=5",
      "type": "int",
      "min": 0,
      "max": 5
    }
  ],
  "presets": [
    {
      "name": "Shared graph from A",
      "input": {
        "graph": 0,
        "start": 0
      }
    },
    {
      "name": "Unit-weight chain",
      "input": {
        "graph": 1,
        "start": 0
      }
    },
    {
      "name": "F in a separate component",
      "input": {
        "graph": 2,
        "start": 0
      }
    },
    {
      "name": "No edges",
      "input": {
        "graph": 3,
        "start": 0
      }
    },
    {
      "name": "Start at isolated F",
      "input": {
        "graph": 2,
        "start": 5
      }
    }
  ],
  "checks": [
    {
      "input": {
        "graph": 0,
        "start": 0
      },
      "expect": {
        "vars": {
          "total": 13,
          "count": 6,
          "connected": 1
        }
      }
    },
    {
      "input": {
        "graph": 1,
        "start": 0
      },
      "expect": {
        "vars": {
          "total": 5,
          "count": 6,
          "connected": 1
        }
      }
    },
    {
      "input": {
        "graph": 3,
        "start": 0
      },
      "expect": {
        "vars": {
          "total": 0,
          "count": 1,
          "connected": 0
        }
      }
    }
  ],
  "complexity": {
    "time": "O((V+E) log(V+E)) with a heap; the small panel sorts entries",
    "space": "O(V+E) including graph and visual queue entries"
  },
  "codeExample": "ex-1"
}
