{
  "schemaVersion": "1.1",
  "id": "bellman-ford",
  "kind": "graph",
  "title": {
    "en": "Shortest paths with Bellman–Ford",
    "bn": "Bellman–Ford দিয়ে শর্টেস্ট পাথ"
  },
  "summary": {
    "en": "Scan directed edges repeatedly, then distinguish finite, unreachable and negative-cycle-affected distances."
  },
  "pseudocode": [
    "dist[*] = INF; dist[start] = 0",
    "for pass = 1 to V-1: changed = false",
    "    scan every edge u -> v in its listed order",
    "        if u is reachable and dist[u]+w < dist[v]: relax; changed = true",
    "    if not changed: stop early",
    "mark destinations of any still-relaxable reachable edges as affected",
    "propagate affected forward along outgoing edges",
    "report -INF for affected vertices, INF for unreachable ones"
  ],
  "inputs": [
    {
      "name": "graph",
      "label": "Graph: 0 shared, 1 variant, 2 F, 3 empty",
      "type": "int",
      "min": 0,
      "max": 3
    },
    {
      "name": "start",
      "label": "Start vertex: A=0 through F=5",
      "type": "int",
      "min": 0,
      "max": 5
    }
  ],
  "presets": [
    {
      "name": "Negative edge without cycle",
      "input": {
        "graph": 0,
        "start": 0
      }
    },
    {
      "name": "Reachable negative cycle",
      "input": {
        "graph": 1,
        "start": 0
      }
    },
    {
      "name": "F in a separate component",
      "input": {
        "graph": 2,
        "start": 0
      }
    },
    {
      "name": "No edges",
      "input": {
        "graph": 3,
        "start": 0
      }
    },
    {
      "name": "Start at isolated F",
      "input": {
        "graph": 2,
        "start": 5
      }
    }
  ],
  "checks": [
    {
      "input": {
        "graph": 0,
        "start": 0
      },
      "expect": {
        "lists": {
          "dist": [
            "0",
            "4",
            "1",
            "9",
            "9",
            "12"
          ]
        },
        "vars": {
          "negativeCycle": 0
        }
      }
    },
    {
      "input": {
        "graph": 1,
        "start": 0
      },
      "expect": {
        "lists": {
          "dist": [
            "0",
            "-INF",
            "-INF",
            "-INF",
            "-INF",
            "-INF"
          ]
        },
        "vars": {
          "negativeCycle": 1
        }
      }
    },
    {
      "input": {
        "graph": 3,
        "start": 0
      },
      "expect": {
        "vars": {
          "negativeCycle": 0
        },
        "lists": {
          "dist": [
            "0",
            "INF",
            "INF",
            "INF",
            "INF",
            "INF"
          ]
        }
      }
    }
  ],
  "complexity": {
    "time": "O(VE) relaxation and affected propagation",
    "space": "O(V+E) including graph and visual queue entries"
  },
  "codeExample": "ex-1"
}
