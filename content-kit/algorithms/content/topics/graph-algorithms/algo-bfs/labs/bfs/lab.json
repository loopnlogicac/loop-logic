{
  "schemaVersion": "1.1",
  "id": "bfs",
  "kind": "graph",
  "title": {
    "en": "Bfs",
    "bn": "ব্রেডথ-ফার্স্ট সার্চ"
  },
  "summary": {
    "en": "Watch FIFO discovery establish edge-count distances and one parent per reached vertex."
  },
  "pseudocode": [
    "dist[*] = -1; parent[*] = -1; dist[start] = 0; enqueue start",
    "while queue has vertices: u = dequeue; append u to order",
    "    for each neighbour v of u, in ascending order",
    "        if dist[v] == -1: dist[v] = dist[u] + 1; parent[v] = u",
    "            enqueue v",
    "report distances and parents; unreachable distances stay -1"
  ],
  "inputs": [
    {
      "name": "graph",
      "label": "Graph: 0 shared, 1 variant, 2 F, 3 empty",
      "type": "int",
      "min": 0,
      "max": 3
    },
    {
      "name": "start",
      "label": "Start vertex: A=0 through F=5",
      "type": "int",
      "min": 0,
      "max": 5
    }
  ],
  "presets": [
    {
      "name": "Shared graph from A",
      "input": {
        "graph": 0,
        "start": 0
      }
    },
    {
      "name": "Unit-weight chain",
      "input": {
        "graph": 1,
        "start": 0
      }
    },
    {
      "name": "F in a separate component",
      "input": {
        "graph": 2,
        "start": 0
      }
    },
    {
      "name": "No edges",
      "input": {
        "graph": 3,
        "start": 0
      }
    },
    {
      "name": "Start at isolated F",
      "input": {
        "graph": 2,
        "start": 5
      }
    }
  ],
  "checks": [
    {
      "input": {
        "graph": 0,
        "start": 0
      },
      "expect": {
        "lists": {
          "dist": [
            0,
            1,
            1,
            2,
            2,
            3
          ],
          "parents": [
            -1,
            0,
            0,
            1,
            2,
            3
          ]
        }
      }
    },
    {
      "input": {
        "graph": 1,
        "start": 0
      },
      "expect": {
        "lists": {
          "dist": [
            0,
            1,
            2,
            3,
            4,
            5
          ]
        }
      }
    },
    {
      "input": {
        "graph": 3,
        "start": 0
      },
      "expect": {
        "lists": {
          "dist": [
            0,
            -1,
            -1,
            -1,
            -1,
            -1
          ]
        }
      }
    }
  ],
  "complexity": {
    "time": "O(V+E) traversal; graph construction excluded",
    "space": "O(V+E) including graph and visual queue entries"
  },
  "codeExample": "ex-1"
}
