{
  "schemaVersion": "1.1",
  "id": "dfs",
  "kind": "graph",
  "title": {
    "en": "Depth-first search",
    "bn": "ডেপথ-ফার্স্ট সার্চ"
  },
  "summary": {
    "en": "Follow the recursive call stack, entry/exit times and full undirected component forest."
  },
  "pseudocode": [
    "discover[*] = 0; clock = 0; components = 0",
    "for roots in cyclic order beginning at start",
    "    if root is white: dfs(root, components); components++",
    "dfs(u,c): discover[u] = ++clock; comp[u] = c; push u",
    "    for each neighbour v in ascending order",
    "        if v is white: dfs(v,c); otherwise inspect its colour",
    "    finish[u] = ++clock; pop u",
    "report discovery/finish times and components"
  ],
  "inputs": [
    {
      "name": "graph",
      "label": "Graph: 0 shared, 1 variant, 2 F, 3 empty",
      "type": "int",
      "min": 0,
      "max": 3
    },
    {
      "name": "start",
      "label": "Start vertex: A=0 through F=5",
      "type": "int",
      "min": 0,
      "max": 5
    }
  ],
  "presets": [
    {
      "name": "Shared graph from A",
      "input": {
        "graph": 0,
        "start": 0
      }
    },
    {
      "name": "Unit-weight chain",
      "input": {
        "graph": 1,
        "start": 0
      }
    },
    {
      "name": "F in a separate component",
      "input": {
        "graph": 2,
        "start": 0
      }
    },
    {
      "name": "No edges",
      "input": {
        "graph": 3,
        "start": 0
      }
    },
    {
      "name": "Start at isolated F",
      "input": {
        "graph": 2,
        "start": 5
      }
    }
  ],
  "checks": [
    {
      "input": {
        "graph": 0,
        "start": 0
      },
      "expect": {
        "labels": {
          "0": "1/12",
          "1": "2/11",
          "2": "3/10",
          "3": "5/8",
          "4": "4/9",
          "5": "6/7"
        },
        "vars": {
          "components": 1
        }
      }
    },
    {
      "input": {
        "graph": 1,
        "start": 0
      },
      "expect": {
        "vars": {
          "components": 1
        }
      }
    },
    {
      "input": {
        "graph": 3,
        "start": 0
      },
      "expect": {
        "vars": {
          "components": 6
        },
        "labels": {
          "0": "1/2",
          "5": "11/12"
        }
      }
    }
  ],
  "complexity": {
    "time": "O(V+E) traversal; graph construction excluded",
    "space": "O(V+E) including graph and visual queue entries"
  },
  "codeExample": "ex-1"
}
