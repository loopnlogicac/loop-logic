{
  "schemaVersion": "1.1",
  "id": "bipartite-check",
  "kind": "graph",
  "title": {
    "en": "Two-colour a graph with BFS",
    "bn": "BFS দিয়ে দুই রঙে গ্রাফ রাঙানো"
  },
  "summary": {
    "en": "Assign opposite BFS colours in every component and expose equal-colour edges that prove an odd cycle."
  },
  "pseudocode": [
    "colour[*] = -1; parent[*] = -1; bipartite = true; cycle = false",
    "for roots in cyclic order from start: if uncoloured, colour 0; enqueue",
    "    while queue is nonempty: u = dequeue",
    "        for each neighbour v",
    "            if uncoloured: colour[v] = 1-colour[u]; parent[v] = u; enqueue",
    "            else: if v != parent[u], cycle = true",
    "                  if colour[v] == colour[u], bipartite = false",
    "report colours, bipartite and cycle flags"
  ],
  "inputs": [
    {
      "name": "graph",
      "label": "Graph: 0 shared, 1 variant, 2 F, 3 empty",
      "type": "int",
      "min": 0,
      "max": 3
    },
    {
      "name": "start",
      "label": "Start vertex: A=0 through F=5",
      "type": "int",
      "min": 0,
      "max": 5
    }
  ],
  "presets": [
    {
      "name": "Shared graph from A",
      "input": {
        "graph": 0,
        "start": 0
      }
    },
    {
      "name": "Unit-weight chain",
      "input": {
        "graph": 1,
        "start": 0
      }
    },
    {
      "name": "F in a separate component",
      "input": {
        "graph": 2,
        "start": 0
      }
    },
    {
      "name": "No edges",
      "input": {
        "graph": 3,
        "start": 0
      }
    },
    {
      "name": "Start at isolated F",
      "input": {
        "graph": 2,
        "start": 5
      }
    }
  ],
  "checks": [
    {
      "input": {
        "graph": 0,
        "start": 0
      },
      "expect": {
        "vars": {
          "bipartite": 0,
          "cycle": 1
        }
      }
    },
    {
      "input": {
        "graph": 1,
        "start": 0
      },
      "expect": {
        "vars": {
          "bipartite": 1,
          "cycle": 0
        }
      }
    },
    {
      "input": {
        "graph": 3,
        "start": 0
      },
      "expect": {
        "vars": {
          "bipartite": 1,
          "cycle": 0
        }
      }
    }
  ],
  "complexity": {
    "time": "O(V+E) traversal; graph construction excluded",
    "space": "O(V+E) including graph and visual queue entries"
  },
  "codeExample": "ex-1"
}
