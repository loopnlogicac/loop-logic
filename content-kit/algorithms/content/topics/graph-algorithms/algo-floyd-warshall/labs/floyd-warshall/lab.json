{
  "schemaVersion": "1.1",
  "id": "floyd-warshall",
  "kind": "grid",
  "title": {
    "en": "Floyd-Warshall distance matrix",
    "bn": "Floyd–Warshall দিয়ে দূরত্বের টেবিল"
  },
  "summary": {
    "en": "Allow one intermediate vertex at a time and recover a route from the completed distance matrix."
  },
  "pseudocode": [
    "initialise dist[i][i]=0; absent arcs=INF; next[i][j]=j for arcs",
    "for k = 0 to V-1",
    "    for i = 0 to V-1, for j = 0 to V-1",
    "        if both subpaths exist and dist[i][k]+dist[k][j] < dist[i][j]",
    "            dist[i][j] = dist[i][k]+dist[k][j]; next[i][j]=next[i][k]",
    "report matrix; follow next[current][F] to recover a route"
  ],
  "inputs": [
    {
      "name": "graph",
      "label": "Graph: 0 shared, 1 variant, 2 F, 3 empty",
      "type": "int",
      "min": 0,
      "max": 3
    },
    {
      "name": "start",
      "label": "Path source (A=0 to F=5)",
      "type": "int",
      "min": 0,
      "max": 5
    }
  ],
  "presets": [
    {
      "name": "Shared directed graph",
      "input": {
        "graph": 0,
        "start": 0
      }
    },
    {
      "name": "Positive directed cycle",
      "input": {
        "graph": 1,
        "start": 0
      }
    },
    {
      "name": "Unreachable F",
      "input": {
        "graph": 2,
        "start": 0
      }
    },
    {
      "name": "No edges",
      "input": {
        "graph": 3,
        "start": 5
      }
    }
  ],
  "checks": [
    {
      "input": {
        "graph": 0,
        "start": 0
      },
      "expect": {
        "cells": [
          [
            0,
            4,
            2,
            9,
            10,
            13
          ],
          [
            "INF",
            0,
            1,
            5,
            7,
            10
          ],
          [
            "INF",
            "INF",
            0,
            "INF",
            8,
            11
          ],
          [
            "INF",
            "INF",
            "INF",
            0,
            2,
            5
          ],
          [
            "INF",
            "INF",
            "INF",
            "INF",
            0,
            3
          ],
          [
            "INF",
            "INF",
            "INF",
            "INF",
            "INF",
            0
          ]
        ],
        "lists": {
          "path": [
            "A",
            "C",
            "E",
            "F"
          ]
        }
      }
    },
    {
      "input": {
        "graph": 2,
        "start": 0
      },
      "expect": {
        "lists": {
          "path": []
        }
      }
    },
    {
      "input": {
        "graph": 3,
        "start": 5
      },
      "expect": {
        "cells": [
          [
            0,
            "INF",
            "INF",
            "INF",
            "INF",
            "INF"
          ],
          [
            "INF",
            0,
            "INF",
            "INF",
            "INF",
            "INF"
          ],
          [
            "INF",
            "INF",
            0,
            "INF",
