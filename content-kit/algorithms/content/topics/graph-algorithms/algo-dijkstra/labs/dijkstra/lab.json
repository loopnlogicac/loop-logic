{
  "schemaVersion": "1.1",
  "id": "dijkstra",
  "kind": "graph",
  "title": {
    "en": "Dijkstra",
    "bn": "Dijkstra দিয়ে শর্টেস্ট পাথ"
  },
  "summary": {
    "en": "Compare tentative route costs, keep a minimum-priority queue and discard stale entries."
  },
  "pseudocode": [
    "dist[*] = INF; parent[*] = -1; dist[start] = 0; push (0,start)",
    "while priority queue is not empty: pop minimum (value,u)",
    "    if value != dist[u]: discard stale entry",
    "    for each neighbour v of u with weight w",
    "        if dist[u] + w < dist[v]: update dist[v] and parent[v]",
    "            push (dist[v],v)",
    "report distances; follow parents backward to recover paths"
  ],
  "inputs": [
    {
      "name": "graph",
      "label": "Graph: 0 shared, 1 variant, 2 F, 3 empty",
      "type": "int",
      "min": 0,
      "max": 3
    },
    {
      "name": "start",
      "label": "Start vertex: A=0 through F=5",
      "type": "int",
      "min": 0,
      "max": 5
    }
  ],
  "presets": [
    {
      "name": "Shared graph from A",
      "input": {
        "graph": 0,
        "start": 0
      }
    },
    {
      "name": "Unit-weight chain",
      "input": {
        "graph": 1,
        "start": 0
      }
    },
    {
      "name": "F in a separate component",
      "input": {
        "graph": 2,
        "start": 0
      }
    },
    {
      "name": "No edges",
      "input": {
        "graph": 3,
        "start": 0
      }
    },
    {
      "name": "Start at isolated F",
      "input": {
        "graph": 2,
        "start": 5
      }
    }
  ],
  "checks": [
    {
      "input": {
        "graph": 0,
        "start": 0
      },
      "expect": {
        "lists": {
          "dist": [
            0,
            3,
            2,
            8,
            10,
            13
          ]
        }
      }
    },
    {
      "input": {
        "graph": 1,
        "start": 0
      },
      "expect": {
        "lists": {
          "dist": [
            0,
            1,
            2,
            3,
            4,
            5
          ]
        }
      }
    },
    {
      "input": {
        "graph": 3,
        "start": 0
      },
      "expect": {
        "lists": {
          "dist": [
            0,
            -1,
            -1,
            -1,
            -1,
            -1
          ]
        }
      }
    }
  ],
  "complexity": {
    "time": "O((V+E) log(V+E)) with a heap; the small panel sorts entries",
    "space": "O(V+E) including graph and visual queue entries"
  },
  "codeExample": "ex-1"
}
