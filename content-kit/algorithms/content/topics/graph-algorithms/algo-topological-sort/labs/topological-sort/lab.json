{
  "schemaVersion": "1.1",
  "id": "topological-sort",
  "kind": "graph",
  "title": {
    "en": "Topological Sort",
    "bn": "টপোলজিক্যাল সর্ট"
  },
  "summary": {
    "en": "Remove ready tasks, reduce incoming counts and detect when a directed cycle blocks completion."
  },
  "pseudocode": [
    "count incoming arcs into indegree[*]",
    "enqueue all zero-indegree vertices in ascending order",
    "while queue is nonempty: u = dequeue; append u to order",
    "    for each outgoing arc u -> v",
    "        decrement indegree[v]; enqueue v when it becomes zero",
    "if order has fewer than V vertices: report cycle",
    "otherwise report order"
  ],
  "inputs": [
    {
      "name": "graph",
      "label": "Graph: 0 shared, 1 variant, 2 F, 3 empty",
      "type": "int",
      "min": 0,
      "max": 3
    }
  ],
  "presets": [
    {
      "name": "Shared graph",
      "input": {
        "graph": 0
      }
    },
    {
      "name": "Directed six-cycle",
      "input": {
        "graph": 1
      }
    },
    {
      "name": "F in a separate component",
      "input": {
        "graph": 2
      }
    },
    {
      "name": "No edges",
      "input": {
        "graph": 3
      }
    }
  ],
  "checks": [
    {
      "input": {
        "graph": 0
      },
      "expect": {
        "lists": {
          "order": [
            "A",
            "B",
            "C",
            "D",
            "E",
            "F"
          ]
        },
        "vars": {
          "cycle": 0
        }
      }
    },
    {
      "input": {
        "graph": 1
      },
      "expect": {
        "vars": {
          "cycle": 1,
          "count": 0
        }
      }
    },
    {
      "input": {
        "graph": 3
      },
      "expect": {
        "vars": {
          "cycle": 0,
          "count": 6
        }
      }
    }
  ],
  "complexity": {
    "time": "O(V+E) traversal; graph construction excluded",
    "space": "O(V+E) including graph and visual queue entries"
  },
  "codeExample": "ex-1"
}
