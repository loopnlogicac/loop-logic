{
  "schemaVersion": "1.1",
  "id": "activity-selection",
  "kind": "array",
  "title": {
    "en": "Choose activities by earliest finish",
    "bn": "অ্যাক্টিভিটি সিলেকশন"
  },
  "summary": {
    "en": "Scan meetings in finish order and keep a meeting only when it starts after the last chosen finish."
  },
  "pseudocode": [
    "sort activities by (finish, id)",
    "count = 0",
    "for each activity in finish order",
    "    if count = 0 or start >= last",
    "        select id; last = finish; count++",
    "return selected IDs"
  ],
  "inputs": [
    {
      "name": "schedule",
      "label": "Meeting set",
      "type": "int",
      "min": 0,
      "max": 3
    }
  ],
  "presets": [
    {
      "name": "Club meetings",
      "input": {
        "schedule": 0
      }
    },
    {
      "name": "Back-to-back",
      "input": {
        "schedule": 1
      }
    },
    {
      "name": "All overlap",
      "input": {
        "schedule": 2
      }
    },
    {
      "name": "No meetings",
      "input": {
        "schedule": 3
      }
    }
  ],
  "checks": [
    {
      "input": {
        "schedule": 0
      },
      "expect": {
        "lists": {
          "selected": [
            0,
            3,
            4
          ]
        },
        "vars": {
          "count": 3
        }
      }
    },
    {
      "input": {
        "schedule": 1
      },
      "expect": {
        "lists": {
          "selected": [
            0,
            1,
            2
          ]
        },
        "vars": {
          "count": 3
        }
      }
    },
    {
      "input": {
        "schedule": 2
      },
      "expect": {
        "lists": {
          "selected": [
            0
          ]
        },
        "vars": {
          "count": 1
        }
      }
    },
    {
      "input": {
        "schedule": 3
      },
      "expect": {
        "lists": {
          "selected": []
        },
        "vars": {
          "count": 0
        }
      }
    }
  ],
  "complexity": {
    "time": "O(n log n) sorting, Θ(n) scan",
    "space": "O(n) displayed records"
  },
  "codeExample": "ex-1"
}
