{
  "schemaVersion": "1.1",
  "id": "huffman-tree",
  "kind": "tree",
  "title": {
    "en": "Build a Huffman tree",
    "bn": "দুই least-frequency tree মেলিয়ে code বানাও"
  },
  "summary": {
    "en": "Repeatedly remove the two lightest trees from a min-heap and join them under their summed frequency.",
    "bn": "Min-heap থেকে ছোট দুই subtree তুলে frequency-যোগের parent-এ জোড়ো।"
  },
  "pseudocode": [
    "create a leaf for each positive frequency; push its ID",
    "while heap size > 1",
    "    left = pop minimum; right = pop minimum",
    "    create parent with weight[left] + weight[right]",
    "    attach left and right; push parent",
    "root = final minimum; assign 0 left and 1 right",
    "return codes and weighted bit count"
  ],
  "inputs": [
    {
      "name": "frequencies",
      "label": "Symbol frequencies",
      "type": "int-array",
      "minLength": 1,
      "maxLength": 8,
      "min": 1,
      "max": 99
    }
  ],
  "presets": [
    {
      "name": "Six-symbol message",
      "input": {
        "frequencies": [
          5,
          9,
          12,
          13,
          16,
          45
        ]
      }
    },
    {
      "name": "Equal frequencies",
      "input": {
        "frequencies": [
          1,
          1,
          1,
          1
        ]
      }
    },
    {
      "name": "One heavy symbol",
      "input": {
        "frequencies": [
          1,
          1,
          1,
          50
        ]
      }
    },
    {
      "name": "Single symbol",
      "input": {
        "frequencies": [
          7
        ]
      }
    },
    {
      "name": "Eight-symbol skew",
      "input": {
        "frequencies": [
          1,
          1,
          2,
          3,
          5,
          8,
          13,
          99
        ]
      }
    }
  ],
  "checks": [
    {
      "input": {
        "frequencies": [
          5,
          9,
          12,
          13,
          16,
          45
        ]
      },
      "expect": {
        "size": 11,
        "root": "10",
        "vars": {
          "bits": 224
        }
      }
    },
    {
      "input": {
        "frequencies": [
          1,
          1,
          1,
          1
        ]
      },
      "expect": {
        "size": 7,
        "root": "6",
        "vars": {
          "bits": 8
        }
      }
    },
    {
      "input": {
        "frequencies": [
          7
        ]
      },
      "expect": {
        "size": 1,
        "root": "0",
        "vars": {
          "bits": 7
        }
      }
    }
  ],
  "complexity": {
    "time": "O(n log n)",
    "space": "O(n)"
  },
  "codeExample": "ex-1"
}
