{
  "schemaVersion": "1.1",
  "id": "linear-search",
  "kind": "array",
  "title": {
    "en": "Scan for a target from left to right",
    "bn": "লিনিয়ার সার্চ"
  },
  "summary": {
    "en": "Follow linear search decisions on a small array and watch the candidate positions change."
  },
  "pseudocode": [
    "for i = 0 to n - 1",
    "    if a[i] == target: return i",
    "return -1"
  ],
  "codeExample": "ex-1",
  "inputs": [
    {
      "name": "values",
      "label": "Values",
      "type": "int-array",
      "minLength": 0,
      "maxLength": 12,
      "min": -99,
      "max": 99
    },
    {
      "name": "target",
      "label": "Target",
      "type": "int",
      "min": -99,
      "max": 99
    }
  ],
  "presets": [
    {
      "name": "Five marks with a tie",
      "input": {
        "values": [
          7,
          3,
          5,
          3,
          1
        ],
        "target": 5
      }
    },
    {
      "name": "Already ascending",
      "input": {
        "values": [
          1,
          2,
          3,
          4,
          5
        ],
        "target": 5
      }
    },
    {
      "name": "Reverse order",
      "input": {
        "values": [
          5,
          4,
          3,
          2,
          1
        ],
        "target": 5
      }
    },
    {
      "name": "One value",
      "input": {
        "values": [
          5
        ],
        "target": 5
      }
    },
    {
      "name": "Empty array",
      "input": {
        "values": [],
        "target": 5
      }
    },
    {
      "name": "Missing target",
      "input": {
        "values": [
          1,
          3,
          3,
          7
        ],
        "target": 5
      }
    },
    {
      "name": "First position hit",
      "input": {
        "values": [
          1,
          3,
          5,
          7,
          9
        ],
        "target": 1
      }
    }
  ],
  "checks": [
    {
      "input": {
        "values": [
          7,
          3,
          5,
          3,
          1
        ],
        "target": 5
      },
      "expect": {
        "array": [
          7,
          3,
          5,
          3,
          1
        ],
        "vars": {
          "result": 2
        }
      }
    },
    {
      "input": {
        "values": [],
        "target": 5
      },
      "expect": {
        "array": [],
        "vars": {
          "result": -1
        }
      }
    },
    {
      "input": {
        "values": [
          5
        ],
        "target": 5
      },
      "expect": {
        "array": [
          5
        ],
        "vars": {
          "result": 0
        }
      }
    },
    {
      "input": {
        "values": [
          3,
          3,
          -1,
          3
        ],
        "target": 5
      },
      "expect": {
        "array": [
          3,
          3,
          -1,
          3
        ],
        "vars": {
          "result": -1
        }
      }
    },
    {
      "input": {
        "values": [
          1,
          2,
          3
        ],
        "target": 9
      },
      "expect": {
        "array": [
          1,
          2,
          3
        ],
        "vars": {
          "result": -1
        }
      }
    }
  ],
  "complexity": {
    "time": "O(n) worst; O(1) best",
    "space": "O(1)"
  }
}
