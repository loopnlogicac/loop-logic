{
  "schemaVersion": "1.1",
  "id": "binary-search",
  "kind": "array",
  "title": {
    "en": "Find a target by halving the range",
    "bn": "বাইনারি সার্চ"
  },
  "summary": {
    "en": "Follow binary search decisions on a small array and watch the candidate positions change."
  },
  "pseudocode": [
    "a = ascending copy of values (setup, before search)",
    "low = 0; high = n",
    "while low < high",
    "    mid = low + floor((high - low) / 2)",
    "    if a[mid] == target: return mid",
    "    if a[mid] < target: low = mid + 1",
    "    else: high = mid",
    "return -1"
  ],
  "codeExample": "ex-1",
  "inputs": [
    {
      "name": "values",
      "label": "Values (ascending copy displayed)",
      "type": "int-array",
      "minLength": 0,
      "maxLength": 12,
      "min": -99,
      "max": 99
    },
    {
      "name": "target",
      "label": "Target",
      "type": "int",
      "min": -99,
      "max": 99
    }
  ],
  "presets": [
    {
      "name": "Five marks with a tie",
      "input": {
        "values": [
          7,
          3,
          5,
          3,
          1
        ],
        "target": 5
      }
    },
    {
      "name": "Already ascending",
      "input": {
        "values": [
          1,
          2,
          3,
          4,
          5
        ],
        "target": 5
      }
    },
    {
      "name": "Reverse order",
      "input": {
        "values": [
          5,
          4,
          3,
          2,
          1
        ],
        "target": 5
      }
    },
    {
      "name": "One value",
      "input": {
        "values": [
          5
        ],
        "target": 5
      }
    },
    {
      "name": "Empty array",
      "input": {
        "values": [],
        "target": 5
      }
    },
    {
      "name": "Missing target",
      "input": {
        "values": [
          1,
          3,
          3,
          7
        ],
        "target": 5
      }
    },
    {
      "name": "Midpoint hit",
      "input": {
        "values": [
          1,
          3,
          5,
          7,
          9
        ],
        "target": 5
      }
    }
  ],
  "checks": [
    {
      "input": {
        "values": [
          7,
          3,
          5,
          3,
          1
        ],
        "target": 5
      },
      "expect": {
        "array": [
          1,
          3,
          3,
          5,
          7
        ],
        "vars": {
          "result": 3
        }
      }
    },
    {
      "input": {
        "values": [],
        "target": 5
      },
      "expect": {
        "array": [],
        "vars": {
          "result": -1
        }
      }
    },
    {
      "input": {
        "values": [
          5
        ],
        "target": 5
      },
      "expect": {
        "array": [
          5
        ],
        "vars": {
          "result": 0
        }
      }
    },
    {
      "input": {
        "values": [
          3,
          3,
          -1,
          3
        ],
        "target": 5
      },
      "expect": {
        "array": [
          -1,
          3,
          3,
          3
        ],
        "vars": {
          "result": -1
        }
      }
    },
    {
      "input": {
        "values": [
          1,
          2,
          3
        ],
        "target": 9
      },
      "expect": {
        "array": [
          1,
          2,
          3
        ],
        "vars": {
          "result": -1
        }
      }
    }
  ],
  "complexity": {
    "time": "O(log n) search; display sorting is separate",
    "space": "O(1) iterative search; O(n) displayed copy"
  }
}
