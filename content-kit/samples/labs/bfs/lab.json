{
  "schemaVersion": "1.1",
  "id": "bfs",
  "kind": "graph",
  "title": { "en": "Breadth-first search", "bn": "ব্রেডথ-ফার্স্ট সার্চ" },
  "summary": { "en": "Explore a graph level by level with a queue and see the shortest number of edges to every vertex." },
  "pseudocode": [
    "dist[s] = 0; mark s visited; enqueue s",
    "while queue is not empty",
    "    u = dequeue",
    "    for each neighbour v of u",
    "        if v is not visited",
    "            mark v visited; dist[v] = dist[u] + 1",
    "            enqueue v"
  ],
  "inputs": [
    { "name": "start", "label": "Start vertex (0–7)", "type": "int", "min": 0, "max": 7 }
  ],
  "presets": [
    { "name": "Start at A", "input": { "start": 0 } },
    { "name": "Start at E", "input": { "start": 4 } }
  ],
  "checks": [
    { "input": { "start": 0 }, "expect": { "lists": { "order": ["A", "B", "C", "D", "E", "F", "G", "H"] }, "labels": { "0": "0", "5": "3", "7": "4" } } },
    { "input": { "start": 7 }, "expect": { "lists": { "order": ["H", "F", "G", "D", "E", "B", "C", "A"], "queue": [] } } },
    { "input": { "start": 4 }, "expect": { "labels": { "4": "0", "0": "2", "7": "2" } } }
  ],
  "complexity": { "time": "O(V + E)", "space": "O(V)" },
  "codeExample": "ex-2"
}
