{
  "schemaVersion": "1.1",
  "id": "kmeans",
  "kind": "ml",
  "title": { "en": "k-Means: assign, move, repeat", "bn": "k-মিনস: ভাগ করো, সরাও, আবার করো" },
  "summary": { "en": "Watch points join their nearest centre and the centres move to the middle of their group, round after round, until nothing changes." },
  "pseudocode": [
    "put k centres on the first k points",
    "repeat:",
    "    give each point to its nearest centre",
    "    move each centre to the mean of its points",
    "until no point changes its centre"
  ],
  "inputs": [
    { "name": "points", "label": "Customers (click to add)", "type": "points", "minLength": 2, "maxLength": 40, "classes": 0, "xRange": [0, 10], "yRange": [0, 10] },
    { "name": "k", "label": "k (number of groups)", "type": "int", "min": 2, "max": 4 }
  ],
  "presets": [
    { "name": "Three shopper groups", "input": { "k": 3, "points": [
      { "x": 1, "y": 1 }, { "x": 5, "y": 8 }, { "x": 9, "y": 2 }, { "x": 1.5, "y": 2 }, { "x": 2, "y": 1.2 }, { "x": 2.5, "y": 2.5 },
      { "x": 5.5, "y": 7.5 }, { "x": 4.5, "y": 8.5 }, { "x": 6, "y": 9 }, { "x": 8.5, "y": 1.5 }, { "x": 9.5, "y": 3 }, { "x": 8, "y": 2.5 } ] } },
    { "name": "A bad start, k = 2", "input": { "k": 2, "points": [
      { "x": 1, "y": 1 }, { "x": 1.5, "y": 1.5 }, { "x": 2, "y": 1 }, { "x": 8, "y": 8 }, { "x": 8.5, "y": 9 }, { "x": 9, "y": 8 } ] } },
    { "name": "No clear groups", "input": { "k": 3, "points": [
      { "x": 2, "y": 2 }, { "x": 5, "y": 5 }, { "x": 8, "y": 8 }, { "x": 2, "y": 8 }, { "x": 8, "y": 2 }, { "x": 5, "y": 2 }, { "x": 2, "y": 5 }, { "x": 8, "y": 5 }, { "x": 5, "y": 8 } ] } }
  ],
  "checks": [
    { "input": { "k": 2, "points": [ { "x": 1, "y": 1 }, { "x": 1.5, "y": 1.5 }, { "x": 2, "y": 1 }, { "x": 8, "y": 8 }, { "x": 8.5, "y": 9 }, { "x": 9, "y": 8 } ] },
      "expect": { "lists": { "group sizes": ["Group 1: 3", "Group 2: 3"] }, "plot": { "points": { "p1": { "cls": 0 }, "p6": { "cls": 1 } } } } },
    { "input": { "k": 3, "points": [ { "x": 1, "y": 1 }, { "x": 5, "y": 8 }, { "x": 9, "y": 2 }, { "x": 1.5, "y": 2 }, { "x": 2, "y": 1.2 }, { "x": 2.5, "y": 2.5 }, { "x": 5.5, "y": 7.5 }, { "x": 4.5, "y": 8.5 }, { "x": 6, "y": 9 }, { "x": 8.5, "y": 1.5 }, { "x": 9.5, "y": 3 }, { "x": 8, "y": 2.5 } ] },
      "expect": { "lists": { "group sizes": ["Group 1: 4", "Group 2: 4", "Group 3: 4"] }, "vars": { "changed": 0 } } },
    { "input": { "k": 4, "points": [ { "x": 3, "y": 3 }, { "x": 7, "y": 7 } ] },
      "expect": { "vars": { "k": 2, "inertia": 0 } } }
  ],
  "complexity": { "time": "O(rounds × n × k)", "space": "O(n + k)" }
}
