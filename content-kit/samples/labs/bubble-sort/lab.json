{
  "schemaVersion": "1.1",
  "id": "bubble-sort",
  "kind": "array",
  "title": { "en": "Bubble sort", "bn": "বাবল সর্ট" },
  "summary": { "en": "Watch neighbouring values swap until the largest values bubble to the end." },
  "pseudocode": [
    "for pass = 0 to n - 2",
    "    swapped = false",
    "    for j = 0 to n - 2 - pass",
    "        if a[j] > a[j + 1]",
    "            swap a[j] and a[j + 1]",
    "            swapped = true",
    "    a[n - 1 - pass] is now in place",
    "    if not swapped: stop early"
  ],
  "inputs": [
    { "name": "values", "label": "Numbers to sort", "type": "int-array", "minLength": 1, "maxLength": 12, "min": -99, "max": 99 }
  ],
  "presets": [
    { "name": "Marks of 6 students", "input": { "values": [72, 85, 64, 91, 58, 77] } },
    { "name": "Already sorted", "input": { "values": [10, 20, 30, 40, 50] } },
    { "name": "Reverse order", "input": { "values": [9, 7, 5, 3, 1] } }
  ],
  "checks": [
    { "input": { "values": [72, 85, 64, 91, 58, 77] }, "expect": { "array": [58, 64, 72, 77, 85, 91] } },
    { "input": { "values": [5] }, "expect": { "array": [5] } },
    { "input": { "values": [3, 3, -1, 3] }, "expect": { "array": [-1, 3, 3, 3] } },
    { "input": { "values": [10, 20, 30] }, "expect": { "array": [10, 20, 30], "vars": { "swaps": 0 } } }
  ],
  "complexity": { "time": "O(n²) worst and average, O(n) best with early stop", "space": "O(1)" },
  "codeExample": "ex-1"
}
