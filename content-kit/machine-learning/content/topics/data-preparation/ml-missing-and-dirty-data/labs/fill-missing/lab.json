{
  "schemaVersion": "1.1",
  "id": "fill-missing",
  "kind": "ml",
  "title": {
    "en": "Fill the gaps",
    "bn": "ফাঁকা ঘর পূরণ করো"
  },
  "summary": {
    "en": "Fit observed-column means or medians and fill three fixed blanks; editable points supply the other cells."
  },
  "pseudocode": [
    "read training cells; fixed blanks are unknown, never zero",
    "collect observed values in each feature column",
    "fit the selected mean or median on observed values",
    "copy observed cells; replace only blank cells",
    "apply these fitted statistics to future rows"
  ],
  "inputs": [
    {
      "name": "strategy",
      "label": "Fill statistic",
      "type": "choice",
      "options": [
        "median",
        "mean"
      ]
    },
    {
      "name": "points",
      "label": "Training points (click to edit)",
      "type": "points",
      "minLength": 6,
      "maxLength": 12,
      "classes": 0,
      "xRange": [
        0,
        40
      ],
      "yRange": [
        0,
        40
      ]
    }
  ],
  "presets": [
    {
      "name": "Six training rows, median",
      "input": {
        "strategy": "median",
        "points": [
          {
            "x": 2,
            "y": 1
          },
          {
            "x": 4,
            "y": 2
          },
          {
            "x": 0,
            "y": 3
          },
          {
            "x": 6,
            "y": 0
          },
          {
            "x": 8,
            "y": 5
          },
          {
            "x": 0,
            "y": 6
          }
        ]
      }
    },
    {
      "name": "One large observation, mean",
      "input": {
        "strategy": "mean",
        "points": [
          {
            "x": 2,
            "y": 1
          },
          {
            "x": 4,
            "y": 2
          },
          {
            "x": 0,
            "y": 3
          },
          {
            "x": 6,
            "y": 0
          },
          {
            "x": 40,
            "y": 5
          },
          {
            "x": 0,
            "y": 6
          }
        ]
      }
    },
    {
      "name": "Repeated measurements",
      "input": {
        "strategy": "median",
        "points": [
          {
            "x": 2,
            "y": 1
          },
          {
            "x": 2,
            "y": 1
          },
          {
            "x": 2,
            "y": 1
          },
          {
            "x": 2,
            "y": 1
          },
          {
            "x": 2,
            "y": 1
          },
          {
            "x": 2,
            "y": 1
          }
        ]
      }
    }
  ],
