{
  "schemaVersion": "1.1",
  "id": "one-hot",
  "kind": "ml",
  "title": {
    "en": "One-hot encoding step by step",
    "bn": "ডিস্ট্রিক্ট থেকে ০/১ কলাম"
  },
  "summary": {
    "en": "Watch Badda, Mirpur and Uttara become fixed indicator columns; unseen codes either give zeros or a reported error."
  },
  "pseudocode": [
    "use the fixed training vocabulary B, M, U",
    "read the next district code",
    "compare it with each training category",
    "write 1 for a match, otherwise 0",
    "handle unseen codes by the chosen policy"
  ],
  "inputs": [
    {
      "name": "policy",
      "label": "Unknown district policy",
      "type": "choice",
      "options": [
        "ignore",
        "error"
      ]
    },
    {
      "name": "districts",
      "label": "District codes B, M, U; ? is unseen",
      "type": "string",
      "maxLength": 12,
      "alphabet": "BMU?"
    }
  ],
  "presets": [
    {
      "name": "Six known districts",
      "input": {
        "policy": "ignore",
        "districts": "BMUBMU"
      }
    },
    {
      "name": "Two unseen names, ignore",
      "input": {
        "policy": "ignore",
        "districts": "B?M?UU"
      }
    },
    {
      "name": "Reject an unseen district",
      "input": {
        "policy": "error",
        "districts": "?BMUBM"
      }
    }
  ],
  "checks": [
    {
      "input": {
        "policy": "ignore",
        "districts": "BMUBMU"
      },
      "expect": {
        "vars": {
          "rows": 6,
          "ones": 6,
          "unknown": 0,
          "errors": 0
        }
      }
    },
    {
      "input": {
        "policy": "ignore",
        "districts": "B?M?UU"
      },
      "expect": {
        "vars": {
          "rows": 6,
          "ones": 4,
          "unknown": 2,
          "errors": 0
        }
      }
    },
    {
      "input": {
        "policy": "error",
        "districts": "?BMUBM"
      },
      "expect": {
        "vars": {
          "rows": 6,
          "ones": 5,
          "unknown": 1,
          "errors": 1
        }
      }
    }
  ],
  "complexity": {
    "time": "O(n*k), k=3",
    "space": "O(n)"
  },
  "codeExample": "ex-1"
}
