{
  "schemaVersion": "1.1",
  "id": "stratified-split",
  "kind": "ml",
  "title": {
    "en": "Random vs stratified split",
    "bn": "র‍্যান্ডম আর stratified split"
  },
  "summary": {
    "en": "Compare class shares for two seeded 70/30 splits; the selected split colours points as training or test. Quotas use largest remainders."
  },
  "pseudocode": [
    "shuffle indices with the seeded Fisher-Yates algorithm",
    "take round(0.3*n) indices for the random test set",
    "compute class quotas and allocate largest remainders",
    "shuffle each class with the same seeded generator",
    "take the allocated test indices from each class",
    "compare class-1 shares; colour the selected partition"
  ],
  "inputs": [
    {
      "name": "method",
      "label": "Display partition",
      "type": "choice",
      "options": [
        "stratified",
        "random"
      ]
    },
    {
      "name": "seed",
      "label": "Shuffle seed",
      "type": "int",
      "min": 0,
      "max": 100
    },
    {
      "name": "points",
      "label": "Training points (click to edit)",
      "type": "points",
      "minLength": 10,
      "maxLength": 30,
      "classes": 2,
      "xRange": [
        0,
        30
      ],
      "yRange": [
        0,
        10
      ]
    }
  ],
