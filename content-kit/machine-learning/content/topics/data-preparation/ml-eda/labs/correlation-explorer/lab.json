{
  "schemaVersion": "1.1",
  "id": "correlation-explorer",
  "kind": "ml",
  "title": {
    "en": "What correlation looks like",
    "bn": "করিলেশনের ছবি দেখো"
  },
  "summary": {
    "en": "Six centred points have an adjustable, exactly constructed Pearson correlation, a least-squares line and visible residuals."
  },
  "pseudocode": [
    "centre x and an orthogonal noise vector",
    "give each vector unit population standard deviation",
    "y = r*x + sqrt(1-r*r)*noise",
    "accumulate xx, yy and xy from the six points",
    "fit slope = xy/xx and intercept = mean(y)-slope*mean(x)",
    "compute Pearson r, or report undefined for zero spread"
  ],
  "inputs": [
    {
      "name": "r",
      "label": "Target correlation",
      "type": "number",
      "min": -1,
      "max": 1,
      "step": 0.1
    }
  ],
  "presets": [
    {
      "name": "Positive association, r=0.6",
      "input": {
        "r": 0.6
      }
    },
    {
      "name": "Perfect falling line",
      "input": {
        "r": -1
      }
    },
    {
      "name": "Zero linear association",
      "input": {
        "r": 0
      }
    }
  ],
  "checks": [
    {
      "input": {
        "r": 0.6
      },
      "expect": {
        "vars": {
          "r": 0.6,
          "slope": 0.6,
          "intercept": 0
        }
      }
    },
    {
      "input": {
        "r": -1
      },
      "expect": {
        "vars": {
          "r": -1,
          "slope": -1,
          "intercept": 0
        }
      }
    },
    {
      "input": {
        "r": 0
      },
      "expect": {
        "vars": {
          "r": 0,
          "slope": 0,
          "intercept": 0
        }
      }
    }
  ],
  "complexity": {
    "time": "O(n), n=6",
    "space": "O(n)"
  },
  "codeExample": "ex-1"
}
