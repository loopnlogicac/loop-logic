{
  "schemaVersion": "1.1",
  "id": "feature-scaling",
  "kind": "ml",
  "title": {
    "en": "Squash and stretch the axes",
    "bn": "স্কেল বদলালে কাছের পয়েন্ট বদলায়"
  },
  "summary": {
    "en": "Compare actual raw and transformed distances in two uniformly resized views; constant columns use divisor 1."
  },
  "pseudocode": [
    "fit offsets and divisors on the training points only",
    "measure raw distances from the query",
    "transform each point and the query with the fitted values",
    "measure transformed distances from the transformed query",
    "link the earliest nearest point in each coordinate system"
  ],
  "inputs": [
    {
      "name": "method",
      "label": "Scaling method",
      "type": "choice",
      "options": [
        "min-max",
        "standard"
      ]
    },
    {
      "name": "points",
      "label": "Training points (click to edit)",
      "type": "points",
      "minLength": 2,
      "maxLength": 20,
      "classes": 0,
      "xRange": [
        0,
        10
      ],
      "yRange": [
        0,
        1000
      ]
    },
    {
      "name": "qx",
      "label": "Query x",
      "type": "number",
      "min": 0,
      "max": 10,
      "step": 0.5
    },
    {
      "name": "qy",
      "label": "Query y",
      "type": "number",
      "min": 0,
      "max": 1000,
      "step": 10
    }
  ],
  "presets": [
    {
      "name": "Min-max changes the neighbour",
      "input": {
        "method": "min-max",
        "points": [
          {
            "x": 1,
            "y": 100
          },
          {
            "x": 2,
            "y": 900
          },
          {
            "x": 3,
            "y": 300
          },
          {
            "x": 3,
            "y": 680
          },
          {
            "x": 5,
            "y": 500
          },
          {
            "x": 6,
            "y": 600
          }
        ],
        "qx": 3,
        "qy": 800
      }
    },
    {
      "name": "Population standardisation",
      "input": {
        "method": "standard",
        "points": [
          {
            "x": 1,
            "y": 100
          },
          {
            "x": 2,
            "y": 900
          },
          {
            "x": 3,
            "y": 300
          },
          {
            "x": 3,
            "y": 680
          },
          {
            "x": 5,
            "y": 500
          },
          {
            "x": 6,
            "y": 600
          }
        ],
        "qx": 3,
        "qy": 800
      }
    },
    {
      "name": "Constant columns and ties",
      "input": {
        "method": "min-max",
        "points": [
          {
            "x": 2,
            "y": 400
          },
          {
            "x": 2,
            "y": 400
          }
        ],
        "qx": 2,
        "qy": 400
      }
    }
  ],
  "checks": [
    {
      "input": {
        "method": "min-max",
        "points": [
          {
            "x": 1,
            "y": 100
          },
          {
            "x": 2,
            "y": 900
          },
          {
            "x": 3,
            "y": 300
          },
          {
            "x": 3,
            "y": 680
          },
          {
            "x": 5,
            "y": 500
          },
          {
            "x": 6,
            "y": 600
          }
        ],
        "qx": 3,
        "qy": 800
      },
      "expect": {
        "vars": {
          "rawNearest": 2,
          "scaledNearest": 4,
          "firstX": 0,
          "firstY": 0
        }
      }
    },
    {
      "input": {
        "method": "min-max",
        "points": [
          {
            "x": 2,
            "y": 400
          },
          {
            "x": 2,
            "y": 400
          }
        ],
        "qx": 2,
        "qy": 400
      },
      "expect": {
        "vars": {
          "rawNearest": 1,
          "scaledNearest": 1,
          "firstX": 0,
          "firstY": 0
        }
      }
    },
    {
      "input": {
        "method": "standard",
        "points": [
          {
            "x": 2,
            "y": 400
          },
          {
            "x": 2,
            "y": 400
          }
        ],
        "qx": 2,
        "qy": 400
      },
      "expect": {
        "vars": {
          "rawNearest": 1,
          "scaledNearest": 1,
          "firstX": 0,
          "firstY": 0
        }
      }
    }
  ],
  "complexity": {
    "time": "O(n)",
    "space": "O(n)"
  },
  "codeExample": "ex-1"
}
