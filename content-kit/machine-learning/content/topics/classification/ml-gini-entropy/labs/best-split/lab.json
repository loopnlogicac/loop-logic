{
  "schemaVersion": "1.1",
  "id": "best-split",
  "kind": "ml",
  "title": {
    "en": "Testing every threshold for the best split",
    "bn": "সব threshold পরীক্ষা করে সেরা split বাছা"
  },
  "summary": {
    "en": "Exhaustively try every two-feature midpoint on at most ten cards, displaying child impurities, sample-size weights and gains for Gini or entropy.",
    "bn": "সর্বোচ্চ দশটি কার্ডে দুই ফিচারের সব midpoint পরীক্ষা করো; Gini বা entropy-তে child impurity, weight ও gain দেখো।"
  },
  "codeExample": "ex-1",
  "pseudocode": [
    "measure parent impurity",
    "try each distinct-value midpoint",
    "partition into nonempty left and right groups",
    "measure the two child impurities",
    "compute size-weighted impurity and gain",
    "retain the best positive gain with stated ties",
    "draw the chosen question or keep a leaf",
    "return feature, threshold and gain"
  ],
  "inputs": [
    {
      "name": "criterion",
      "label": "Impurity criterion",
      "type": "choice",
      "options": [
        "gini",
        "entropy"
      ]
    },
    {
      "name": "points",
      "label": "Labelled fruit scores",
      "type": "points",
      "minLength": 1,
      "maxLength": 10,
      "classes": 2,
      "xRange": [
        0,
        6
      ],
      "yRange": [
        0,
        6
      ]
    }
  ],
  "presets": [
