{
  "schemaVersion": "1.1",
  "id": "decision-tree",
  "kind": "ml",
  "title": {
    "en": "Growing and limiting a recursive decision tree",
    "bn": "Recursive decision ট্রি বানিয়ে বাড়ার সীমা দেওয়া"
  },
  "summary": {
    "en": "Grow deterministic binary two-feature CART on at most 20 cards, requiring positive impurity gain; show each question, path-specific cut and leaf rectangle.",
    "bn": "সর্বোচ্চ ২০টি কার্ডে positive gain দিয়ে binary CART বানাও; প্রতিটি প্রশ্ন, তার কাট ও leaf-এর অঞ্চল দেখো।"
  },
  "codeExample": "ex-1",
  "pseudocode": [
    "choose criterion and stopping limits",
    "create a node and connect its parent",
    "stop at a leaf when a limit or purity requires",
    "try all thresholds and draw the best positive-gain cut",
    "follow the query yes/no branch",
    "read the reached leaf label",
    "count training matches and built nodes",
    "return the query prediction"
  ],
  "inputs": [
    {
      "name": "depth",
      "label": "Maximum depth",
      "type": "int",
      "min": 1,
      "max": 4
    },
    {
      "name": "criterion",
      "label": "Impurity criterion",
      "type": "choice",
      "options": [
        "gini",
        "entropy"
      ]
    },
    {
      "name": "minSplit",
      "label": "Minimum cards to split",
      "type": "int",
      "min": 2,
      "max": 10
    },
    {
      "name": "points",
      "label": "Labelled fruit scores",
      "type": "points",
      "minLength": 1,
      "maxLength": 20,
      "classes": 2,
      "xRange": [
        0,
        6
      ],
      "yRange": [
        0,
        6
      ]
    },
    {
      "name": "qx",
      "label": "Query size score",
      "type": "number",
      "min": 0,
      "max": 6,
      "step": 0.5
    },
    {
      "name": "qy",
      "label": "Query sweetness score",
      "type": "number",
      "min": 0,
      "max": 6,
      "step": 0.5
    }
  ],
  "presets": [
    {
