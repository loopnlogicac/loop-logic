{
  "schemaVersion": "1.1",
  "id": "knn",
  "kind": "ml",
  "title": {
    "en": "Asking nearby fruits to vote",
    "bn": "কাছের ফলের ভোটে নতুন ফল বাছা"
  },
  "summary": {
    "en": "Measure every distance, highlight the selected neighbours and compare class votes; exact-distance ties keep input order and class ties choose zero.",
    "bn": "প্রতিটি দূরত্ব মেপে কাছের ফল বাছো; সমান দূরত্বে ইনপুটের ক্রম, সমান ভোটে শূন্য লেবেল নাও।"
  },
  "codeExample": "ex-1",
  "pseudocode": [
    "limit k to available points",
    "measure every Euclidean distance",
    "sort by distance, then input order",
    "select the first k examples",
    "count uniform class votes",
    "choose the largest vote, ties to label zero",
    "return prediction"
  ],
  "inputs": [
    {
      "name": "k",
      "label": "k neighbours",
      "type": "int",
      "min": 1,
      "max": 9
    },
    {
      "name": "points",
      "label": "Labelled score cards",
      "type": "points",
      "minLength": 1,
      "maxLength": 30,
      "classes": 2,
      "xRange": [
        0,
        6
      ],
      "yRange": [
        0,
        6
      ]
    },
    {
      "name": "qx",
      "label": "Query size score",
      "type": "number",
      "min": 0,
      "max": 6,
      "step": 0.1
    },
    {
      "name": "qy",
      "label": "Query sweetness score",
      "type": "number",
      "min": 0,
      "max": 6,
      "step": 0.1
    }
  ],
  "presets": [
    {
      "name": "Three mango neighbours",
      "input": {
        "k": 3,
        "points": [
          {
            "x": 1,
            "y": 1,
            "cls": 0
          },
          {
            "x": 1,
            "y": 2,
            "cls": 0
          },
          {
            "x": 2,
            "y": 1,
            "cls": 0
          },
          {
            "x": 4,
            "y": 4,
            "cls": 1
          },
          {
            "x": 4,
            "y": 5,
            "cls": 1
          },
          {
            "x": 5,
            "y": 4,
            "cls": 1
          }
        ],
        "qx": 3.3,
        "qy": 3.3
      }
    },
    {
      "name": "Equal class votes",
      "input": {
        "k": 2,
        "points": [
          {
            "x": 1,
            "y": 1,
            "cls": 0
          },
          {
            "x": 1,
            "y": 2,
            "cls": 0
          },
          {
            "x": 2,
            "y": 1,
            "cls": 0
          },
          {
            "x": 4,
            "y": 4,
            "cls": 1
          },
          {
            "x": 4,
            "y": 5,
            "cls": 1
          },
          {
            "x": 5,
            "y": 4,
            "cls": 1
          }
        ],
        "qx": 3,
        "qy": 3
      }
    }
  ],
  "checks": [
    {
      "input": {
        "k": 3,
        "points": [
          {
            "x": 1,
            "y": 1,
            "cls": 0
          },
          {
            "x": 1,
            "y": 2,
            "cls": 0
          },
          {
            "x": 2,
            "y": 1,
            "cls": 0
          },
          {
            "x": 4,
            "y": 4,
            "cls": 1
          },
          {
            "x": 4,
            "y": 5,
            "cls": 1
          },
          {
            "x": 5,
            "y": 4,
            "cls": 1
          }
        ],
        "qx": 3.3,
        "qy": 3.3
      },
      "expect": {
