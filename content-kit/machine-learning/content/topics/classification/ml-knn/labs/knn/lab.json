          "votes0": 0,
          "votes1": 3,
          "k": 3
        }
      }
    },
    {
      "input": {
        "k": 2,
        "points": [
          {
            "x": 1,
            "y": 1,
            "cls": 0
          },
          {
            "x": 1,
            "y": 2,
            "cls": 0
          },
          {
            "x": 2,
