{
  "schemaVersion": "1.1",
  "id": "sigmoid-explorer",
  "kind": "ml",
  "title": {
    "en": "Turning scores into probabilities and labels",
    "bn": "Score থেকে probability ও লেবেল বাছা"
  },
  "summary": {
    "en": "Adjust a fixed linear score and a probability threshold; trace every card through the sigmoid without pretending these supplied coefficients were trained.",
    "bn": "স্থির linear score ও threshold বদলে প্রতিটি কার্ডের probability দেখো; এখানে দেওয়া coefficient train করা হয় না।"
  },
  "codeExample": "ex-1",
  "pseudocode": [
    "convert probability threshold to score cutoff",
    "draw a boundary when weights are nonzero",
    "compute each linear score",
    "map the score through sigmoid",
    "compare probability with the threshold",
    "collect hard labels and positive count",
    "return the fixed-model predictions"
  ],
  "inputs": [
    {
      "name": "threshold",
      "label": "Probability threshold",
      "type": "number",
      "min": 0.05,
      "max": 0.95,
      "step": 0.05
    },
    {
      "name": "w1",
      "label": "Feature-one weight",
      "type": "number",
      "min": -3,
      "max": 3,
      "step": 0.1
    },
    {
      "name": "w2",
      "label": "Feature-two weight",
      "type": "number",
      "min": -3,
      "max": 3,
      "step": 0.1
    },
    {
      "name": "bias",
      "label": "Bias",
      "type": "number",
      "min": -6,
      "max": 6,
      "step": 0.1
    },
    {
      "name": "points",
      "label": "Centred labelled cards",
      "type": "points",
      "minLength": 1,
      "maxLength": 12,
      "classes": 2,
      "xRange": [
        -3,
        3
      ],
      "yRange": [
        -3,
        3
      ]
    }
  ],
  "presets": [
    {
      "name": "Half-probability cutoff",
      "input": {
        "w1": 1,
        "w2": 1,
        "bias": 0,
        "threshold": 0.5,
        "points": [
          {
            "x": -2,
            "y": -1,
            "cls": 0
          },
          {
            "x": -1,
            "y": -2,
            "cls": 0
          },
          {
            "x": -1,
            "y": -1,
            "cls": 0
          },
          {
            "x": 1,
            "y": 1,
            "cls": 1
          },
          {
            "x": 1,
            "y": 2,
            "cls": 1
          },
          {
            "x": 2,
            "y": 1,
            "cls": 1
          }
        ]
      }
    },
    {
      "name": "Require stronger confidence",
      "input": {
        "w1": 1,
        "w2": 1,
        "bias": 0,
        "threshold": 0.95,
        "points": [
          {
            "x": -2,
            "y": -1,
            "cls": 0
          },
          {
            "x": -1,
            "y": -2,
            "cls": 0
          },
          {
            "x": -1,
            "y": -1,
            "cls": 0
          },
          {
            "x": 1,
            "y": 1,
            "cls": 1
          },
          {
            "x": 1,
            "y": 2,
            "cls": 1
          },
          {
            "x": 2,
            "y": 1,
            "cls": 1
          }
        ]
      }
    }
  ],
  "checks": [
