{
  "schemaVersion": "1.1",
  "id": "knn-boundary",
  "kind": "ml",
  "title": {
    "en": "Comparing k through boundaries and validation",
    "bn": "Boundary ও যাচাইয়ের ফল দিয়ে k বাছা"
  },
  "summary": {
    "en": "Predict every region centre with uniform or inverse-distance KNN; compare k=1,3,7,15 using validation cards excluded from all votes.",
    "bn": "Uniform বা distance ভোটে প্রতিটি ঘরের লেবেল predict করো; ভোটের বাইরে রাখা কার্ডে চারটি k যাচাই করো।"
  },
  "codeExample": "ex-1",
  "pseudocode": [
    "try requested neighbour counts",
    "predict all grid-cell centres",
    "predict reserved validation cards",
    "append validation accuracy",
    "select best score, ties to smaller k",
    "show the slider-selected map",
    "keep final test data separate"
  ],
  "inputs": [
    {
      "name": "k",
      "label": "Selected k",
      "type": "int",
      "min": 1,
      "max": 15
    },
    {
      "name": "weights",
      "label": "Vote weighting",
      "type": "choice",
      "options": [
        "uniform",
        "distance"
      ]
    },
    {
      "name": "points",
      "label": "Training cards",
      "type": "points",
      "minLength": 1,
      "maxLength": 30,
      "classes": 2,
      "xRange": [
        0,
        6
      ],
      "yRange": [
        0,
        6
      ]
    },
    {
      "name": "validation",
      "label": "Validation cards (never vote)",
      "type": "points",
      "minLength": 1,
      "maxLength": 15,
      "classes": 2,
      "xRange": [
        0,
        6
      ],
      "yRange": [
        0,
        6
      ]
    }
  ],
  "presets": [
    {
      "name": "Local versus global votes",
      "input": {
        "k": 3,
        "weights": "uniform",
        "points": [
          {
            "x": 1,
            "y": 1,
            "cls": 0
