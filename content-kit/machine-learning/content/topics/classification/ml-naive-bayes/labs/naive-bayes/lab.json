{
  "schemaVersion": "1.1",
  "id": "naive-bayes",
  "kind": "ml",
  "title": {
    "en": "Counting bilingual words and smoothing class evidence",
    "bn": "দ্বিভাষিক শব্দ গুনে ক্লাস-এর প্রমাণে smoothing করা"
  },
  "summary": {
    "en": "A six-message, two-word multinomial model shows raw counts, additive smoothing, priors and joint log scores; other vocabulary is explicitly ignored.",
    "bn": "ছয়টি message ও দুটি word ফিচার-এ count, smoothing, prior ও joint log score দেখো; অন্য শব্দ স্পষ্টভাবে বাদ যায়।"
  },
  "codeExample": "ex-1",
  "pseudocode": [
    "count documents by class",
    "count recognised word occurrences",
    "compute empirical class priors",
    "smooth each vocabulary row",
    "add recognised query log likelihoods",
    "draw both joint log scores",
    "choose the larger score, ties to zero",
    "return the prediction"
  ],
  "inputs": [
    {
      "name": "alpha",
      "label": "Smoothing alpha",
      "type": "number",
      "min": 0.1,
      "max": 2,
      "step": 0.1
    },
    {
      "name": "query",
      "label": "Query message",
      "type": "string",
      "maxLength": 24
    }
  ],
  "presets": [
    {
      "name": "Repeated English evidence",
      "input": {
        "alpha": 1,
        "query": "free free"
      }
    },
    {
      "name": "Bangla class evidence",
      "input": {
        "alpha": 1,
        "query": "ক্লাস"
      }
    },
    {
      "name": "Unknown vocabulary",
      "input": {
        "alpha": 1,
        "query": "unknown"
      }
    }
  ],
  "checks": [
    {
      "input": {
        "alpha": 1,
        "query": "free free"
      },
      "expect": {
        "vars": {
          "prediction": 1,
          "logScore0": -4.277,
          "logScore1": -1.058
        }
      }
    },
    {
      "input": {
        "alpha": 1,
        "query": "ক্লাস"
      },
      "expect": {
        "vars": {
          "prediction": 0,
          "logScore0": -0.875,
          "logScore1": -2.485
        }
      }
    },
    {
      "input": {
        "alpha": 1,
        "query": "unknown"
      },
      "expect": {
        "vars": {
          "prediction": 0,
          "logScore0": -0.693,
          "logScore1": -0.693
        }
      }
    }
  ],
  "complexity": {
    "time": "O(training tokens + query tokens) for the fixed two-feature model",
    "space": "O(classes × vocabulary size)"
  }
}
