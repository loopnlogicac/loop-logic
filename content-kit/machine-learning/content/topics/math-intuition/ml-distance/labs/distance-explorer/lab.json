{
  "schemaVersion": "1.1",
  "id": "distance-explorer",
  "kind": "ml",
  "title": {
    "en": "Straight road or city blocks?",
    "bn": "সোজা পথ আর ব্লকের পথ মাপো"
  },
  "summary": {
    "en": "Compare the straight Euclidean route with horizontal and vertical Manhattan travel."
  },
  "pseudocode": [
    "read endpoints a and b",
    "dx = b.x - a.x; dy = b.y - a.y",
    "draw horizontal then vertical segments",
    "draw the straight segment",
    "euclidean = sqrt(dx*dx + dy*dy)",
    "manhattan = abs(dx) + abs(dy)"
  ],
  "inputs": [
    {
      "name": "points",
      "label": "Points (click to change)",
      "type": "points",
      "minLength": 2,
      "maxLength": 2,
      "classes": 0,
      "xRange": [
        0,
        10
      ],
      "yRange": [
        0,
        10
      ]
    }
  ],
  "presets": [
    {
      "name": "Three across, four up",
      "input": {
        "points": [
          {
            "x": 1,
            "y": 1
          },
          {
            "x": 4,
            "y": 5
          }
        ]
      }
    },
    {
      "name": "Same point",
      "input": {
        "points": [
          {
            "x": 3,
            "y": 3
          },
          {
            "x": 3,
            "y": 3
          }
        ]
      }
    },
    {
      "name": "Down and left",
      "input": {
        "points": [
          {
            "x": 8,
            "y": 7
          },
          {
            "x": 2,
            "y": 3
          }
        ]
      }
    }
  ],
  "checks": [
    {
      "input": {
        "points": [
          {
            "x": 1,
            "y": 1
          },
          {
            "x": 4,
            "y": 5
          }
        ]
      },
      "expect": {
        "vars": {
          "dx": 3,
          "dy": 4,
          "euclidean": 5,
          "manhattan": 7
        }
      }
    },
    {
      "input": {
        "points": [
          {
            "x": 2,
            "y": 2
          },
          {
            "x": 2,
            "y": 2
          }
        ]
      },
      "expect": {
        "vars": {
          "dx": 0,
          "dy": 0,
          "euclidean": 0,
          "manhattan": 0
        }
      }
    },
    {
      "input": {
        "points": [
          {
            "x": 4,
            "y": 5
          },
          {
            "x": 1,
            "y": 1
          }
        ]
      },
      "expect": {
        "vars": {
          "dx": -3,
          "dy": -4,
          "euclidean": 5,
          "manhattan": 7
        }
      }
    }
  ],
  "complexity": {
    "time": "O(1)",
    "space": "O(1)"
  },
  "codeExample": "ex-1"
}
