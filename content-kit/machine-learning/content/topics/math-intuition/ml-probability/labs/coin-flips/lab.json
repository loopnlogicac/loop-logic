{
  "schemaVersion": "1.1",
  "id": "coin-flips",
  "kind": "ml",
  "title": {
    "en": "Watch a running share of heads",
    "bn": "কয়েন ছুড়ে হেডের ভাগ দেখো"
  },
  "summary": {
    "en": "A seeded simulated coin compares the running frequency with its chosen probability; the path need not improve every time."
  },
  "pseudocode": [
    "state = seed",
    "for t from 1 to trials:",
    "    state = (1664525*state + 1013904223) mod 2^32",
    "    u = state / 2^32",
    "    heads += 1 if u < probability else 0",
    "    plot heads/t against the probability"
  ],
  "inputs": [
    {
      "name": "probability",
      "label": "Probability of heads",
      "type": "number",
      "min": 0,
      "max": 1,
      "step": 0.05
    },
    {
      "name": "trials",
      "label": "Number of flips",
      "type": "int",
      "min": 20,
      "max": 500
    },
    {
      "name": "seed",
      "label": "Seed",
      "type": "int",
      "min": 0,
      "max": 999
    }
  ],
  "presets": [
    {
      "name": "One hundred fair flips",
      "input": {
        "probability": 0.5,
        "trials": 100,
        "seed": 7
      }
    },
    {
      "name": "A biased coin",
      "input": {
        "probability": 0.8,
        "trials": 500,
        "seed": 7
      }
    },
    {
      "name": "Heads impossible",
      "input": {
        "probability": 0,
        "trials": 20,
        "seed": 0
      }
    }
  ],
  "checks": [
    {
      "input": {
        "probability": 0.5,
        "trials": 100,
        "seed": 7
      },
      "expect": {
        "vars": {
          "heads": 52,
          "trials": 100,
          "frequency": 0.52
        }
      }
    },
    {
      "input": {
        "probability": 0,
        "trials": 20,
        "seed": 0
      },
      "expect": {
        "vars": {
          "heads": 0,
          "trials": 20,
          "frequency": 0
        }
      }
    },
    {
      "input": {
        "probability": 1,
        "trials": 20,
        "seed": 999
      },
      "expect": {
        "vars": {
          "heads": 20,
          "trials": 20,
          "frequency": 1
        }
      }
    }
  ],
  "complexity": {
    "time": "O(trials)",
    "space": "O(trials / 5)"
  },
  "codeExample": "ex-1"
}
