{
  "schemaVersion": "1.1",
  "id": "bayes-table",
  "kind": "ml",
  "title": {
    "en": "Read Bayes from one thousand people",
    "bn": "হাজার জনের টেবিল থেকে Bayes বুঝি"
  },
  "summary": {
    "en": "Fill expected counts for 1000 people, then restrict attention to positive tests; fractional counts are expected counts."
  },
  "pseudocode": [
    "healthy = 1000 - sick",
    "TP = sick * sensitivity; FN = sick - TP",
    "FP = healthy * falsePositive; TN = healthy - FP",
    "positive = TP + FP",
    "posterior = TP / positive"
  ],
  "inputs": [
    {
      "name": "sick",
      "label": "Ill people per 1000",
      "type": "int",
      "min": 1,
      "max": 500
    },
    {
      "name": "sensitivity",
      "label": "Positive share among ill",
      "type": "number",
      "min": 0.1,
      "max": 1,
      "step": 0.1
    },
    {
      "name": "falsePositive",
      "label": "Positive share among healthy",
      "type": "number",
      "min": 0,
      "max": 0.5,
      "step": 0.05
    }
  ],
  "presets": [
    {
      "name": "Rare illness",
      "input": {
        "sick": 10,
        "sensitivity": 0.9,
        "falsePositive": 0.1
      }
    },
    {
      "name": "More common illness",
      "input": {
        "sick": 200,
        "sensitivity": 0.9,
        "falsePositive": 0.1
      }
    },
    {
      "name": "No false positives",
      "input": {
        "sick": 10,
        "sensitivity": 1,
        "falsePositive": 0
      }
    }
  ],
  "checks": [
    {
      "input": {
        "sick": 10,
        "sensitivity": 0.9,
        "falsePositive": 0.1
      },
      "expect": {
        "vars": {
          "truePositive": 9,
          "falsePositive": 99,
          "positive": 108,
          "posterior": 0.083
        }
      }
    },
    {
      "input": {
        "sick": 200,
        "sensitivity": 0.9,
        "falsePositive": 0.1
      },
      "expect": {
        "vars": {
          "truePositive": 180,
          "falsePositive": 80,
          "positive": 260,
          "posterior": 0.692
        }
      }
    },
    {
      "input": {
        "sick": 1,
        "sensitivity": 1,
        "falsePositive": 0
      },
      "expect": {
        "vars": {
          "truePositive": 1,
          "falsePositive": 0,
          "positive": 1,
          "posterior": 1
        }
      }
    }
  ],
  "complexity": {
    "time": "O(1)",
    "space": "O(1)"
  },
  "codeExample": "ex-1"
}
