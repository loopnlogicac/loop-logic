{
  "schemaVersion": "1.1",
  "id": "vector-play",
  "kind": "ml",
  "title": {
    "en": "Add and stretch arrows",
    "bn": "ভেক্টর যোগ করো, বড় করে দেখো"
  },
  "summary": {
    "en": "Move two arrows head to tail, add their coordinates, then scale the sum."
  },
  "pseudocode": [
    "read arrows a and b",
    "draw a from the origin",
    "move b to the head of a",
    "sum = a + b coordinate by coordinate",
    "scaled = scale * sum"
  ],
  "inputs": [
    {
      "name": "scale",
      "label": "Scale the sum",
      "type": "number",
      "min": -2,
      "max": 3,
      "step": 0.5
    },
    {
      "name": "points",
      "label": "Points (click to change)",
      "type": "points",
      "minLength": 2,
      "maxLength": 2,
      "classes": 0,
      "xRange": [
        0,
        10
      ],
      "yRange": [
        0,
        10
      ]
    }
  ],
  "presets": [
    {
      "name": "Two market walks",
      "input": {
        "scale": 2,
        "points": [
          {
            "x": 2,
            "y": 1
          },
          {
            "x": 1,
            "y": 3
          }
        ]
      }
    },
    {
      "name": "Reverse the sum",
      "input": {
        "scale": -1,
        "points": [
          {
            "x": 3,
            "y": 2
          },
          {
            "x": 1,
            "y": 1
          }
        ]
      }
    },
    {
      "name": "Zero stretch",
      "input": {
        "scale": 0,
        "points": [
          {
            "x": 2,
            "y": 1
          },
          {
            "x": 1,
            "y": 3
          }
        ]
      }
    }
  ],
  "checks": [
    {
      "input": {
        "scale": 2,
        "points": [
          {
            "x": 2,
            "y": 1
          },
          {
            "x": 1,
            "y": 3
          }
        ]
      },
      "expect": {
        "vars": {
          "sumX": 3,
          "sumY": 4,
          "scaledX": 6,
          "scaledY": 8
        }
      }
    },
    {
      "input": {
        "scale": 0,
        "points": [
          {
            "x": 0,
            "y": 0
          },
          {
            "x": 0,
            "y": 0
          }
        ]
      },
      "expect": {
        "vars": {
          "sumX": 0,
          "sumY": 0,
          "scaledX": 0,
          "scaledY": 0
        }
      }
    },
    {
      "input": {
        "scale": -1,
        "points": [
          {
            "x": 2,
            "y": 2
          },
          {
            "x": 2,
            "y": 2
          }
        ]
      },
      "expect": {
        "vars": {
          "sumX": 4,
          "sumY": 4,
          "scaledX": -4,
          "scaledY": -4
        }
      }
    }
  ],
  "complexity": {
    "time": "O(1)",
    "space": "O(1)"
  },
  "codeExample": "ex-1"
}
