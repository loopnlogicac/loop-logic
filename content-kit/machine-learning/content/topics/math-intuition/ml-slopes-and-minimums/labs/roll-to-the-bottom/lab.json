{
  "schemaVersion": "1.1",
  "id": "roll-to-the-bottom",
  "kind": "ml",
  "title": {
    "en": "Walk down a bowl",
    "bn": "ঢাল দেখে নিচের দিকে নামো"
  },
  "summary": {
    "en": "Follow gradient steps on cost (x - 1)^2; learning rates above one diverge and the cost is updated beside each position."
  },
  "pseudocode": [
    "cost(x) = (x - 1)^2; slope(x) = 2*(x - 1)",
    "record the initial position and cost",
    "repeat for the chosen number of steps:",
    "    x = x - lr * slope(x)",
    "    plot new position and cost at the same step"
  ],
  "inputs": [
    {
      "name": "lr",
      "label": "Learning rate",
      "type": "number",
      "min": 0.05,
      "max": 1.25,
      "step": 0.05
    },
    {
      "name": "start",
      "label": "Starting x",
      "type": "number",
      "min": -4,
      "max": 5,
      "step": 0.5
    },
    {
      "name": "iterations",
      "label": "Steps",
      "type": "int",
      "min": 10,
      "max": 30
    }
  ],
  "presets": [
    {
      "name": "Half the gap per step",
      "input": {
        "lr": 0.25,
        "start": 4,
        "iterations": 12
      }
    },
    {
      "name": "Too large: diverging",
      "input": {
        "lr": 1.25,
        "start": 4,
        "iterations": 12
      }
    },
    {
      "name": "At the bottom already",
      "input": {
        "lr": 0.25,
        "start": 1,
        "iterations": 10
      }
    }
  ],
  "checks": [
    {
      "input": {
        "lr": 0.25,
        "start": 4,
        "iterations": 12
      },
      "expect": {
        "vars": {
          "x": 1.001,
          "cost": 0
        }
      }
    },
    {
      "input": {
        "lr": 0.25,
        "start": 1,
        "iterations": 10
      },
      "expect": {
        "vars": {
          "x": 1,
          "cost": 0
        }
      }
    },
    {
      "input": {
        "lr": 1,
        "start": 4,
        "iterations": 10
      },
      "expect": {
        "vars": {
          "x": 4,
          "cost": 9
        }
      }
    }
  ],
  "complexity": {
    "time": "O(iterations + s) for s bowl samples",
    "space": "O(iterations + s)"
  },
  "codeExample": "ex-1"
}
