{
  "schemaVersion": "1.1",
  "id": "mean-and-spread",
  "kind": "ml",
  "title": {
    "en": "Watch the balance point move",
    "bn": "গড় কোথায় সরে দেখো"
  },
  "summary": {
    "en": "Append one adjustable observation; compare mean, median and each squared gap in population variance."
  },
  "pseudocode": [
    "values = other observations plus last observation",
    "mean = sum(values) / count(values)",
    "sort values to find median",
    "for each value: gap = value - mean",
    "variance = sum(gap * gap) / count(values)",
    "std = sqrt(variance)"
  ],
  "inputs": [
    {
      "name": "outlier",
      "label": "Last observation",
      "type": "number",
      "min": 0,
      "max": 30,
      "step": 1
    },
    {
      "name": "values",
      "label": "Other observations",
      "type": "int-array",
      "minLength": 4,
      "maxLength": 10,
      "min": 0,
      "max": 30
    }
  ],
  "presets": [
    {
      "name": "A six beside five marks",
      "input": {
        "outlier": 6,
        "values": [
          2,
          2,
          3,
          3,
          4
        ]
      }
    },
    {
      "name": "One very large mark",
      "input": {
        "outlier": 24,
        "values": [
          2,
          2,
          3,
          3,
          4
        ]
      }
    },
    {
      "name": "All the same",
      "input": {
        "outlier": 3,
        "values": [
          3,
          3,
          3,
          3
        ]
      }
    }
  ],
  "checks": [
    {
      "input": {
        "outlier": 6,
        "values": [
          2,
          2,
          3,
          3,
          4
        ]
      },
      "expect": {
        "vars": {
          "mean": 3.333,
          "median": 3,
          "variance": 1.889,
          "std": 1.374
        }
      }
    },
    {
      "input": {
        "outlier": 3,
        "values": [
          3,
          3,
          3,
          3
        ]
      },
      "expect": {
        "vars": {
          "mean": 3,
          "median": 3,
          "variance": 0,
          "std": 0
        }
      }
    },
    {
      "input": {
        "outlier": 0,
        "values": [
          0,
          0,
          0,
          0
        ]
      },
      "expect": {
        "vars": {
          "mean": 0,
          "median": 0,
          "variance": 0,
          "std": 0
        }
      }
    }
  ],
  "complexity": {
    "time": "O(n)",
    "space": "O(n)"
  },
  "codeExample": "ex-1"
}
