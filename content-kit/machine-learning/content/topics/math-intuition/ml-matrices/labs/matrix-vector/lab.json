{
  "schemaVersion": "1.1",
  "id": "matrix-vector",
  "kind": "ml",
  "title": {
    "en": "One row, one dot product",
    "bn": "প্রতি সারি দিয়ে একটা ডট প্রোডাক্ট"
  },
  "summary": {
    "en": "Treat clicked points as matrix rows, highlight matching row and weight cells, and fill one output at a time."
  },
  "pseudocode": [
    "X = rows of feature pairs; w = two weights",
    "for each row i:",
    "    output[i] = 0",
    "    for each column j: output[i] += X[i,j] * w[j]",
    "sum the output entries"
  ],
  "inputs": [
    {
      "name": "w1",
      "label": "First weight",
      "type": "number",
      "min": -3,
      "max": 3,
      "step": 0.5
    },
    {
      "name": "w2",
      "label": "Second weight",
      "type": "number",
      "min": -3,
      "max": 3,
      "step": 0.5
    },
    {
      "name": "points",
      "label": "Points (click to change)",
      "type": "points",
      "minLength": 1,
      "maxLength": 10,
      "classes": 0,
      "xRange": [
        0,
        10
      ],
      "yRange": [
        0,
        10
      ]
    }
  ],
  "presets": [
    {
      "name": "Five fruit rows",
      "input": {
        "w1": 2,
        "w2": 1,
        "points": [
          {
            "x": 1,
            "y": 2
          },
          {
            "x": 3,
            "y": 1
          },
          {
            "x": 2,
            "y": 4
          },
          {
            "x": 0,
            "y": 2
          },
          {
            "x": 4,
            "y": 0
          }
        ]
      }
    },
    {
      "name": "Ignore second feature",
      "input": {
        "w1": 2,
        "w2": 0,
        "points": [
          {
            "x": 1,
            "y": 2
          },
          {
            "x": 3,
            "y": 1
          },
          {
            "x": 2,
            "y": 4
          },
          {
            "x": 0,
            "y": 2
          },
          {
            "x": 4,
            "y": 0
          }
        ]
      }
    },
    {
      "name": "Negative first weight",
      "input": {
        "w1": -1,
        "w2": 1,
        "points": [
          {
            "x": 1,
            "y": 2
          },
          {
            "x": 3,
            "y": 1
          },
          {
            "x": 2,
            "y": 4
          },
          {
            "x": 0,
            "y": 2
          },
          {
            "x": 4,
            "y": 0
          }
        ]
      }
    }
  ],
  "checks": [
    {
      "input": {
        "w1": 2,
        "w2": 1,
        "points": [
          {
            "x": 1,
            "y": 2
          },
          {
            "x": 3,
            "y": 1
          },
          {
            "x": 2,
            "y": 4
          },
          {
            "x": 0,
            "y": 2
          },
          {
            "x": 4,
            "y": 0
          }
        ]
      },
      "expect": {
        "vars": {
          "rows": 5,
          "cols": 2,
          "total": 29
        }
      }
    },
    {
      "input": {
        "w1": 0,
        "w2": 0,
        "points": [
          {
            "x": 0,
            "y": 0
          }
        ]
      },
      "expect": {
        "vars": {
          "rows": 1,
          "cols": 2,
          "total": 0
        }
      }
    },
    {
      "input": {
        "w1": -1,
        "w2": 2,
        "points": [
          {
            "x": 3,
            "y": 4
          },
          {
            "x": 3,
            "y": 4
          }
        ]
      },
      "expect": {
        "vars": {
          "rows": 2,
          "cols": 2,
          "total": 10
        }
      }
    }
  ],
  "complexity": {
    "time": "O(n)",
    "space": "O(n)"
  },
  "codeExample": "ex-1"
}
