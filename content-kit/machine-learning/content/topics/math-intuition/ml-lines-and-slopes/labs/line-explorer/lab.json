{
  "schemaVersion": "1.1",
  "id": "line-explorer",
  "kind": "ml",
  "title": {
    "en": "Steer a prediction line",
    "bn": "ঢাল বদলে প্রেডিকশন দেখো"
  },
  "summary": {
    "en": "Set slope and intercept, read a query prediction and measure signed vertical residuals."
  },
  "pseudocode": [
    "read slope m, intercept c and query x",
    "draw y = m*x + c",
    "for each observed point: prediction = m*x + c",
    "residual = observed y - prediction",
    "average the squared residuals",
    "predict the query with the same rule"
  ],
  "inputs": [
    {
      "name": "slope",
      "label": "Slope",
      "type": "number",
      "min": -3,
      "max": 3,
      "step": 0.5
    },
    {
      "name": "intercept",
      "label": "Intercept",
      "type": "number",
      "min": -3,
      "max": 6,
      "step": 0.5
    },
    {
      "name": "qx",
      "label": "Prediction x",
      "type": "number",
      "min": 0,
      "max": 10,
      "step": 0.5
    },
    {
      "name": "points",
      "label": "Points (click to change)",
      "type": "points",
      "minLength": 1,
      "maxLength": 10,
      "classes": 0,
      "xRange": [
        0,
        10
      ],
      "yRange": [
        0,
        10
      ]
    }
  ],
  "presets": [
    {
      "name": "Two more for each step",
      "input": {
        "slope": 2,
        "intercept": 1,
        "qx": 6,
        "points": [
          {
            "x": 0,
            "y": 1
          },
          {
            "x": 1,
            "y": 3
          },
          {
            "x": 2,
            "y": 6
          },
          {
            "x": 3,
            "y": 6
          },
          {
            "x": 4,
            "y": 9
          }
        ]
      }
    },
    {
      "name": "A flat line",
      "input": {
        "slope": 0,
        "intercept": 3,
        "qx": 6,
        "points": [
          {
            "x": 0,
            "y": 1
          },
          {
            "x": 1,
            "y": 3
          },
          {
            "x": 2,
            "y": 6
          },
          {
            "x": 3,
            "y": 6
          },
          {
            "x": 4,
            "y": 9
          }
        ]
      }
    },
    {
      "name": "A falling line",
      "input": {
        "slope": -1,
        "intercept": 6,
        "qx": 6,
        "points": [
          {
            "x": 0,
            "y": 1
          },
          {
            "x": 1,
            "y": 3
          },
          {
            "x": 2,
            "y": 6
          },
          {
            "x": 3,
            "y": 6
          },
          {
            "x": 4,
            "y": 9
          }
        ]
      }
    }
  ],
  "checks": [
    {
      "input": {
        "slope": 2,
        "intercept": 1,
        "qx": 6,
        "points": [
          {
            "x": 0,
            "y": 1
          },
          {
            "x": 1,
            "y": 3
          },
          {
            "x": 2,
            "y": 6
          },
          {
            "x": 3,
            "y": 6
          },
          {
            "x": 4,
            "y": 9
          }
        ]
      },
      "expect": {
        "vars": {
          "prediction": 13,
          "mse": 0.4
        }
      }
    },
    {
      "input": {
        "slope": 0,
        "intercept": 0,
        "qx": 0,
        "points": [
          {
            "x": 0,
            "y": 0
          }
        ]
      },
      "expect": {
        "vars": {
          "prediction": 0,
          "mse": 0
        }
      }
    },
    {
      "input": {
        "slope": 1,
        "intercept": 1,
        "qx": 2,
        "points": [
          {
            "x": 1,
            "y": 1
          }
        ]
      },
      "expect": {
        "vars": {
          "prediction": 3,
          "mse": 1
        }
      }
    }
  ],
  "complexity": {
    "time": "O(n)",
    "space": "O(n)"
  },
  "codeExample": "ex-1"
}
