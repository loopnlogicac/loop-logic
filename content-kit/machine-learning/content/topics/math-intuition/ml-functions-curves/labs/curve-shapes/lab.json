{
  "schemaVersion": "1.1",
  "id": "curve-shapes",
  "kind": "ml",
  "title": {
    "en": "Compare five function shapes",
    "bn": "পাঁচ রকম ফাংশনের বাঁক দেখো"
  },
  "summary": {
    "en": "Draw line, square, exponential, logarithm and sigmoid with their values at a chosen positive input."
  },
  "pseudocode": [
    "choose a positive input x",
    "define line, square, exp, log and sigmoid",
    "draw each function on its valid domain",
    "evaluate all five functions at x"
  ],
  "inputs": [
    {
      "name": "x",
      "label": "Inspect positive x",
      "type": "number",
      "min": 0.5,
      "max": 4,
      "step": 0.5
    }
  ],
  "presets": [
    {
      "name": "Inspect x = 2",
      "input": {
        "x": 2
      }
    },
    {
      "name": "Inspect x = 0.5",
      "input": {
        "x": 0.5
      }
    },
    {
      "name": "Inspect x = 4",
      "input": {
        "x": 4
      }
    }
  ],
  "checks": [
    {
      "input": {
        "x": 2
      },
      "expect": {
        "vars": {
          "line": 5,
          "square": 4,
          "exp": 7.389,
          "log": 0.693,
          "sigmoid": 0.881
        }
      }
    },
    {
      "input": {
        "x": 1
      },
      "expect": {
        "vars": {
          "line": 3,
          "square": 1,
          "exp": 2.718,
          "log": 0,
          "sigmoid": 0.731
        }
      }
    },
    {
      "input": {
        "x": 4
      },
      "expect": {
        "vars": {
          "line": 9,
          "square": 16,
          "exp": 54.598,
          "log": 1.386,
          "sigmoid": 0.982
        }
      }
    }
  ],
  "complexity": {
    "time": "O(s) for s plotted samples",
    "space": "O(s)"
  },
  "codeExample": "ex-1"
}
