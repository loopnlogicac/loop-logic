{
  "schemaVersion": "1.1",
  "id": "broadcasting",
  "kind": "ml",
  "title": {
    "en": "Broadcasting: stretch the offsets, then add",
    "bn": "Broadcasting: offset ছড়িয়ে যোগ করি"
  },
  "summary": {
    "en": "Edit a 5×2 matrix, then add either a row or a column of offsets. Each cell shows its source offset before the sum is written.",
    "bn": "৫×২ matrix বদলাও। প্রতিটি ঘরে row বা column-এর কোন offset যোগ হচ্ছে, তারপর যোগফল দেখো।"
  },
  "pseudocode": [
    "choose offsets; result = empty 5x2 matrix; total = 0",
    "for r in 0..4:",
    "    for c in 0..1:",
    "        offset = offsets[c] if mode == \"row\" else offsets[r]",
    "        result[r][c] = X[r][c] + offset",
    "        total = total + result[r][c]",
    "return result, total"
  ],
  "inputs": [
    {
      "name": "offsetA",
      "label": "Row: size offset / আকারের offset",
      "type": "number",
      "min": -20,
      "max": 20,
      "step": 1
    },
    {
      "name": "offsetB",
      "label": "Row: sweet offset / মিষ্টতার offset",
      "type": "number",
      "min": -20,
      "max": 20,
      "step": 1
    },
    {
      "name": "mode",
      "label": "Mode / দিক",
      "type": "choice",
      "options": [
        "row",
        "column"
      ]
    },
    {
      "name": "values",
      "label": "X: ten cells / দশ ঘরের মান",
      "type": "int-array",
      "minLength": 10,
      "maxLength": 10,
      "min": -20,
      "max": 20
    },
    {
      "name": "columnOffsets",
      "label": "Column: five offsets / পাঁচ offset",
      "type": "int-array",
      "minLength": 5,
      "maxLength": 5,
      "min": -20,
      "max": 20
    }
  ],
  "presets": [
    {
      "name": "Row [10,20] / সারির offset",
      "input": {
        "offsetA": 10,
        "offsetB": 20,
        "mode": "row",
