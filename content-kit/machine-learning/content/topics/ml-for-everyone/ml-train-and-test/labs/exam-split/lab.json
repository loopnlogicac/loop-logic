{
  "schemaVersion": "1.1",
  "id": "exam-split",
  "kind": "ml",
  "title": {
    "en": "Hide some examples for the exam",
    "bn": "পরীক্ষার জন্য কিছু উদাহরণ ঢাকো"
  },
  "summary": {
    "en": "Fit three size-only rules on the first cards, hide the last labels, and compare actual training and test mistake counts."
  },
  "pseudocode": [
    "keep the last testCount cards hidden; train on the earlier cards",
    "fit one threshold, nearest-size labels and a majority-only rule",
    "draw the selected rule using training answers only",
    "predict each test card before uncovering its label",
    "count train and test errors separately for all three rules",
    "compare the counts; do not refit using test answers"
  ],
  "inputs": [
    {
      "name": "testCount",
      "label": "Hidden test cards / লুকানো কার্ড",
      "type": "int",
      "min": 2,
      "max": 5
    },
    {
      "name": "model",
      "label": "Rule flexibility / নিয়মের ধরন",
      "type": "choice",
      "options": [
        "simple",
        "flexible",
        "flat"
      ]
    },
    {
      "name": "points",
      "label": "Fruit cards (click) / ফলের কার্ড",
      "type": "points",
      "minLength": 6,
      "maxLength": 20,
      "classes": 2,
      "xRange": [
        0,
        10
      ],
      "yRange": [
        0,
        10
      ]
    }
  ],
