{
  "schemaVersion": "1.1",
  "id": "learn-a-threshold",
  "kind": "ml",
  "title": {
    "en": "Find the best dividing line",
    "bn": "সেরা ভাগের রেখা খোঁজো"
  },
  "summary": {
    "en": "Search half-centimetre fences using size alone, count actual label mistakes, then compare your fence with the best one."
  },
  "pseudocode": [
    "for threshold from 0 to 10 in steps of 0.5:",
    "    predict Apple if size <= threshold, otherwise Mango",
    "    count mistakes against the supplied labels",
    "    keep a lower mistake count; keep the smaller threshold on ties",
    "show the best fence and the student-selected fence"
  ],
  "inputs": [
    {
      "name": "threshold",
      "label": "Your dividing size / নিজের ভাগের মাপ",
      "type": "number",
      "min": 0,
      "max": 10,
      "step": 0.5
    },
    {
      "name": "points",
      "label": "Fruit cards (click) / ফলের কার্ড",
      "type": "points",
      "minLength": 1,
      "maxLength": 20,
      "classes": 2,
      "xRange": [
        0,
        10
      ],
      "yRange": [
        0,
        10
      ]
    }
  ],
  "presets": [
    {
      "name": "Ten cards, fence 5 / দশ কার্ড",
