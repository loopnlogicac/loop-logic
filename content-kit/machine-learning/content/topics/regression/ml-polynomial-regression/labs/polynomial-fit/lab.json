  "id": "polynomial-fit",
  "kind": "ml",
  "title": {
    "en": "Compare straight and wiggly fits",
    "bn": "সোজা আর আঁকাবাঁকা ফিট মেলাও"
  },
  "summary": {
    "en": "Fit degrees 1–12 with reorthogonalised QR; dependent powers are omitted. Fixed noiseless cubic validation points test the teaching rule."
  },
  "pseudocode": [
    "build powers of each training x",
    "solve least squares with reorthogonalised QR",
    "draw the fitted curve",
    "measure training and fixed validation MSE",
    "compare degrees before judging the selected curve"
  ],
