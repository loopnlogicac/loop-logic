    {
      "id": "introduction",
      "title": "The ruler misses the middle of the arch"
    },
    {
      "id": "intuition",
      "title": "A stiff ruler, a useful curve and a loose ribbon"
    },
    {
      "id": "how-it-works",
      "title": "Create powers before learning weights"
    },
    {
      "id": "try-it-yourself",
      "title": "Hide the answer between dots"
    },
    {
      "id": "examples",
      "title": "Compare feature construction and selection"
    },
    {
      "id": "common-mistakes",
      "title": "Do not reward memorisation alone"
    },
    {
      "id": "going-deeper",
      "title": "Optional: capacity, rank and conditioning"
