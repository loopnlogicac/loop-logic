  "examples": [
    {
      "id": "ex-1",
      "title": "Solve polynomial least squares with a design matrix",
      "level": "basic",
      "file": "examples/ex-1.py",
      "output": "examples/ex-1.out",
      "tryNow": true,
      "explanationHtml": "<p>The 15 training values contain a fixed oscillating disturbance. The 30 validation targets follow a known noiseless cubic teaching rule.</p>",
      "requires": [
        "numpy"
      ]
    },
    {
      "id": "ex-2",
      "title": "Use PolynomialFeatures and LinearRegression",
      "level": "basic",
      "file": "examples/ex-2.py",
      "output": "examples/ex-2.out",
      "tryNow": true,
      "explanationHtml": "<p>The pipeline creates powers before fitting weights. include_bias=False avoids duplicating the intercept that LinearRegression already learns.</p>",
      "requires": [
        "numpy",
        "sklearn"
      ]
    },
    {
      "id": "ex-3",
      "title": "Select a curve on invented study records",
      "level": "intermediate",
      "file": "examples/ex-3.py",
      "output": "examples/ex-3.out",
      "tryNow": false,
      "explanationHtml": "<p>Only validation error selects the degree. The winning model is evaluated once on the untouched test partition; it is not selected again using that result.</p>",
      "requires": [
        "pandas",
        "sklearn"
      ],
      "workdirFiles": [
        "shared/datasets/study.csv"
      ]
    }
  ],
  "practice": [
    {
      "id": "p-1",
      "type": "code",
      "difficulty": "medium",
      "title": "Construct powers without an intercept",
      "statementHtml": "<p>Read x degree, with degree 1–12. Print powers x through x to degree on one line, each to three decimals.</p>",
      "hints": [
        "Start powers at one, not zero."
      ],
      "solution": "practice/p-1.py",
      "tests": [
        {
          "stdin": "practice/p-1.t1.in",
          "output": "practice/p-1.t1.out"
        },
        {
          "stdin": "practice/p-1.t2.in",
          "output": "practice/p-1.t2.out"
        }
      ]
    },
    {
      "id": "p-2",
      "type": "code",
      "difficulty": "medium",
      "title": "Select degree with a documented tie rule",
      "statementHtml": "<p>Read n (1–12), then n degree/validation-loss pairs. Losses are nonnegative. Print the degree with smallest loss, breaking ties toward smaller degree.</p>",
      "hints": [
        "Order candidates by loss then degree."
      ],
      "solution": "practice/p-2.py",
      "tests": [
        {
          "stdin": "practice/p-2.t1.in",
          "output": "practice/p-2.t1.out"
        },
        {
          "stdin": "practice/p-2.t2.in",
          "output": "practice/p-2.t2.out"
        }
      ]
    },
    {
      "id": "p-3",
      "type": "written",
      "difficulty": "hard",
      "title": "Explain an overfitting curve",
      "statementHtml": "<p>A degree-twelve fit lowers training MSE from 2 to 0.01 but raises validation MSE from 3 to 9. Which model should remain the candidate?</p>",
      "hints": [
        "Selection uses unfamiliar examples."
      ],
      "answerHtml": "<p>Keep the less flexible model with validation MSE 3 under this comparison. Degree twelve fits training-specific variation and predicts validation worse. Use the final test only after making the choice.</p>"
    },
    {
      "id": "p-4",
      "type": "written",
      "difficulty": "hard",
      "title": "Count one-feature polynomial weights",
      "statementHtml": "<p>How many fitted parameters does degree twelve need with one original feature and an intercept? What if there are only five distinct input values?</p>",
      "hints": [
        "Include the zero power."
      ],
      "answerHtml": "<p>There are thirteen coefficients for powers zero through twelve. Five distinct locations cannot identify all thirteen independently. Multiple coefficient vectors can agree at those locations and differ between them.</p>"
    }
  ],
