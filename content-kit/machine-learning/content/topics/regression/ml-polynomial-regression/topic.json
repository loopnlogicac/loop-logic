    "en": "Curves, Underfitting and Overfitting",
    "bn": "কার্ভে কম শেখা আর বেশি মুখস্থ করা"
  },
  "summary": {
    "en": "Fit degrees 1, 3 and 12 to the same noisy measurements and select complexity using validation error.",
    "bn": "একই ডেটায় degree 1, 3 আর 12 ফিট করে validation-এর ভুল দিয়ে জটিলতা বেছে নাও।"
  },
  "level": "intermediate",
  "estMinutes": 50,
  "prerequisites": [
    "ml-multiple-regression"
  ],
  "related": [],
  "keywords": [
    "Curves, Underfitting and Overfitting",
    "regression",
    "Python",
    "prediction"
  ],
