    {
      "id": "q-11",
      "type": "mcq",
      "difficulty": "easy",
      "prompt": "Which sum belongs in the denominator of the hand slope formula?",
      "options": [
        "Sum of raw target values",
        "Number of test labels only",
        "Sum of squared centred feature values",
        "Sum of signed residuals"
      ],
      "answer": 2,
      "explanation": "Centred x variation identifies the feature direction; dividing by n is unnecessary when both covariance sums use the same factor."
    },
    {
      "id": "q-12",
      "type": "mcq",
      "difficulty": "easy",
      "prompt": "Which numerical routine is preferable for a poorly conditioned design matrix?",
      "options": [
        "Explicitly invert every cross-product matrix",
        "Round all features to integers first",
        "Use test residuals as features",
        "A least-squares solver or pseudoinverse"
      ],
      "answer": 3,
      "explanation": "Stable solvers avoid unnecessarily squaring the condition number through an explicit inverse."
    },
    {
      "id": "q-13",
      "type": "mcq",
      "difficulty": "easy",
      "prompt": "Which rent-report sentence is justified by a synthetic random-row test?",
      "options": [
        "The workflow beats its baseline on this invented split",
        "The estimator is validated for real Dhaka contracts",
        "Every district receives equal error",
        "The estimated coefficients prove causal effects"
      ],
      "answer": 0,
      "explanation": "A result must be limited to the data and evaluation design actually used."
    },
    {
      "id": "q-14",
      "type": "mcq",
      "difficulty": "easy",
      "prompt": "Which regulariser encourages exact sparse solutions?",
      "options": [
        "Ordinary least squares always",
        "Lasso",
        "Ridge always",
        "A test-set mean baseline"
      ],
      "answer": 1,
      "explanation": "L1 penalties can put some coefficients exactly at zero; that selection can still be unstable with correlated features."
    },
    {
      "id": "q-15",
      "type": "mcq",
      "difficulty": "easy",
      "prompt": "Why avoid repeatedly trying degrees against the final test?",
      "options": [
        "The test rows disappear automatically",
        "The polynomial stops having an intercept",
        "The choices adapt to those answers and make the score optimistic",
        "MSE becomes mathematically negative"
      ],
      "answer": 2,
      "explanation": "Reserve a final set for assessment after choices are settled; use validation for tuning."
    }
  ],
  "keyPoints": [
    {
      "en": "Show intermediate sums when fitting by hand.",
      "bn": "হাতে ফিট করার সময় মাঝের যোগফলগুলোও দেখাও।"
    },
