{
  "schemaVersion": "1.1",
  "id": "least-squares",
  "kind": "ml",
  "title": {
    "en": "Fit a line from the gaps",
    "bn": "ফাঁক মেপে সেরা রেখা খোঁজো"
  },
  "summary": {
    "en": "Draw the guessed residuals, accumulate centred products, then compute the exact least-squares line; constant x uses slope zero."
  },
  "pseudocode": [
    "draw the guessed line and each vertical residual",
    "compute x_mean and y_mean",
    "accumulate sxx and sxy from centred coordinates",
    "slope = sxy / sxx, or zero when all x are equal",
    "intercept = y_mean - slope * x_mean",
    "redraw residuals and report the minimum MSE"
  ],
  "inputs": [
    {
      "name": "slope",
      "label": "Guessed slope",
      "type": "number",
      "min": -2,
      "max": 4,
      "step": 0.1
    },
    {
      "name": "intercept",
      "label": "Guessed intercept",
      "type": "number",
      "min": -2,
      "max": 6,
      "step": 0.1
    },
    {
      "name": "points",
      "label": "Observations (click to edit)",
      "type": "points",
      "minLength": 5,
      "maxLength": 20,
      "classes": 0,
      "xRange": [
        0,
        6
      ],
      "yRange": [
        0,
        10
      ]
    }
  ],
  "presets": [
    {
      "name": "Five measurements",
      "input": {
        "points": [
          {
            "x": 1,
            "y": 3
          },
          {
            "x": 2,
            "y": 4
          },
          {
            "x": 3,
            "y": 5
          },
          {
            "x": 4,
            "y": 4
          },
          {
            "x": 5,
            "y": 9
          }
        ],
        "slope": 1,
        "intercept": 1.4
      }
    },
    {
      "name": "An exact line",
      "input": {
        "points": [
          {
            "x": 0,
            "y": 1
          },
          {
            "x": 1,
            "y": 3
          },
          {
            "x": 2,
            "y": 5
          },
          {
            "x": 3,
            "y": 7
          },
          {
            "x": 4,
            "y": 9
          }
        ],
        "slope": 0,
        "intercept": 0
      }
    },
    {
      "name": "No x variation",
      "input": {
        "points": [
          {
            "x": 2,
            "y": 1
          },
          {
            "x": 2,
            "y": 2
          },
          {
            "x": 2,
            "y": 3
          },
          {
            "x": 2,
            "y": 4
          },
          {
            "x": 2,
            "y": 5
          }
        ],
        "slope": 1,
        "intercept": 1.4
      }
    }
  ],
  "checks": [
    {
      "input": {
        "points": [
          {
            "x": 1,
            "y": 3
          },
          {
            "x": 2,
            "y": 4
          },
          {
            "x": 3,
            "y": 5
          },
          {
            "x": 4,
            "y": 4
          },
          {
            "x": 5,
            "y": 9
          }
        ],
        "slope": 1,
        "intercept": 1.4
      },
      "expect": {
        "vars": {
          "slope": 1.2,
          "intercept": 1.4,
          "mse": 1.52
        }
      }
    },
    {
      "input": {
        "points": [
          {
            "x": 0,
            "y": 1
          },
          {
            "x": 1,
            "y": 3
          },
          {
            "x": 2,
            "y": 5
          },
          {
            "x": 3,
            "y": 7
          },
          {
            "x": 4,
            "y": 9
          }
        ],
        "slope": 1,
        "intercept": 1.4
      },
      "expect": {
        "vars": {
          "slope": 2.0,
          "intercept": 1.0,
          "mse": 0.0
        }
      }
    },
    {
      "input": {
        "points": [
          {
            "x": 2,
            "y": 1
          },
          {
            "x": 2,
            "y": 2
          },
          {
            "x": 2,
            "y": 3
          },
          {
            "x": 2,
            "y": 4
          },
          {
            "x": 2,
            "y": 5
          }
        ],
        "slope": 1,
        "intercept": 1.4
      },
      "expect": {
        "vars": {
          "slope": 0.0,
          "intercept": 3.0,
          "mse": 2.0
        }
      }
    }
  ],
  "complexity": {
    "time": "O(n)",
    "space": "O(n) trace"
  },
  "codeExample": "ex-1"
}
