          },
          {
            "x": 0,
            "y": 0
          },
          {
            "x": 0,
            "y": 0
          },
          {
            "x": 0,
            "y": 0
          },
          {
            "x": 0,
            "y": 0
          }
        ],
        "lr": 1,
        "iterations": 10
      },
      "expect": {
        "vars": {
          "slope": 0.0,
          "intercept": 0.0,
          "mse": 0.0
        }
      }
    }
  ],
  "complexity": {
    "time": "O(Tn)",
    "space": "O(T + n)"
  },
  "codeExample": "ex-1"
}
