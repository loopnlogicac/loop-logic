{
  "schemaVersion": "1.1",
  "id": "gradient-descent",
  "kind": "ml",
  "title": {
    "en": "Move a line down the cost bowl",
    "bn": "cost কমাতে রেখা সরাও"
  },
  "summary": {
    "en": "Update slope and intercept simultaneously on editable points; paired line/chart operations show the same iteration. A large rate can diverge."
  },
  "pseudocode": [
    "start slope and intercept at zero",
    "compute both gradients from the current predictions",
    "update slope and intercept simultaneously",
    "draw this iteration line and record its MSE",
    "repeat for the selected number of updates"
  ],
  "inputs": [
    {
      "name": "lr",
      "label": "Learning rate",
      "type": "number",
      "min": 0.01,
      "max": 1,
      "step": 0.01
    },
    {
      "name": "iterations",
      "label": "Number of updates",
      "type": "int",
      "min": 10,
      "max": 60
    },
    {
      "name": "points",
      "label": "Observations (click to edit)",
      "type": "points",
      "minLength": 5,
      "maxLength": 20,
      "classes": 0,
      "xRange": [
        -2,
        2
      ],
      "yRange": [
        -5,
        7
      ]
    }
  ],
  "presets": [
    {
      "name": "Forty stable updates",
      "input": {
        "points": [
          {
            "x": -2,
            "y": -3
          },
          {
            "x": -1,
            "y": -1
          },
          {
            "x": 0,
            "y": 1
          },
          {
            "x": 1,
            "y": 3
          },
          {
            "x": 2,
            "y": 5
          }
        ],
        "lr": 0.1,
        "iterations": 40
      }
    },
    {
      "name": "Slow learning",
      "input": {
        "points": [
          {
            "x": -2,
            "y": -3
          },
          {
            "x": -1,
            "y": -1
          },
          {
            "x": 0,
            "y": 1
          },
          {
            "x": 1,
            "y": 3
          },
          {
            "x": 2,
            "y": 5
          }
        ],
        "lr": 0.01,
        "iterations": 40
      }
    },
    {
      "name": "Oversized steps diverge",
      "input": {
        "points": [
          {
            "x": -2,
            "y": -3
          },
          {
            "x": -1,
            "y": -1
          },
          {
            "x": 0,
            "y": 1
          },
          {
            "x": 1,
            "y": 3
          },
          {
            "x": 2,
            "y": 5
          }
        ],
        "lr": 0.6,
        "iterations": 10
      }
    }
  ],
  "checks": [
    {
      "input": {
        "points": [
          {
            "x": -2,
            "y": -3
          },
          {
            "x": -1,
            "y": -1
          },
          {
            "x": 0,
            "y": 1
          },
          {
            "x": 1,
            "y": 3
          },
          {
            "x": 2,
            "y": 5
          }
        ],
        "lr": 0.1,
        "iterations": 40
      },
      "expect": {
        "vars": {
          "slope": 2.0,
          "intercept": 1.0,
          "mse": 0.0
        }
      }
    },
    {
      "input": {
        "points": [
          {
            "x": -2,
            "y": -3
          },
          {
            "x": -1,
            "y": -1
          },
          {
            "x": 0,
            "y": 1
          },
          {
            "x": 1,
            "y": 3
          },
          {
            "x": 2,
            "y": 5
          }
        ],
        "lr": 0.01,
        "iterations": 40
      },
      "expect": {
        "vars": {
          "slope": 1.609,
          "intercept": 0.554,
          "mse": 0.504
        }
      }
    },
    {
      "input": {
        "points": [
          {
            "x": 0,
