  "examples": [
    {
      "id": "ex-1",
      "title": "Walk down the line-fitting bowl",
      "level": "basic",
      "file": "examples/ex-1.py",
      "output": "examples/ex-1.out",
      "tryNow": true,
      "explanationHtml": "<p>Forty full-batch updates approach slope 2 and intercept 1. Displayed zero error is rounded; finite updates need not reach exact equality.</p>",
      "requires": [
        "numpy"
      ]
    },
    {
      "id": "ex-2",
      "title": "Compare the converged line with LinearRegression",
      "level": "basic",
      "file": "examples/ex-2.py",
      "output": "examples/ex-2.out",
      "tryNow": true,
      "explanationHtml": "<p>The closed-form library solver and iterative training reach the same rounded result here. LinearRegression itself does not perform these gradient updates.</p>",
      "requires": [
        "numpy",
        "sklearn"
      ]
    },
    {
      "id": "ex-3",
      "title": "Train a scaled stochastic regressor",
      "level": "intermediate",
      "file": "examples/ex-3.py",
      "output": "examples/ex-3.out",
      "tryNow": false,
      "explanationHtml": "<p>SGDRegressor changes weights after individual observations with a decaying rate. Training-only scaling makes differently sized features easier to optimise.</p>",
      "requires": [
        "pandas",
        "sklearn"
      ],
      "workdirFiles": [
        "shared/datasets/study.csv"
      ]
    }
  ],
  "practice": [
    {
      "id": "p-1",
      "type": "code",
      "difficulty": "medium",
      "title": "Make one simultaneous line update",
      "statementHtml": "<p>Read n (1–100), n x/y pairs, then w b lr with positive lr. Print updated w and b to three decimals. Use full MSE derivatives at the old parameters.</p>",
      "hints": [
        "Calculate both gradients before assigning new values."
      ],
      "solution": "practice/p-1.py",
      "tests": [
        {
          "stdin": "practice/p-1.t1.in",
          "output": "practice/p-1.t1.out"
        },
        {
          "stdin": "practice/p-1.t2.in",
          "output": "practice/p-1.t2.out"
        }
      ]
    },
    {
      "id": "p-2",
      "type": "code",
      "difficulty": "medium",
      "title": "Walk a scalar quadratic",
      "statementHtml": "<p>Read start lr updates. Require lr positive and updates 0–100. For cost (x-2) squared, make that many exact gradient updates. Print final x and cost to three decimals.</p>",
      "hints": [
        "The gradient is 2*(x-2)."
      ],
      "solution": "practice/p-2.py",
      "tests": [
        {
          "stdin": "practice/p-2.t1.in",
          "output": "practice/p-2.t1.out"
        },
        {
          "stdin": "practice/p-2.t2.in",
          "output": "practice/p-2.t2.out"
        }
      ]
    },
    {
      "id": "p-3",
      "type": "written",
      "difficulty": "hard",
      "title": "Diagnose increasing loss",
      "statementHtml": "<p>Training MSE doubles each epoch after raw area is added. Give two checks before increasing the epoch count.</p>",
      "hints": [
        "Inspect the learning rate and feature magnitude."
      ],
      "answerHtml": "<p>Check that derivatives use the correct sign and simultaneous old parameters. Fit feature scaling on training rows and reduce the learning rate. More unstable updates will not repair divergence.</p>"
    },
    {
      "id": "p-4",
      "type": "written",
      "difficulty": "hard",
      "title": "Count mini-batches",
      "statementHtml": "<p>There are 10 rows, batch size 4 and 3 epochs, with a final short batch kept. How many updates occur?</p>",
      "hints": [
        "A pass has groups of 4,4,2."
      ],
      "answerHtml": "<p>Each epoch uses three batches: rows 1–4,5–8,9–10. Three epochs give nine updates, while full-batch training would give three updates.</p>"
    }
  ],
