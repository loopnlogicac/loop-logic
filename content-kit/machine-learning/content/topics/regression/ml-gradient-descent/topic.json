    {
      "id": "q-4",
      "type": "mcq",
      "difficulty": "easy",
      "prompt": "When computing two coupled gradient components, when should parameters change?",
      "options": [
        "After the first component and before computing the second",
        "Only the intercept should move",
        "Never recompute the gradients",
        "After both components are calculated at the old parameters"
      ],
      "answer": 3,
      "explanation": "Simultaneous gradient descent uses one common parameter point for every partial derivative."
    },
    {
      "id": "q-5",
      "type": "mcq",
      "difficulty": "easy",
      "prompt": "How does full-batch descent differ from stochastic descent?",
      "options": [
        "It averages gradients over all training rows before an update",
        "It always uses one row",
        "It cannot use an intercept",
        "It always has lower test error"
      ],
      "answer": 0,
      "explanation": "Stochastic descent updates after one sampled row; mini-batch descent averages a small group."
    },
    {
      "id": "q-6",
      "type": "mcq",
      "difficulty": "easy",
      "prompt": "Why scale inputs before gradient training?",
      "options": [
        "Scaling guarantees zero test loss",
        "Input magnitude changes curvature and stable step sizes",
        "Scaling removes every outlier",
        "Scaling changes the target labels into categories"
      ],
      "answer": 1,
      "explanation": "Unequal feature scales can create a narrow bowl and make one common learning rate difficult to choose."
    },
    {
      "id": "q-7",
      "type": "mcq",
      "difficulty": "easy",
      "prompt": "A printed MSE is 0.000 after 40 steps. What can you conclude?",
      "options": [
        "The true error must be exactly zero",
        "Every future row will be exact",
        "The error rounds below the displayed precision",
        "The model has no intercept"
      ],
      "answer": 2,
      "explanation": "Keep unrounded values for updates and convergence decisions."
    },
    {
      "id": "q-8",
      "type": "output",
      "difficulty": "medium",
      "prompt": "What slope follows one step from w=0 with gradient -8 and rate 0.1?",
      "options": [
        "-0.8",
        "8.0",
        "0.1",
        "0.8"
      ],
      "answer": 3,
      "explanation": "Subtracting a negative gradient increases w to 0.8.",
      "code": "w, gradient, lr = 0.0, -8.0, 0.1\nprint(f\"{w-lr*gradient:.1f}\")\n"
    },
    {
      "id": "q-9",
      "type": "output",
      "difficulty": "medium",
      "prompt": "What intercept follows the first update on targets averaging 1?",
      "options": [
        "0.2",
        "-0.2",
        "2.0",
        "1.0"
      ],
      "answer": 0,
      "explanation": "The intercept gradient at the zero line is minus twice the mean target.",
      "code": "b, grad_b, lr = 0.0, -2.0, 0.1\nprint(f\"{b-lr*grad_b:.1f}\")\n"
    },
    {
      "id": "q-10",
      "type": "output",
      "difficulty": "medium",
      "prompt": "How many updates does a two-epoch mini-batch loop perform?",
      "options": [
        "2",
        "6",
        "5",
        "8"
      ],
      "answer": 1,
      "explanation": "Each epoch uses batches starting at 0,4,8; two epochs give six updates.",
      "code": "updates = 0\nfor epoch in range(2):\n    for start in range(0, 10, 4):\n        updates += 1\nprint(updates)\n"
    }
  ],
  "keyPoints": [
    {
      "en": "The gradient points toward local increase.",
      "bn": "gradient কোন দিকে cost বাড়ে, সেটা জানায়।"
    },
    {
      "en": "Subtract learning rate times the gradient.",
      "bn": "gradient-কে learning rate দিয়ে গুণ করে বর্তমান মান থেকে বাদ দাও।"
    },
    {
      "en": "Compute both derivatives before changing either parameter.",
      "bn": "কোনো প্যারামিটার বদলানোর আগে দুটো derivative বের করো।"
    },
    {
      "en": "An excessive learning rate can increase the error.",
      "bn": "learning rate বেশি হলে ভুল উল্টো বাড়তে পারে।"
    },
    {
      "en": "Scaling affects the safe learning rate.",
      "bn": "ফিচারের স্কেল বদলালে নিরাপদ learning rate-ও বদলায়।"
    }
  ],
  "examQuestions": [
    {
      "type": "numerical",
      "question": "Make one MSE gradient update at rate 0.1 from w=b=0 on x=-2,-1,0,1,2 and y=2x+1.",
      "marks": 5,
      "answerHtml": "<p>Errors prediction-minus-target are 3,1,-1,-3,-5. Mean error=-1 and mean error*x=-4. Thus grad_w=-8 and grad_b=-2. Simultaneous subtraction gives w=0.8,b=0.2, with new MSE=3.52.</p>"
    },
    {
      "type": "numerical",
      "question": "Why does lr=0.6 diverge in the centred five-point slope direction?",
      "marks": 5,
      "answerHtml": "<p>Mean x²=2, so slope error multiplies by 1-4*lr=-1.4. Its magnitude exceeds one and grows each iteration. The stable slope interval for this objective is 0&lt;lr&lt;0.5.</p>"
    },
    {
      "type": "long",
      "question": "Compare batch, stochastic and mini-batch descent.",
      "marks": 8,
      "answerHtml": "<p>Batch averages gradients across all rows for an update. Stochastic uses one row, often in seeded shuffled order. Mini-batch uses a subset per update. Smaller groups are cheaper but noisier; epochs and update counts must be distinguished.</p>"
    }
  ],
