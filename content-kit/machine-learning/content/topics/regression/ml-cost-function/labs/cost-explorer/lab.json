{
  "schemaVersion": "1.1",
  "id": "cost-explorer",
  "kind": "ml",
  "title": {
    "en": "Trace the cost of each line",
    "bn": "প্রতিটা রেখার cost মাপো"
  },
  "summary": {
    "en": "Hold the intercept fixed, sample slopes from -1 to 4 by 0.1, and compare the selected line with the lowest sampled cost."
  },
  "pseudocode": [
    "keep the chosen intercept fixed",
    "for slope from -1 to 4 by 0.1:",
    "    draw the line and append its MSE",
    "keep the first smallest sampled MSE",
    "show the selected line and its exact MSE"
  ],
  "inputs": [
    {
      "name": "slope",
      "label": "Selected slope",
      "type": "number",
      "min": -1,
      "max": 4,
      "step": 0.1
    },
    {
      "name": "intercept",
      "label": "Fixed intercept",
      "type": "number",
      "min": -2,
      "max": 6,
      "step": 0.1
    },
    {
      "name": "points",
      "label": "Observations (click to edit)",
      "type": "points",
      "minLength": 5,
      "maxLength": 20,
      "classes": 0,
      "xRange": [
        0,
        6
      ],
      "yRange": [
        0,
        10
      ]
    }
  ],
  "presets": [
    {
      "name": "A slope slice",
      "input": {
        "points": [
          {
            "x": 1,
            "y": 3
          },
          {
            "x": 2,
            "y": 4
          },
          {
            "x": 3,
            "y": 5
          },
          {
            "x": 4,
            "y": 4
          },
          {
            "x": 5,
            "y": 9
          }
        ],
        "slope": 1,
        "intercept": 1.4
      }
    },
    {
      "name": "Correct line",
      "input": {
        "points": [
          {
            "x": 1,
            "y": 3
          },
          {
            "x": 2,
            "y": 4
          },
          {
            "x": 3,
            "y": 5
          },
          {
            "x": 4,
            "y": 4
          },
          {
            "x": 5,
            "y": 9
          }
        ],
        "slope": 1.2,
        "intercept": 1.4
      }
    },
    {
      "name": "Constant x slice",
      "input": {
        "points": [
          {
            "x": 2,
            "y": 1
          },
          {
            "x": 2,
            "y": 2
          },
          {
            "x": 2,
            "y": 3
          },
          {
            "x": 2,
            "y": 4
          },
          {
            "x": 2,
            "y": 5
          }
        ],
        "slope": 0,
        "intercept": 3
      }
    }
  ],
  "checks": [
    {
      "input": {
        "points": [
          {
            "x": 1,
            "y": 3
          },
          {
            "x": 2,
            "y": 4
          },
          {
            "x": 3,
            "y": 5
          },
          {
            "x": 4,
            "y": 4
          },
          {
            "x": 5,
            "y": 9
          }
        ],
        "slope": 1,
        "intercept": 1.4
      },
      "expect": {
        "vars": {
          "slope": 1,
          "mse": 1.96,
          "bestSlope": 1.2,
          "bestMse": 1.52
        }
      }
    },
    {
      "input": {
        "points": [
          {
            "x": 1,
            "y": 3
          },
          {
            "x": 2,
            "y": 4
          },
          {
            "x": 3,
            "y": 5
          },
          {
            "x": 4,
            "y": 4
          },
          {
            "x": 5,
            "y": 9
          }
        ],
        "slope": 1.2,
        "intercept": 1.4
      },
      "expect": {
        "vars": {
          "slope": 1.2,
          "mse": 1.52,
          "bestSlope": 1.2,
          "bestMse": 1.52
        }
      }
    },
    {
      "input": {
        "points": [
          {
            "x": 2,
            "y": 1
          },
          {
            "x": 2,
            "y": 2
          },
          {
            "x": 2,
            "y": 3
          },
          {
            "x": 2,
            "y": 4
          },
          {
            "x": 2,
            "y": 5
          }
        ],
        "slope": 0,
        "intercept": 3
      },
      "expect": {
        "vars": {
          "slope": 0,
          "mse": 2.0,
          "bestSlope": 0.0,
          "bestMse": 2.0
        }
      }
    }
  ],
  "complexity": {
    "time": "O(51n)",
    "space": "O(n + 51)"
  },
  "codeExample": "ex-1"
}
