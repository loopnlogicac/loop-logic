{
  "schemaVersion": "1.1",
  "id": "ml-cost-function",
  "module": "regression",
  "order": 3,
  "kind": "lesson",
  "title": {
    "en": "Measuring Error: the Cost Function",
    "bn": "ভুল মাপার cost ফাংশন"
  },
  "summary": {
    "en": "Turn residuals into MSE and read the difference between a slope slice and a two-parameter bowl.",
    "bn": "ভুলের বর্গ থেকে MSE বের করো; এক ঢালের ছবি আর দুই প্যারামিটারের পার্থক্য বোঝো।"
  },
  "level": "beginner",
  "estMinutes": 50,
  "prerequisites": [
    "ml-simple-linear-regression"
  ],
  "related": [],
  "keywords": [
    "Measuring Error: the Cost Function",
    "regression",
    "Python",
    "prediction"
  ],
  "standards": {
    "minimum": "Python 3.10",
    "notes": [
      "NumPy 2.0+, pandas 2.2+, scikit-learn 1.5+; round displayed values only."
    ]
  },
  "videos": [],
  "sections": [
    {
      "id": "introduction",
      "title": "A score for Tuktuk's guesses"
    },
    {
      "id": "intuition",
      "title": "From vertical gaps to a bowl"
    },
    {
      "id": "how-it-works",
      "title": "Average squared mistakes"
    },
    {
      "id": "try-it-yourself",
      "title": "Name what stays fixed"
    },
    {
      "id": "examples",
      "title": "Calculate costs directly and with a metric"
    },
    {
      "id": "common-mistakes",
      "title": "Do not confuse the score with its search"
    },
    {
      "id": "going-deeper",
      "title": "Optional: curvature and a two-parameter surface"
    },
    {
      "id": "summary",
      "title": "Turn mistakes into a landscape"
    }
  ],
  "examples": [
    {
      "id": "ex-1",
      "title": "Search a fixed-intercept cost slice",
      "level": "basic",
      "file": "examples/ex-1.py",
      "output": "examples/ex-1.out",
      "tryNow": true,
      "explanationHtml": "<p>Holding b at 1.4 makes the sampled minimum occur at slope 1.2. This is one slice through the full cost surface.</p>"
    },
    {
      "id": "ex-2",
      "title": "Check the slice with mean_squared_error",
      "level": "basic",
      "file": "examples/ex-2.py",
      "output": "examples/ex-2.out",
      "tryNow": true,
      "explanationHtml": "<p>A library metric reproduces the direct average of squared errors without changing the sign convention.</p>",
      "requires": [
        "numpy",
        "sklearn"
      ]
    },
    {
      "id": "ex-3",
      "title": "Compare fitted and baseline study costs",
      "level": "intermediate",
      "file": "examples/ex-3.py",
      "output": "examples/ex-3.out",
      "tryNow": false,
      "explanationHtml": "<p>The baseline uses the training target mean. Comparing both losses on the same test rows keeps the comparison meaningful.</p>",
      "requires": [
        "pandas",
        "sklearn"
      ],
      "workdirFiles": [
        "shared/datasets/study.csv"
      ]
    }
  ],
  "practice": [
    {
      "id": "p-1",
      "type": "code",
      "difficulty": "medium",
      "title": "Compute MSE from paired answers",
      "statementHtml": "<p>Read n (1–100), then n observed/predicted pairs. Print MSE to three decimals.</p>",
      "hints": [
        "Average squared gaps, not signed gaps."
      ],
      "solution": "practice/p-1.py",
      "tests": [
        {
          "stdin": "practice/p-1.t1.in",
          "output": "practice/p-1.t1.out"
        },
        {
          "stdin": "practice/p-1.t2.in",
          "output": "practice/p-1.t2.out"
        }
      ]
    },
    {
      "id": "p-2",
      "type": "code",
      "difficulty": "medium",
      "title": "Compare two proposed slope costs",
      "statementHtml": "<p>Read n (1–100), n x/y pairs, then w1 w2 b. Print both MSE values to three decimals, using the same fixed intercept b.</p>",
      "hints": [
        "Keep observations fixed across both candidates."
      ],
      "solution": "practice/p-2.py",
      "tests": [
        {
          "stdin": "practice/p-2.t1.in",
          "output": "practice/p-2.t1.out"
        },
        {
          "stdin": "practice/p-2.t2.in",
          "output": "practice/p-2.t2.out"
        }
      ]
    },
    {
      "id": "p-3",
      "type": "written",
      "difficulty": "hard",
      "title": "Distinguish a slice from a surface",
      "statementHtml": "<p>A chart tries many slopes with b=0. Its minimum is not the full least-squares line. Why?</p>",
      "hints": [
        "Which parameter was not allowed to move?"
      ],
      "answerHtml": "<p>The intercept is fixed, so the chart only searches a one-dimensional slice. A different intercept can reduce the cost further. Optimise both parameters for the full line-fitting problem.</p>"
    },
    {
      "id": "p-4",
      "type": "written",
      "difficulty": "hard",
      "title": "Compare loss units",
      "statementHtml": "<p>Rent residuals are in BDT/month. State MSE units and what happens to MSE if all targets and predictions are divided by 1000.</p>",
      "hints": [
        "Squaring rescales by the square of the factor."
      ],
      "answerHtml": "<p>MSE has (BDT/month) squared units. Dividing both observed and predicted values by 1000 divides each residual by 1000 and MSE by 1000000.</p>"
    }
  ],
