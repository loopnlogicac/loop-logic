    {
      "name": "alpha",
      "label": "Ridge penalty alpha",
      "type": "number",
      "min": 0.1,
      "max": 100,
      "step": 0.1
    },
    {
      "name": "points",
      "label": "Observations (click to edit)",
      "type": "points",
      "minLength": 5,
      "maxLength": 20,
      "classes": 0,
      "xRange": [
        -1,
        1
      ],
      "yRange": [
        -4,
        5
      ]
    }
  ],
