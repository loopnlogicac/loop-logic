{
  "schemaVersion": "1.1",
  "id": "ridge-shrink",
  "kind": "ml",
  "title": {
    "en": "Shrink the weights of a curve",
    "bn": "কার্ভের ওজন কমিয়ে দেখো"
  },
  "summary": {
    "en": "Fit degree-eight ridge with training-standardised powers and an unpenalised intercept; compare coefficient norms as alpha grows."
  },
  "pseudocode": [
    "build powers one to eight",
    "standardise powers using training means and population spreads",
    "solve (Z transpose Z + alpha I) weights = Z transpose centred y",
    "draw the curve and measure the coefficient norm",
    "repeat at comparison alphas and restore the selected alpha"
  ],
