{
  "schemaVersion": "1.1",
  "id": "bias-variance",
  "kind": "ml",
  "title": {
    "en": "Comparing polynomial fits across resampled data",
    "bn": "Resampled ডেটায় polynomial fit-এর ফারাক দেখা"
  },
  "summary": {
    "en": "Fit degrees 1–5 on three seeded bootstrap samples with ridge alpha 0.001 on all coefficients; show real errors and finite-resample prediction variation.",
    "bn": "তিনটি seeded bootstrap sample-এ degree ১–৫ fit করো; সব coefficient-এ ridge 0.001 দিয়ে সত্যিকারের error ও ফারাক দেখো।"
  },
  "codeExample": "ex-1",
  "pseudocode": [
    "create the same three seeded bootstrap samples",
    "show which rows each sample contains",
    "solve the regularised polynomial system",
    "average sample training and fixed validation errors",
    "measure finite-resample prediction variation",
    "restore the selected degree fitted curves",
    "return selected-model errors and variation",
    "compare evidence without claiming population decomposition"
  ],
  "inputs": [
    {
      "name": "degree",
      "label": "Selected polynomial degree",
      "type": "int",
      "min": 1,
      "max": 5
    },
    {
      "name": "seed",
      "label": "Bootstrap seed",
      "type": "int",
      "min": 0,
      "max": 1000
    },
    {
      "name": "points",
      "label": "Training x and target y",
      "type": "points",
      "minLength": 6,
      "maxLength": 20,
      "classes": 0,
      "xRange": [
        -2,
        2
      ],
      "yRange": [
        -4,
        6
      ]
    },
    {
      "name": "validation",
      "label": "Fixed validation x and y",
      "type": "points",
      "minLength": 2,
      "maxLength": 12,
      "classes": 0,
      "xRange": [
        -2,
        2
      ],
      "yRange": [
        -4,
        6
      ]
    }
  ],
