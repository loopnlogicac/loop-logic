{
  "schemaVersion": "1.1",
  "id": "validation-curve",
  "kind": "ml",
  "title": {
    "en": "Choosing neighbours from an actual validation curve",
    "bn": "সত্যিকারের validation curve দেখে নেবারের সংখ্যা বাছা"
  },
  "summary": {
    "en": "Evaluate nine actual KNN candidates on fixed training/validation cards with uniform or distance weights, then distinguish a selected value from the best validation value.",
    "bn": "স্থির ট্রেনিং/validation কার্ডে uniform বা distance ভোটে নয়টি KNN candidate মাপো; বেছে নেওয়া মান ও সেরা মান আলাদা দেখো।"
  },
  "codeExample": "ex-1",
  "pseudocode": [
    "try each requested neighbour count",
    "measure the fitted training score",
    "measure excluded validation cards",
    "mark the best validation score with smaller-k ties",
    "report selected and best candidates separately",
    "reserve final test data after tuning"
  ],
  "inputs": [
    {
      "name": "k",
      "label": "Selected neighbour count",
      "type": "int",
      "min": 1,
      "max": 9
    },
    {
      "name": "weights",
      "label": "Vote weighting",
      "type": "choice",
      "options": [
        "uniform",
        "distance"
      ]
    },
    {
      "name": "points",
      "label": "Training score cards",
      "type": "points",
      "minLength": 1,
      "maxLength": 30,
      "classes": 2,
      "xRange": [
        0,
        6
      ],
      "yRange": [
        0,
        6
      ]
    },
    {
      "name": "validation",
      "label": "Validation cards (never vote)",
      "type": "points",
      "minLength": 1,
      "maxLength": 15,
      "classes": 2,
      "xRange": [
        0,
        6
      ],
      "yRange": [
        0,
        6
      ]
    }
  ],
  "presets": [
    {
      "name": "A controlled candidate curve",
      "input": {
        "k": 3,
        "weights": "uniform",
        "points": [
          {
            "x": 1,
            "y": 1,
            "cls": 0
          },
          {
            "x": 1,
            "y": 2,
            "cls": 0
          },
          {
            "x": 2,
            "y": 1,
            "cls": 0
