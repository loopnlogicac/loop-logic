{
  "schemaVersion": "1.1",
  "id": "k-fold",
  "kind": "ml",
  "title": {
    "en": "Refitting and scoring stratified folds",
    "bn": "Stratified fold-এ নতুন fit ও score মাপা"
  },
  "summary": {
    "en": "Round-robin each class into up to five folds, refit KNN without held-out rows and show every score, mean and population spread; insufficient classes are explicit.",
    "bn": "প্রতি ক্লাস পালা করে সর্বোচ্চ পাঁচ fold-এ ভাগ করো; held-out row বাদ দিয়ে KNN fit করে score, গড় ও spread দেখো।"
  },
  "codeExample": "ex-1",
  "pseudocode": [
    "require at least two cards in each class",
    "assign class indices round-robin to folds",
    "fit only on the complement of one fold",
    "predict each held-out card without its own vote",
    "record this fold accuracy",
    "repeat with a fresh training subset",
    "compute mean and population standard deviation",
    "return all scores and descriptive spread"
  ],
  "inputs": [
    {
      "name": "folds",
      "label": "Requested folds",
      "type": "int",
      "min": 2,
      "max": 5
    },
    {
      "name": "neighbours",
      "label": "KNN neighbour count",
      "type": "int",
      "min": 1,
      "max": 5
    },
    {
      "name": "points",
      "label": "Two-feature labelled cards",
      "type": "points",
      "minLength": 4,
      "maxLength": 20,
      "classes": 2,
      "xRange": [
        0,
        6
      ],
      "yRange": [
        0,
        6
      ]
    }
  ],
  "presets": [
