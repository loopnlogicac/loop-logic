            "x": 0.3,
            "y": 0,
            "cls": 0
          },
          {
            "x": 0.45,
            "y": 1,
            "cls": 1
          },
          {
            "x": 0.6,
            "y": 0,
            "cls": 0
          },
          {
            "x": 0.8,
            "y": 1,
            "cls": 1
          },
          {
            "x": 0.9,
            "y": 1,
            "cls": 1
          }
        ]
      },
      "expect": {
        "vars": {
          "status": "defined",
          "auc": 0.889,
          "selectedFPR": 0.333,
          "selectedTPR": 0.667
        }
      }
    },
    {
