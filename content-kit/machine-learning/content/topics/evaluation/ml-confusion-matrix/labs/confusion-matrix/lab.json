{
  "schemaVersion": "1.1",
  "id": "confusion-matrix",
  "kind": "ml",
  "title": {
    "en": "Moving a threshold and filling the confusion matrix",
    "bn": "Threshold সরিয়ে confusion matrix গোনা"
  },
  "summary": {
    "en": "Use score x and known class to place each card in an actual-row/predicted-column matrix; vertical coordinates only lay out the class rows.",
    "bn": "Score x ও আসল ক্লাস দিয়ে প্রতিটি কার্ড matrix-এ গোনো; ওপর-নিচের position শুধু row সাজায়।"
  },
  "codeExample": "ex-1",
  "pseudocode": [
    "set the inclusive score threshold",
    "predict one scored card",
    "choose actual row and predicted column",
    "increment that cell exactly once",
    "return TN, FP, FN and TP",
    "compare a different fixed-score threshold"
  ],
  "inputs": [
    {
      "name": "threshold",
      "label": "Class-one threshold",
      "type": "number",
      "min": 0,
      "max": 1,
      "step": 0.05
    },
    {
      "name": "points",
      "label": "Score x and known class",
      "type": "points",
      "minLength": 1,
      "maxLength": 30,
      "classes": 2,
      "xRange": [
        0,
        1
      ],
      "yRange": [
        0,
        1
      ]
    }
  ],
  "presets": [
    {
      "name": "Both kinds of error",
      "input": {
        "threshold": 0.5,
        "points": [
          {
            "x": 0.1,
            "y": 0,
            "cls": 0
          },
          {
            "x": 0.3,
            "y": 0,
            "cls": 0
          },
          {
            "x": 0.45,
            "y": 1,
            "cls": 1
          },
          {
            "x": 0.6,
            "y": 0,
            "cls": 0
          },
          {
            "x": 0.8,
            "y": 1,
            "cls": 1
          },
          {
            "x": 0.9,
            "y": 1,
            "cls": 1
          }
        ]
      }
    },
    {
      "name": "A stricter decision",
      "input": {
        "threshold": 0.8,
        "points": [
          {
            "x": 0.1,
            "y": 0,
            "cls": 0
          },
          {
            "x": 0.3,
            "y": 0,
            "cls": 0
          },
          {
            "x": 0.45,
            "y": 1,
            "cls": 1
          },
          {
            "x": 0.6,
            "y": 0,
            "cls": 0
          },
          {
            "x": 0.8,
            "y": 1,
            "cls": 1
          },
          {
            "x": 0.9,
            "y": 1,
            "cls": 1
          }
        ]
      }
    }
  ],
  "checks": [
    {
      "input": {
        "threshold": 0.5,
        "points": [
          {
            "x": 0.1,
            "y": 0,
            "cls": 0
          },
          {
            "x": 0.3,
            "y": 0,
            "cls": 0
          },
          {
            "x": 0.45,
            "y": 1,
            "cls": 1
          },
          {
            "x": 0.6,
            "y": 0,
            "cls": 0
          },
          {
            "x": 0.8,
            "y": 1,
            "cls": 1
          },
          {
            "x": 0.9,
            "y": 1,
            "cls": 1
          }
        ]
      },
      "expect": {
        "vars": {
          "tn": 2,
          "fp": 1,
          "fn": 1,
          "tp": 2
        },
        "tables": {
          "matrix": {
            "cells": [
              [
                2,
                1
              ],
              [
                1,
                2
              ]
            ]
          }
        }
      }
    },
    {
      "input": {
        "threshold": 0.8,
        "points": [
          {
            "x": 0.1,
            "y": 0,
            "cls": 0
          },
          {
            "x": 0.3,
            "y": 0,
            "cls": 0
          },
          {
            "x": 0.45,
            "y": 1,
            "cls": 1
          },
          {
            "x": 0.6,
            "y": 0,
            "cls": 0
          },
          {
            "x": 0.8,
            "y": 1,
            "cls": 1
          },
          {
            "x": 0.9,
            "y": 1,
            "cls": 1
          }
        ]
      },
      "expect": {
        "vars": {
          "tn": 3,
          "fp": 0,
          "fn": 1,
          "tp": 2
        }
      }
    },
    {
      "input": {
        "threshold": 0.5,
        "points": [
          {
            "x": 0.5,
            "y": 0,
            "cls": 0
          },
          {
            "x": 0.5,
            "y": 1,
            "cls": 1
          }
        ]
      },
      "expect": {
        "vars": {
          "tn": 0,
          "fp": 1,
          "fn": 0,
          "tp": 1
        }
      }
    }
  ],
  "complexity": {
    "time": "O(n log n) display ordering, O(n) counting",
    "space": "O(n) cards and four count cells"
  }
}
